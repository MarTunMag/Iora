//@version=6
indicator("Iora Structure Cascade", overlay = true, max_labels_count = 500)

// =============================================================================
// Early structure confirmation via period-level swing detection + cross-TF
// cascade propagation. Implements specs 02 + 04.
//
// Per TF: tracks swing highs/lows from period breaks, classifies HH/LH/HL/LL,
// detects BOS vs CHoCH, and flags when a child-TF break exceeds the parent
// TF's period level (eBOS+/eCHoCH+).
//
// Designed to overlay on iora_bos_choch.pine (which draws the level lines).
// This indicator draws ONLY structural event labels at break bars.
//
// Cascade chain: M5 → M15 → H1 → H4 → D → W → MN
// Zero request.security() calls — all track_period runs on chart TF.
// =============================================================================

// =============================================================================
// S1 — INPUTS
// =============================================================================

string GRP_TF    = "Timeframes"
bool   i_m5_on   = input.bool(false, "M5",  group = GRP_TF)
bool   i_m15_on  = input.bool(true,  "M15", group = GRP_TF)
bool   i_h1_on   = input.bool(true,  "H1",  group = GRP_TF)
bool   i_h4_on   = input.bool(true,  "H4",  group = GRP_TF)
bool   i_dy_on   = input.bool(false, "D",   group = GRP_TF)
bool   i_wk_on   = input.bool(false, "W",   group = GRP_TF)
bool   i_mn_on   = input.bool(false, "MN",  group = GRP_TF)

string GRP_CLR   = "Colors"
color  i_bull_clr  = input.color(color.new(#26A69A, 0),  "Bullish Text",      group = GRP_CLR)
color  i_bear_clr  = input.color(color.new(#EF5350, 0),  "Bearish Text",      group = GRP_CLR)
color  i_choch_bg  = input.color(color.new(#FF9800, 75), "CHoCH Background",  group = GRP_CLR)
color  i_ext_bg    = input.color(color.new(#FFD700, 70), "External Cascade BG", group = GRP_CLR)

string GRP_BG    = "Trend Background"
bool   i_bg_on   = input.bool(false, "Show Trend Background", group = GRP_BG)
string i_bg_tf   = input.string("H4", "Reference TF", options = ["M5", "M15", "H1", "H4", "D", "W", "MN"], group = GRP_BG)
color  i_bg_bull = input.color(color.new(#26A69A, 93), "Bullish BG", group = GRP_BG)
color  i_bg_bear = input.color(color.new(#EF5350, 93), "Bearish BG", group = GRP_BG)

// =============================================================================
// S2 — PERIOD TRACKING (from iora_bos_choch.pine)
// Tracks prev-period high/low and first break time per TF.
// =============================================================================

track_period(string tf) =>
    bool new_period = ta.change(time(tf)) != 0
    var float cur_hi   = na
    var int   cur_hi_t = na
    var float cur_lo   = na
    var int   cur_lo_t = na
    var float prev_hi   = na
    var int   prev_hi_t = na
    var float prev_lo   = na
    var int   prev_lo_t = na
    var int   hi_brk_t  = na
    var int   lo_brk_t  = na
    if new_period
        prev_hi   := cur_hi
        prev_hi_t := cur_hi_t
        prev_lo   := cur_lo
        prev_lo_t := cur_lo_t
        cur_hi    := high
        cur_hi_t  := time
        cur_lo    := low
        cur_lo_t  := time
        hi_brk_t  := na
        lo_brk_t  := na
    else
        if high >= nz(cur_hi)
            cur_hi   := high
            cur_hi_t := time
        if low <= nz(cur_lo, 1e18)
            cur_lo   := low
            cur_lo_t := time
    if na(hi_brk_t) and not na(prev_hi) and high > prev_hi
        hi_brk_t := time
    if na(lo_brk_t) and not na(prev_lo) and low < prev_lo
        lo_brk_t := time
    [prev_hi, prev_hi_t, prev_lo, prev_lo_t, hi_brk_t, lo_brk_t]

// =============================================================================
// S3 — STRUCTURAL STATE MACHINE + DRAWING
//
// Per-TF swing tracking:
//   HIGH break → confirms swing LOW (lowest prev_lo since last swing confirmed)
//   LOW break  → confirms swing HIGH (highest prev_hi since last swing confirmed)
//
// Classification: HH/LH for highs, HL/LL for lows (§2.3)
// BOS/CHoCH from trend context (§2.4)
// External cascade: close > parent_prev_hi or close < parent_prev_lo (§3.2, §10.3)
//
// Labels drawn at break bars, at the broken level price.
// =============================================================================

process_tf(string tf_name, bool enabled, float p_hi, int p_hi_t, float p_lo, int p_lo_t, int hi_brk, int lo_brk, float par_hi, float par_lo) =>
    // --- Edge-detect break events (na → value transition) ---
    var int last_hb = na
    bool hi_just = not na(hi_brk) and na(last_hb)
    last_hb := hi_brk
    var int last_lb = na
    bool lo_just = not na(lo_brk) and na(last_lb)
    last_lb := lo_brk

    // --- State machine ---
    var int   trend   = 0    // +1 bullish, -1 bearish, 0 neutral
    var float last_sh = na   // last confirmed swing high
    var float prev_sh = na   // swing high before last
    var float last_sl = na   // last confirmed swing low
    var float prev_sl = na   // swing low before last

    // --- Running extreme trackers ---
    // hi_trk: highest prev_hi since last swing confirmed (becomes next swing high)
    // lo_trk: lowest prev_lo since last swing confirmed (becomes next swing low)
    var float hi_trk = na
    var float lo_trk = na

    // --- Update trackers when new period values arrive ---
    // Detect new period via prev_hi origin time change
    var int m_pt = na
    bool new_vals = not na(p_hi_t) and p_hi_t != m_pt
    if new_vals
        m_pt := p_hi_t
        if not na(p_hi) and (na(hi_trk) or p_hi > hi_trk)
            hi_trk := p_hi
        if not na(p_lo) and (na(lo_trk) or p_lo < lo_trk)
            lo_trk := p_lo

    // --- Snapshot trackers before processing breaks ---
    float hi_s = hi_trk
    float lo_s = lo_trk

    // ---------------------------------------------------------------
    // HIGH BREAK → confirms swing LOW = lo_s
    // The break means price went UP through prev_hi.
    // The lowest prev_lo since the last confirmed swing is the swing low.
    // ---------------------------------------------------------------
    if hi_just and not na(lo_s)
        float new_sl = lo_s
        string cls = na(last_sl) ? "" : (new_sl > last_sl ? "HL" : (new_sl < last_sl ? "LL" : ""))
        if cls != ""
            string et = ""
            if trend == 1
                et := cls == "HL" ? "BOS" : "CHoCH"
            else if trend == -1
                et := cls == "LL" ? "BOS" : "CHoCH"
            bool is_bull = cls == "HL"
            if et != ""
                bool ext = not na(par_hi) and close > par_hi
                string pfx = ext ? "e" : "i"
                string sfx = ext ? "+" : ""
                string full_txt = tf_name + "\n" + cls + " " + pfx + et + sfx
                color txt_clr = is_bull ? i_bull_clr : i_bear_clr
                color bg_clr = et == "CHoCH" ? (ext ? i_ext_bg : i_choch_bg) : (ext ? i_ext_bg : color.new(color.white, 100))
                if enabled
                    label.new(time, p_hi, full_txt, xloc = xloc.bar_time, style = label.style_label_up, color = bg_clr, textcolor = txt_clr, size = size.tiny)
                if et == "CHoCH"
                    if trend == 1
                        trend := -1
                    else if trend == -1
                        trend := 1
            else
                // First classified event — establish trend, no BOS/CHoCH yet
                string full_txt = tf_name + "\n" + cls
                color txt_clr = is_bull ? i_bull_clr : i_bear_clr
                if enabled
                    label.new(time, p_hi, full_txt, xloc = xloc.bar_time, style = label.style_label_up, color = color.new(color.white, 100), textcolor = txt_clr, size = size.tiny)
                if cls == "HL"
                    trend := 1
                else
                    trend := -1
        prev_sl := last_sl
        last_sl := new_sl
        hi_trk := na
        lo_trk := na

    // ---------------------------------------------------------------
    // LOW BREAK → confirms swing HIGH = hi_s
    // The break means price went DOWN through prev_lo.
    // The highest prev_hi since the last confirmed swing is the swing high.
    // ---------------------------------------------------------------
    if lo_just and not na(hi_s)
        float new_sh = hi_s
        string cls = na(last_sh) ? "" : (new_sh > last_sh ? "HH" : (new_sh < last_sh ? "LH" : ""))
        if cls != ""
            string et = ""
            if trend == 1
                et := cls == "HH" ? "BOS" : "CHoCH"
            else if trend == -1
                et := cls == "LH" ? "BOS" : "CHoCH"
            bool is_bull = cls == "HH"
            if et != ""
                bool ext = not na(par_lo) and close < par_lo
                string pfx = ext ? "e" : "i"
                string sfx = ext ? "+" : ""
                string full_txt = tf_name + "\n" + cls + " " + pfx + et + sfx
                color txt_clr = is_bull ? i_bull_clr : i_bear_clr
                color bg_clr = et == "CHoCH" ? (ext ? i_ext_bg : i_choch_bg) : (ext ? i_ext_bg : color.new(color.white, 100))
                if enabled
                    label.new(time, p_lo, full_txt, xloc = xloc.bar_time, style = label.style_label_down, color = bg_clr, textcolor = txt_clr, size = size.tiny)
                if et == "CHoCH"
                    if trend == 1
                        trend := -1
                    else if trend == -1
                        trend := 1
            else
                string full_txt = tf_name + "\n" + cls
                color txt_clr = is_bull ? i_bull_clr : i_bear_clr
                if enabled
                    label.new(time, p_lo, full_txt, xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.white, 100), textcolor = txt_clr, size = size.tiny)
                if cls == "HH"
                    trend := 1
                else
                    trend := -1
        prev_sh := last_sh
        last_sh := new_sh
        if not hi_just
            hi_trk := na
            lo_trk := na

    trend

// =============================================================================
// S4 — PERIOD TRACKING CALLS (7 TFs)
// =============================================================================

[m5_hi,  m5_hi_t,  m5_lo,  m5_lo_t,  m5_hi_brk,  m5_lo_brk]  = track_period("5")
[m15_hi, m15_hi_t, m15_lo, m15_lo_t, m15_hi_brk, m15_lo_brk] = track_period("15")
[h1_hi,  h1_hi_t,  h1_lo,  h1_lo_t,  h1_hi_brk,  h1_lo_brk]  = track_period("60")
[h4_hi,  h4_hi_t,  h4_lo,  h4_lo_t,  h4_hi_brk,  h4_lo_brk]  = track_period("240")
[dy_hi,  dy_hi_t,  dy_lo,  dy_lo_t,  dy_hi_brk,  dy_lo_brk]  = track_period("1D")
[wk_hi,  wk_hi_t,  wk_lo,  wk_lo_t,  wk_hi_brk,  wk_lo_brk]  = track_period("1W")
[mn_hi,  mn_hi_t,  mn_lo,  mn_lo_t,  mn_hi_brk,  mn_lo_brk]  = track_period("1M")

// =============================================================================
// S5 — STRUCTURE TRACKING CALLS (7 TFs with parent linkage)
// Cascade chain: M5→M15→H1→H4→D→W→MN
// MN has no parent. All 7 run regardless of display toggle (state needed for children).
// =============================================================================

int mn_trend  = process_tf("MN",  i_mn_on,  mn_hi,  mn_hi_t,  mn_lo,  mn_lo_t,  mn_hi_brk,  mn_lo_brk,  float(na), float(na))
int wk_trend  = process_tf("W",   i_wk_on,  wk_hi,  wk_hi_t,  wk_lo,  wk_lo_t,  wk_hi_brk,  wk_lo_brk,  mn_hi,     mn_lo)
int dy_trend  = process_tf("D",   i_dy_on,  dy_hi,  dy_hi_t,  dy_lo,  dy_lo_t,  dy_hi_brk,  dy_lo_brk,  wk_hi,     wk_lo)
int h4_trend  = process_tf("H4",  i_h4_on,  h4_hi,  h4_hi_t,  h4_lo,  h4_lo_t,  h4_hi_brk,  h4_lo_brk,  dy_hi,     dy_lo)
int h1_trend  = process_tf("H1",  i_h1_on,  h1_hi,  h1_hi_t,  h1_lo,  h1_lo_t,  h1_hi_brk,  h1_lo_brk,  h4_hi,     h4_lo)
int m15_trend = process_tf("M15", i_m15_on, m15_hi, m15_hi_t, m15_lo, m15_lo_t, m15_hi_brk, m15_lo_brk, h1_hi,     h1_lo)
int m5_trend  = process_tf("M5",  i_m5_on,  m5_hi,  m5_hi_t,  m5_lo,  m5_lo_t,  m5_hi_brk,  m5_lo_brk,  m15_hi,    m15_lo)

// =============================================================================
// S6 — TREND BACKGROUND TINT (optional)
// =============================================================================

int ref_trend = i_bg_tf == "M5" ? m5_trend : i_bg_tf == "M15" ? m15_trend : i_bg_tf == "H1" ? h1_trend : i_bg_tf == "H4" ? h4_trend : i_bg_tf == "D" ? dy_trend : i_bg_tf == "W" ? wk_trend : mn_trend
bgcolor(i_bg_on ? (ref_trend == 1 ? i_bg_bull : ref_trend == -1 ? i_bg_bear : na) : na)
