//@version=6
indicator("Iora Push Zones (Cross-TF)", overlay = true, max_boxes_count = 500, max_labels_count = 500, calc_bars_count = 2000)

// =============================================================================
// S1 — TYPES
// =============================================================================

type Zone
    float   top       = 0.0
    float   bottom    = 0.0
    bool    is_supply = false
    int     origin_time = 0
    box     bx
    bool    is_push   = false

// =============================================================================
// S1 — INPUTS
// Pairings: zone TF (lower) → structure TF (higher)
//   M5→M15, M15→H1, H1→H4, H4→D, D→W, W→MN
// =============================================================================

string GRP_ZONE  = "Zone Detection"
float  i_doji    = input.float(5.0, "Doji Body %", group = GRP_ZONE, minval = 0.1, maxval = 50.0, tooltip = "Max body/range % to classify as doji candle")

string GRP_TF    = "TF Pairings (Zone → Structure)"
bool   i_p0_on   = input.bool(false, "M5 → M15",  group = GRP_TF)
bool   i_p1_on   = input.bool(false, "M15 → H1",  group = GRP_TF)
bool   i_p2_on   = input.bool(true,  "H1 → H4",   group = GRP_TF)
bool   i_p3_on   = input.bool(true,  "H4 → D",    group = GRP_TF)
bool   i_p4_on   = input.bool(false, "D → W",     group = GRP_TF)
bool   i_p5_on   = input.bool(false, "W → MN",    group = GRP_TF)

string GRP_AGE   = "Zone Age (max bars per TF)"
int    i_age_m5  = input.int(50, "M5",  group = GRP_AGE, minval = 1)
int    i_age_m15 = input.int(50, "M15", group = GRP_AGE, minval = 1)
int    i_age_h1  = input.int(50, "H1",  group = GRP_AGE, minval = 1)
int    i_age_h4  = input.int(50, "H4",  group = GRP_AGE, minval = 1)
int    i_age_d   = input.int(50, "D",   group = GRP_AGE, minval = 1)
int    i_age_w   = input.int(30, "W",   group = GRP_AGE, minval = 1)

string GRP_CLR   = "Colors"
color  i_sup_bg  = input.color(color.new(#FF4444, 85), "Supply Fill",   group = GRP_CLR)
color  i_sup_br  = input.color(color.new(#FF4444, 20), "Supply Border", group = GRP_CLR)
color  i_dem_bg  = input.color(color.new(#2196F3, 85), "Demand Fill",   group = GRP_CLR)
color  i_dem_br  = input.color(color.new(#2196F3, 20), "Demand Border", group = GRP_CLR)
color  i_push_sup_bg = input.color(color.new(#FF4444, 70), "Push Supply Fill",   group = GRP_CLR)
color  i_push_sup_br = input.color(color.new(#FF4444, 0),  "Push Supply Border", group = GRP_CLR)
color  i_push_dem_bg = input.color(color.new(#2196F3, 70), "Push Demand Fill",   group = GRP_CLR)
color  i_push_dem_br = input.color(color.new(#2196F3, 0),  "Push Demand Border", group = GRP_CLR)
bool   i_labels  = input.bool(true, "Show Zone Labels", group = GRP_CLR)

// =============================================================================
// S2 — HELPERS
// =============================================================================

tf_max_age(string tf) =>
    int sec = timeframe.in_seconds(tf)
    int out = sec <= 300 ? i_age_m5 : sec <= 900 ? i_age_m15 : sec <= 3600 ? i_age_h1 : sec <= 14400 ? i_age_h4 : sec <= 86400 ? i_age_d : i_age_w
    out

tf_label(string tf) =>
    int sec = timeframe.in_seconds(tf)
    string out = sec <= 300 ? "M5" : sec <= 900 ? "M15" : sec <= 3600 ? "H1" : sec <= 14400 ? "H4" : sec <= 86400 ? "D" : "W"
    out

// =============================================================================
// S2 — HA ZONE DETECTION + SEQUENCE TRACKING
// Runs on raw OHLC via request.security. HA candles computed manually.
// Zone boundaries (ORIZ spec):
//   Supply: top = OHLC high, bottom = HA low
//   Demand: top = HA high, bottom = OHLC low
// =============================================================================

ha_detect(float doji_pct) =>
    float haC = (open + high + low + close) / 4.0
    float haO = float(na)
    haO := na(haO[1]) ? (open + close) / 2.0 : (nz(haO[1]) + nz(haC[1])) / 2.0
    float haH = math.max(high, math.max(haO, haC))
    float haL = math.min(low, math.min(haO, haC))

    bool is_blue = haC >= haO
    bool is_red  = haC < haO

    int max_run = math.min(50, bar_index)

    var float prev_run_hi   = na
    var float prev_run_lo   = na
    var float seq_hh        = na
    var float seq_ll        = na
    var int   seq_hh_time   = na
    var int   seq_ll_time   = na
    var string hi1_txt      = ""
    var string lo1_txt      = ""

    bool  fire      = false
    float ztop      = 0.0
    float zbot      = 0.0
    bool  is_sup    = false
    int   zt_origin = time

    // DEMAND: red -> blue
    if is_blue and is_red[1]
        float run_lo_ohlc = low[1]
        int   ext_time    = time[1]
        int   k           = 2
        while k < max_run and is_red[k]
            if low[k] < run_lo_ohlc
                run_lo_ohlc := low[k]
                ext_time    := time[k]
            k += 1

        bool is_new_ll = na(prev_run_lo) or run_lo_ohlc < prev_run_lo
        seq_ll      := run_lo_ohlc
        seq_ll_time := ext_time
        prev_run_lo := run_lo_ohlc
        lo1_txt     := is_new_ll ? "LL" : "HL"

        float body = math.abs(haC - haO)
        float rng  = haH - haL
        bool  doji = rng > 0.0 and (body / rng * 100.0) < doji_pct

        ztop      := doji ? nz(haH, high) : nz(haH[1], high[1])
        zbot      := nz(run_lo_ohlc, low[1])
        zt_origin := nz(ext_time, time[1])
        fire      := true

    // SUPPLY: blue -> red
    else if is_red and is_blue[1]
        float run_hi_ohlc = high[1]
        int   ext_time    = time[1]
        int   k           = 2
        while k < max_run and is_blue[k]
            if high[k] > run_hi_ohlc
                run_hi_ohlc := high[k]
                ext_time    := time[k]
            k += 1

        bool is_new_hh = na(prev_run_hi) or run_hi_ohlc > prev_run_hi
        seq_hh      := run_hi_ohlc
        seq_hh_time := ext_time
        prev_run_hi := run_hi_ohlc
        hi1_txt     := is_new_hh ? "HH" : "LH"

        float body = math.abs(haC - haO)
        float rng  = haH - haL
        bool  doji = rng > 0.0 and (body / rng * 100.0) < doji_pct

        ztop      := nz(run_hi_ohlc, high[1])
        zbot      := doji ? nz(haL, low) : nz(haL[1], low[1])
        zt_origin := nz(ext_time, time[1])
        fire      := true
        is_sup    := true

    [fire, ztop, zbot, is_sup, zt_origin, seq_hh, seq_ll, seq_hh_time, seq_ll_time, hi1_txt, lo1_txt]

// =============================================================================
// S3 — STRUCTURE TRACKING (runs on chart TF, no extra security calls)
// Tracks previous period high/low and first break time for the higher TF.
// =============================================================================

track_period(string tf) =>
    bool new_period = ta.change(time(tf)) != 0

    var float cur_hi   = na
    var int   cur_hi_t = na
    var float cur_lo   = na
    var int   cur_lo_t = na
    var float prev_hi   = na
    var int   prev_hi_t = na
    var float prev_lo   = na
    var int   prev_lo_t = na
    var int   hi_brk_t  = na
    var int   lo_brk_t  = na

    if new_period
        prev_hi   := cur_hi
        prev_hi_t := cur_hi_t
        prev_lo   := cur_lo
        prev_lo_t := cur_lo_t
        cur_hi    := high
        cur_hi_t  := time
        cur_lo    := low
        cur_lo_t  := time
        hi_brk_t  := na
        lo_brk_t  := na
    else
        if high >= nz(cur_hi)
            cur_hi   := high
            cur_hi_t := time
        if low <= nz(cur_lo, 1e18)
            cur_lo   := low
            cur_lo_t := time

    if na(hi_brk_t) and not na(prev_hi) and high > prev_hi
        hi_brk_t := time
    if na(lo_brk_t) and not na(prev_lo) and low < prev_lo
        lo_brk_t := time

    [prev_hi, prev_hi_t, prev_lo, prev_lo_t, hi_brk_t, lo_brk_t]

// =============================================================================
// S4 — ZONE MANAGEMENT + CROSS-TF PUSH DETECTION
// Body-close break (wicks = liquidity sweep, not a break).
// Push = last unbroken zone on lower TF when higher TF's extreme is broken.
// =============================================================================

method delete_zone(array<Zone> zones, int idx) =>
    Zone z = zones.get(idx)
    if not na(z.bx)
        box.delete(z.bx)
    zones.remove(idx)

method process(array<Zone> zones, bool fire, float ztop, float zbot, bool is_sup, int z_time, string hi_txt, string lo_txt, string tf_str, bool htf_hi_broken, bool htf_lo_broken) =>
    int tf_ms  = timeframe.in_seconds(tf_str) * 1000
    int max_ms = tf_max_age(tf_str) * tf_ms

    // 1. Expire + break check
    if zones.size() > 0
        for i = zones.size() - 1 to 0
            Zone z = zones.get(i)
            bool expired = (time - z.origin_time) > max_ms
            if expired
                zones.delete_zone(i)
                continue
            bool broken = z.is_supply ? (close > z.top) : (close < z.bottom)
            if broken
                zones.delete_zone(i)

    // 2. Create new zone
    bool valid = not na(ztop) and not na(zbot) and not na(z_time) and ztop > zbot
    if fire and (time - z_time) < max_ms and valid
        string cls     = is_sup ? hi_txt : lo_txt
        string lbl_txt = i_labels ? tf_label(tf_str) + (is_sup ? " S " : " D ") + cls : na
        color  bg_clr  = is_sup ? i_sup_bg : i_dem_bg
        color  br_clr  = is_sup ? i_sup_br : i_dem_br
        color  tx_clr  = is_sup ? color.new(#FF4444, 0) : color.new(#2196F3, 0)
        box new_box    = box.new(z_time, ztop, z_time + tf_ms * 6, zbot, xloc = xloc.bar_time, extend = extend.right, bgcolor = bg_clr, border_color = br_clr, border_width = 1, text = lbl_txt, text_size = size.tiny, text_color = tx_clr, text_halign = text.align_right, text_valign = text.align_top)
        zones.push(Zone.new(ztop, zbot, is_sup, z_time, new_box, false))

    // 3. Push zone tagging — on HTF structure break
    if (htf_hi_broken or htf_lo_broken) and zones.size() > 0
        // Reset all existing push flags
        for i = 0 to zones.size() - 1
            Zone z = zones.get(i)
            if z.is_push
                z.is_push := false
                color bg = z.is_supply ? i_sup_bg : i_dem_bg
                color br = z.is_supply ? i_sup_br : i_dem_br
                if not na(z.bx)
                    z.bx.set_bgcolor(bg)
                    z.bx.set_border_color(br)
                    z.bx.set_border_width(1)
                    string cls2 = z.is_supply ? hi_txt : lo_txt
                    string rtxt = i_labels ? tf_label(tf_str) + (z.is_supply ? " S " : " D ") + cls2 : na
                    z.bx.set_text(rtxt)

    // HTF high broken → last unbroken demand zone = bullish push
    if htf_hi_broken and zones.size() > 0
        for i = zones.size() - 1 to 0
            Zone z = zones.get(i)
            if not z.is_supply
                z.is_push := true
                if not na(z.bx)
                    z.bx.set_bgcolor(i_push_dem_bg)
                    z.bx.set_border_color(i_push_dem_br)
                    z.bx.set_border_width(2)
                    string ptxt = i_labels ? tf_label(tf_str) + " D PUSH" : na
                    z.bx.set_text(ptxt)
                break

    // HTF low broken → last unbroken supply zone = bearish push
    if htf_lo_broken and zones.size() > 0
        for i = zones.size() - 1 to 0
            Zone z = zones.get(i)
            if z.is_supply
                z.is_push := true
                if not na(z.bx)
                    z.bx.set_bgcolor(i_push_sup_bg)
                    z.bx.set_border_color(i_push_sup_br)
                    z.bx.set_border_width(2)
                    string ptxt = i_labels ? tf_label(tf_str) + " S PUSH" : na
                    z.bx.set_text(ptxt)
                break

// =============================================================================
// S5 — DATA REQUESTS (6 calls for zone detection on lower TFs)
// =============================================================================

string _base_sym = ticker.standard(syminfo.tickerid)

[f0_raw, zt0, zb0, s0, tm0, hh0, ll0, hht0, llt0, h1s0, l1s0] = request.security(_base_sym, "5",   ha_detect(i_doji), calc_bars_count = 500)
[f1_raw, zt1, zb1, s1, tm1, hh1, ll1, hht1, llt1, h1s1, l1s1] = request.security(_base_sym, "15",  ha_detect(i_doji), calc_bars_count = 500)
[f2_raw, zt2, zb2, s2, tm2, hh2, ll2, hht2, llt2, h1s2, l1s2] = request.security(_base_sym, "60",  ha_detect(i_doji), calc_bars_count = 500)
[f3_raw, zt3, zb3, s3, tm3, hh3, ll3, hht3, llt3, h1s3, l1s3] = request.security(_base_sym, "240", ha_detect(i_doji), calc_bars_count = 500)
[f4_raw, zt4, zb4, s4, tm4, hh4, ll4, hht4, llt4, h1s4, l1s4] = request.security(_base_sym, "1D",  ha_detect(i_doji), calc_bars_count = 500)
[f5_raw, zt5, zb5, s5, tm5, hh5, ll5, hht5, llt5, h1s5, l1s5] = request.security(_base_sym, "1W",  ha_detect(i_doji), calc_bars_count = 500)

// Edge-detect: fire only once per HTF event
bool f0 = f0_raw and not f0_raw[1]
bool f1 = f1_raw and not f1_raw[1]
bool f2 = f2_raw and not f2_raw[1]
bool f3 = f3_raw and not f3_raw[1]
bool f4 = f4_raw and not f4_raw[1]
bool f5 = f5_raw and not f5_raw[1]

// =============================================================================
// S6 — STRUCTURE TRACKING on higher TFs (runs on chart TF, 0 extra security calls)
// =============================================================================

[m15_hi, m15_hi_t, m15_lo, m15_lo_t, m15_hi_brk, m15_lo_brk] = track_period("15")
[h1_hi,  h1_hi_t,  h1_lo,  h1_lo_t,  h1_hi_brk,  h1_lo_brk]  = track_period("60")
[h4_hi,  h4_hi_t,  h4_lo,  h4_lo_t,  h4_hi_brk,  h4_lo_brk]  = track_period("240")
[dy_hi,  dy_hi_t,  dy_lo,  dy_lo_t,  dy_hi_brk,  dy_lo_brk]  = track_period("1D")
[wk_hi,  wk_hi_t,  wk_lo,  wk_lo_t,  wk_hi_brk,  wk_lo_brk]  = track_period("1W")
[mn_hi,  mn_hi_t,  mn_lo,  mn_lo_t,  mn_hi_brk,  mn_lo_brk]  = track_period("1M")

// =============================================================================
// S6 — EDGE-DETECT STRUCTURE BREAKS
// track_period returns hi_brk_t/lo_brk_t which go from na → timestamp once.
// Edge-detect: not na(brk_t) and na(prev_brk_t)
// =============================================================================

var int prev_m15_hi_brk = na
bool m15_hi_just_broke = not na(m15_hi_brk) and na(prev_m15_hi_brk)
prev_m15_hi_brk := m15_hi_brk
var int prev_m15_lo_brk = na
bool m15_lo_just_broke = not na(m15_lo_brk) and na(prev_m15_lo_brk)
prev_m15_lo_brk := m15_lo_brk

var int prev_h1_hi_brk = na
bool h1_hi_just_broke = not na(h1_hi_brk) and na(prev_h1_hi_brk)
prev_h1_hi_brk := h1_hi_brk
var int prev_h1_lo_brk = na
bool h1_lo_just_broke = not na(h1_lo_brk) and na(prev_h1_lo_brk)
prev_h1_lo_brk := h1_lo_brk

var int prev_h4_hi_brk = na
bool h4_hi_just_broke = not na(h4_hi_brk) and na(prev_h4_hi_brk)
prev_h4_hi_brk := h4_hi_brk
var int prev_h4_lo_brk = na
bool h4_lo_just_broke = not na(h4_lo_brk) and na(prev_h4_lo_brk)
prev_h4_lo_brk := h4_lo_brk

var int prev_dy_hi_brk = na
bool dy_hi_just_broke = not na(dy_hi_brk) and na(prev_dy_hi_brk)
prev_dy_hi_brk := dy_hi_brk
var int prev_dy_lo_brk = na
bool dy_lo_just_broke = not na(dy_lo_brk) and na(prev_dy_lo_brk)
prev_dy_lo_brk := dy_lo_brk

var int prev_wk_hi_brk = na
bool wk_hi_just_broke = not na(wk_hi_brk) and na(prev_wk_hi_brk)
prev_wk_hi_brk := wk_hi_brk
var int prev_wk_lo_brk = na
bool wk_lo_just_broke = not na(wk_lo_brk) and na(prev_wk_lo_brk)
prev_wk_lo_brk := wk_lo_brk

var int prev_mn_hi_brk = na
bool mn_hi_just_broke = not na(mn_hi_brk) and na(prev_mn_hi_brk)
prev_mn_hi_brk := mn_hi_brk
var int prev_mn_lo_brk = na
bool mn_lo_just_broke = not na(mn_lo_brk) and na(prev_mn_lo_brk)
prev_mn_lo_brk := mn_lo_brk

// =============================================================================
// S7 — ZONE ARRAYS + EXECUTION
// Pairing: zones on lower TF, push triggered by higher TF structure break
// =============================================================================

var array<Zone> zones0 = array.new<Zone>()
var array<Zone> zones1 = array.new<Zone>()
var array<Zone> zones2 = array.new<Zone>()
var array<Zone> zones3 = array.new<Zone>()
var array<Zone> zones4 = array.new<Zone>()
var array<Zone> zones5 = array.new<Zone>()

// M5 zones → M15 structure
if i_p0_on
    zones0.process(f0, zt0, zb0, s0, tm0, h1s0, l1s0, "5", m15_hi_just_broke, m15_lo_just_broke)

// M15 zones → H1 structure
if i_p1_on
    zones1.process(f1, zt1, zb1, s1, tm1, h1s1, l1s1, "15", h1_hi_just_broke, h1_lo_just_broke)

// H1 zones → H4 structure
if i_p2_on
    zones2.process(f2, zt2, zb2, s2, tm2, h1s2, l1s2, "60", h4_hi_just_broke, h4_lo_just_broke)

// H4 zones → D structure
if i_p3_on
    zones3.process(f3, zt3, zb3, s3, tm3, h1s3, l1s3, "240", dy_hi_just_broke, dy_lo_just_broke)

// D zones → W structure
if i_p4_on
    zones4.process(f4, zt4, zb4, s4, tm4, h1s4, l1s4, "1D", wk_hi_just_broke, wk_lo_just_broke)

// W zones → MN structure
if i_p5_on
    zones5.process(f5, zt5, zb5, s5, tm5, h1s5, l1s5, "1W", mn_hi_just_broke, mn_lo_just_broke)
