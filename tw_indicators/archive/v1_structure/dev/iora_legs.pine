//@version=6
indicator("Iora Leg Tracker + EW Waves", overlay=true)

// =============================================================================
// Module 4: Leg Tracker + Elliott Wave Pattern Detection
// Tracks per-TF leg state (direction, leg number, what it's building at parent).
// Leg transitions fire on STRONG conviction events from the envelope cascade.
// EW wave pivot tracking + pattern detection on a user-selected TF.
// Dynamic exhaustion threshold output per detected EW pattern.
// Designed for M1 chart. Computes envelope + conviction internally.
// =============================================================================

// =============================================================================
// INPUTS
// =============================================================================

string GRP_EW = "Elliott Wave"
string i_ew_tf  = input.string("H1", "EW Tracking TF", options=["M15", "H1", "H4", "D"], group=GRP_EW)
bool   i_ew_lbl = input.bool(false, "Show EW wave labels", group=GRP_EW)
bool   i_ew_fib = input.bool(false, "Show Fibonacci projections", group=GRP_EW)

string GRP_LEG = "Leg Markers"
string i_leg_tf  = input.string("H1", "Show leg markers for", options=["M5", "M15", "H1", "H4", "D", "W", "None"], group=GRP_LEG)
bool   i_leg_lbl = input.bool(true, "Show leg transition labels", group=GRP_LEG)

string GRP_DASH = "Dashboard"
bool   i_dash_on  = input.bool(true, "Show Dashboard", group=GRP_DASH)
string i_dash_pos = input.string("Bottom Right", "Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=GRP_DASH)

// =============================================================================
// REQUEST.SECURITY — Live building candle OHLC per child TF
// =============================================================================

[m5o,  m5h,  m5l,  m5c,  m5t,  m5tc]  = request.security(syminfo.tickerid, "5",   [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[m15o, m15h, m15l, m15c, m15t, m15tc] = request.security(syminfo.tickerid, "15",  [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[h1o,  h1h,  h1l,  h1c,  h1t,  h1tc]  = request.security(syminfo.tickerid, "60",  [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[h4o,  h4h,  h4l,  h4c,  h4t,  h4tc]  = request.security(syminfo.tickerid, "240", [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[d_o,  d_h,  d_l,  d_c,  d_t,  d_tc]  = request.security(syminfo.tickerid, "1D",  [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[w_o,  w_h,  w_l,  w_c,  w_t,  w_tc]  = request.security(syminfo.tickerid, "1W",  [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)

bool m5_new  = ta.change(m5t)  != 0
bool m15_new = ta.change(m15t) != 0
bool h1_new  = ta.change(h1t)  != 0
bool h4_new  = ta.change(h4t)  != 0
bool d_new   = ta.change(d_t)  != 0
bool w_new   = ta.change(w_t)  != 0

// =============================================================================
// ENVELOPE COMPUTATION (same logic as Module 2)
// =============================================================================

// M5 envelope: child = M1, N=5
float m5_env_ceil  = ta.sma(high, 5)
float m5_env_floor = ta.sma(low, 5)
float m5_env_mid   = ta.sma(close, 5)

// M15 envelope: child = M5, N=3
var array<float> m5_ch_hi = array.new_float(0)
var array<float> m5_ch_lo = array.new_float(0)
var array<float> m5_ch_cl = array.new_float(0)
var int m5_ch_cnt = 0
if m5_new and not na(m5h[1])
    m5_ch_hi.unshift(m5h[1])
    m5_ch_lo.unshift(m5l[1])
    m5_ch_cl.unshift(m5c[1])
    m5_ch_cnt += 1
    if m5_ch_hi.size() > 2
        m5_ch_hi.pop()
        m5_ch_lo.pop()
        m5_ch_cl.pop()
float m15_env_ceil  = m5_ch_cnt >= 2 ? (m5_ch_hi.sum() + m5h) / 3 : na
float m15_env_floor = m5_ch_cnt >= 2 ? (m5_ch_lo.sum() + m5l) / 3 : na
float m15_env_mid   = m5_ch_cnt >= 2 ? (m5_ch_cl.sum() + m5c) / 3 : na

// H1 envelope: child = M15, N=4
var array<float> m15_ch_hi = array.new_float(0)
var array<float> m15_ch_lo = array.new_float(0)
var array<float> m15_ch_cl = array.new_float(0)
var int m15_ch_cnt = 0
if m15_new and not na(m15h[1])
    m15_ch_hi.unshift(m15h[1])
    m15_ch_lo.unshift(m15l[1])
    m15_ch_cl.unshift(m15c[1])
    m15_ch_cnt += 1
    if m15_ch_hi.size() > 3
        m15_ch_hi.pop()
        m15_ch_lo.pop()
        m15_ch_cl.pop()
float h1_env_ceil  = m15_ch_cnt >= 3 ? (m15_ch_hi.sum() + m15h) / 4 : na
float h1_env_floor = m15_ch_cnt >= 3 ? (m15_ch_lo.sum() + m15l) / 4 : na
float h1_env_mid   = m15_ch_cnt >= 3 ? (m15_ch_cl.sum() + m15c) / 4 : na

// H4 envelope: child = H1, N=4
var array<float> h1_ch_hi = array.new_float(0)
var array<float> h1_ch_lo = array.new_float(0)
var array<float> h1_ch_cl = array.new_float(0)
var int h1_ch_cnt = 0
if h1_new and not na(h1h[1])
    h1_ch_hi.unshift(h1h[1])
    h1_ch_lo.unshift(h1l[1])
    h1_ch_cl.unshift(h1c[1])
    h1_ch_cnt += 1
    if h1_ch_hi.size() > 3
        h1_ch_hi.pop()
        h1_ch_lo.pop()
        h1_ch_cl.pop()
float h4_env_ceil  = h1_ch_cnt >= 3 ? (h1_ch_hi.sum() + h1h) / 4 : na
float h4_env_floor = h1_ch_cnt >= 3 ? (h1_ch_lo.sum() + h1l) / 4 : na
float h4_env_mid   = h1_ch_cnt >= 3 ? (h1_ch_cl.sum() + h1c) / 4 : na

// D envelope: child = H4, N=6
var array<float> h4_ch_hi = array.new_float(0)
var array<float> h4_ch_lo = array.new_float(0)
var array<float> h4_ch_cl = array.new_float(0)
var int h4_ch_cnt = 0
if h4_new and not na(h4h[1])
    h4_ch_hi.unshift(h4h[1])
    h4_ch_lo.unshift(h4l[1])
    h4_ch_cl.unshift(h4c[1])
    h4_ch_cnt += 1
    if h4_ch_hi.size() > 5
        h4_ch_hi.pop()
        h4_ch_lo.pop()
        h4_ch_cl.pop()
float d_env_ceil  = h4_ch_cnt >= 5 ? (h4_ch_hi.sum() + h4h) / 6 : na
float d_env_floor = h4_ch_cnt >= 5 ? (h4_ch_lo.sum() + h4l) / 6 : na
float d_env_mid   = h4_ch_cnt >= 5 ? (h4_ch_cl.sum() + h4c) / 6 : na

// W envelope: child = D, N=5
var array<float> d_ch_hi = array.new_float(0)
var array<float> d_ch_lo = array.new_float(0)
var array<float> d_ch_cl = array.new_float(0)
var int d_ch_cnt = 0
if d_new and not na(d_h[1])
    d_ch_hi.unshift(d_h[1])
    d_ch_lo.unshift(d_l[1])
    d_ch_cl.unshift(d_c[1])
    d_ch_cnt += 1
    if d_ch_hi.size() > 4
        d_ch_hi.pop()
        d_ch_lo.pop()
        d_ch_cl.pop()
float w_env_ceil  = d_ch_cnt >= 4 ? (d_ch_hi.sum() + d_h) / 5 : na
float w_env_floor = d_ch_cnt >= 4 ? (d_ch_lo.sum() + d_l) / 5 : na
float w_env_mid   = d_ch_cnt >= 4 ? (d_ch_cl.sum() + d_c) / 5 : na

// =============================================================================
// GRADIENTS
// =============================================================================

float m5_ceil_d  = ta.change(m5_env_ceil)
float m5_floor_d = ta.change(m5_env_floor)
float m5_mid_d   = ta.change(m5_env_mid)

float m15_ceil_d  = ta.change(m15_env_ceil)
float m15_floor_d = ta.change(m15_env_floor)
float m15_mid_d   = ta.change(m15_env_mid)

float h1_ceil_d  = ta.change(h1_env_ceil)
float h1_floor_d = ta.change(h1_env_floor)
float h1_mid_d   = ta.change(h1_env_mid)

float h4_ceil_d  = ta.change(h4_env_ceil)
float h4_floor_d = ta.change(h4_env_floor)
float h4_mid_d   = ta.change(h4_env_mid)

float d_ceil_d  = ta.change(d_env_ceil)
float d_floor_d = ta.change(d_env_floor)
float d_mid_d   = ta.change(d_env_mid)

float w_ceil_d  = ta.change(w_env_ceil)
float w_floor_d = ta.change(w_env_floor)
float w_mid_d   = ta.change(w_env_mid)

// =============================================================================
// CONVICTION HELPERS (same as Module 2)
// =============================================================================

assess_conv(bool floor_brk, bool ceil_brk, bool mid_against, bool mid_stall, float floor_d, float ceil_d, int leg) =>
    int cv = 0
    int sd = 0
    if leg > 0
        if floor_brk and mid_against and ceil_d <= 0.0
            cv := 3
            sd := -1
        else if floor_brk
            cv := 2
            sd := -1
        else if mid_stall and ceil_d <= 0.0
            cv := 1
            sd := -1
    else if leg < 0
        if ceil_brk and mid_against and floor_d >= 0.0
            cv := 3
            sd := 1
        else if ceil_brk
            cv := 2
            sd := 1
        else if mid_stall and floor_d >= 0.0
            cv := 1
            sd := 1
    [cv, sd]

// =============================================================================
// PER-TF CONVICTION + LEG STATE
// Each TF tracks: conviction (cv/sd), leg direction, leg number, building,
// leg_high, leg_low, prev_leg_high, prev_leg_low, swing_class.
// Leg transitions fire on STRONG conviction events (cv == 3).
// swing_class: 0=PENDING, 1=HH, 2=LH, 3=LL, 4=HL
// building: 1=PARENT_HIGH, -1=PARENT_LOW
// =============================================================================

// --- Generic leg transition logic ---
// Returns: [new_dir, new_legnum, new_building, new_leg_hi, new_leg_lo,
//           new_prev_hi, new_prev_lo, new_swing, transition_fired]
leg_transition(int cv, int sd, int dir, int legnum, int building, float leg_hi, float leg_lo, float prev_hi, float prev_lo, float child_hi, float child_lo) =>
    int   n_dir      = dir
    int   n_legnum   = legnum
    int   n_building = building
    float n_leg_hi   = na(leg_hi) ? child_hi : math.max(leg_hi, child_hi)
    float n_leg_lo   = na(leg_lo) ? child_lo : math.min(leg_lo, child_lo)
    float n_prev_hi  = prev_hi
    float n_prev_lo  = prev_lo
    int   n_swing    = 0
    bool  fired      = false

    // Init: first STRONG event sets direction
    if dir == 0 and cv == 3
        n_dir      := sd
        n_legnum   := 1
        n_building := sd > 0 ? 1 : -1
        n_leg_hi   := child_hi
        n_leg_lo   := child_lo
        fired      := true
    // STRONG reversal: leg transition
    else if cv == 3 and sd != dir
        // Classify completed swing
        if dir > 0
            // UP-leg ending → swing high confirmed
            n_swing := not na(prev_hi) ? (leg_hi > prev_hi ? 1 : 2) : 0
            n_prev_hi := leg_hi
        else
            // DOWN-leg ending → swing low confirmed
            n_swing := not na(prev_lo) ? (leg_lo < prev_lo ? 3 : 4) : 0
            n_prev_lo := leg_lo
        // Start new leg
        n_dir      := sd
        n_legnum   := legnum + 1
        n_building := sd > 0 ? 1 : -1
        n_leg_hi   := child_hi
        n_leg_lo   := child_lo
        fired      := true
    // STRONG continuation: same direction, reinforce
    else if cv == 3 and sd == dir
        n_leg_hi := math.max(nz(leg_hi, child_hi), child_hi)
        n_leg_lo := math.min(nz(leg_lo, child_lo), child_lo)

    [n_dir, n_legnum, n_building, n_leg_hi, n_leg_lo, n_prev_hi, n_prev_lo, n_swing, fired]

// --- M5 ---
var int   m5_leg = 0
if m5_leg == 0 and nz(m5_mid_d) != 0.0
    m5_leg := nz(m5_mid_d) > 0.0 ? 1 : -1
bool m5_fbrk = low < m5_env_floor
bool m5_cbrk = high > m5_env_ceil
bool m5_mag  = (m5_leg > 0 and nz(m5_mid_d) < 0.0) or (m5_leg < 0 and nz(m5_mid_d) > 0.0)
bool m5_mst  = math.abs(nz(m5_mid_d)) < math.abs(nz(m5_mid_d[1])) * 0.3
[m5_cv, m5_sd] = assess_conv(m5_fbrk, m5_cbrk, m5_mag, m5_mst, nz(m5_floor_d), nz(m5_ceil_d), m5_leg)

var int   m5_dir   = 0
var int   m5_lnum  = 0
var int   m5_bld   = 0
var float m5_lhi   = na
var float m5_llo   = na
var float m5_phi   = na
var float m5_plo   = na
int m5_swc = 0
bool m5_fired = false
[m5_dir2, m5_lnum2, m5_bld2, m5_lhi2, m5_llo2, m5_phi2, m5_plo2, m5_swc2, m5_f2] = leg_transition(m5_cv, m5_sd, m5_dir, m5_lnum, m5_bld, m5_lhi, m5_llo, m5_phi, m5_plo, high, low)
m5_dir  := m5_dir2
m5_lnum := m5_lnum2
m5_bld  := m5_bld2
m5_lhi  := m5_lhi2
m5_llo  := m5_llo2
m5_phi  := m5_phi2
m5_plo  := m5_plo2
m5_swc  := m5_swc2
m5_fired := m5_f2
if m5_cv == 3
    m5_leg := m5_sd

// --- M15 ---
var int   m15_leg = 0
if m15_leg == 0 and nz(m15_mid_d) != 0.0
    m15_leg := nz(m15_mid_d) > 0.0 ? 1 : -1
bool m15_fbrk = m5l < m15_env_floor
bool m15_cbrk = m5h > m15_env_ceil
bool m15_mag  = (m15_leg > 0 and nz(m15_mid_d) < 0.0) or (m15_leg < 0 and nz(m15_mid_d) > 0.0)
bool m15_mst  = math.abs(nz(m15_mid_d)) < math.abs(nz(m15_mid_d[1])) * 0.3
[m15_cv, m15_sd] = assess_conv(m15_fbrk, m15_cbrk, m15_mag, m15_mst, nz(m15_floor_d), nz(m15_ceil_d), m15_leg)

var int   m15_dir   = 0
var int   m15_lnum  = 0
var int   m15_bld   = 0
var float m15_lhi   = na
var float m15_llo   = na
var float m15_phi   = na
var float m15_plo   = na
int m15_swc = 0
bool m15_fired = false
[m15_dir2, m15_lnum2, m15_bld2, m15_lhi2, m15_llo2, m15_phi2, m15_plo2, m15_swc2, m15_f2] = leg_transition(m15_cv, m15_sd, m15_dir, m15_lnum, m15_bld, m15_lhi, m15_llo, m15_phi, m15_plo, m5h, m5l)
m15_dir  := m15_dir2
m15_lnum := m15_lnum2
m15_bld  := m15_bld2
m15_lhi  := m15_lhi2
m15_llo  := m15_llo2
m15_phi  := m15_phi2
m15_plo  := m15_plo2
m15_swc  := m15_swc2
m15_fired := m15_f2
if m15_cv == 3
    m15_leg := m15_sd

// --- H1 ---
var int   h1_leg = 0
if h1_leg == 0 and nz(h1_mid_d) != 0.0
    h1_leg := nz(h1_mid_d) > 0.0 ? 1 : -1
bool h1_fbrk = m15l < h1_env_floor
bool h1_cbrk = m15h > h1_env_ceil
bool h1_mag  = (h1_leg > 0 and nz(h1_mid_d) < 0.0) or (h1_leg < 0 and nz(h1_mid_d) > 0.0)
bool h1_mst  = math.abs(nz(h1_mid_d)) < math.abs(nz(h1_mid_d[1])) * 0.3
[h1_cv, h1_sd] = assess_conv(h1_fbrk, h1_cbrk, h1_mag, h1_mst, nz(h1_floor_d), nz(h1_ceil_d), h1_leg)

var int   h1_dir   = 0
var int   h1_lnum  = 0
var int   h1_bld   = 0
var float h1_lhi   = na
var float h1_llo   = na
var float h1_phi   = na
var float h1_plo   = na
int h1_swc = 0
bool h1_fired = false
[h1_dir2, h1_lnum2, h1_bld2, h1_lhi2, h1_llo2, h1_phi2, h1_plo2, h1_swc2, h1_f2] = leg_transition(h1_cv, h1_sd, h1_dir, h1_lnum, h1_bld, h1_lhi, h1_llo, h1_phi, h1_plo, m15h, m15l)
h1_dir  := h1_dir2
h1_lnum := h1_lnum2
h1_bld  := h1_bld2
h1_lhi  := h1_lhi2
h1_llo  := h1_llo2
h1_phi  := h1_phi2
h1_plo  := h1_plo2
h1_swc  := h1_swc2
h1_fired := h1_f2
if h1_cv == 3
    h1_leg := h1_sd

// --- H4 ---
var int   h4_leg = 0
if h4_leg == 0 and nz(h4_mid_d) != 0.0
    h4_leg := nz(h4_mid_d) > 0.0 ? 1 : -1
bool h4_fbrk = h1l < h4_env_floor
bool h4_cbrk = h1h > h4_env_ceil
bool h4_mag  = (h4_leg > 0 and nz(h4_mid_d) < 0.0) or (h4_leg < 0 and nz(h4_mid_d) > 0.0)
bool h4_mst  = math.abs(nz(h4_mid_d)) < math.abs(nz(h4_mid_d[1])) * 0.3
[h4_cv, h4_sd] = assess_conv(h4_fbrk, h4_cbrk, h4_mag, h4_mst, nz(h4_floor_d), nz(h4_ceil_d), h4_leg)

var int   h4_dir   = 0
var int   h4_lnum  = 0
var int   h4_bld   = 0
var float h4_lhi   = na
var float h4_llo   = na
var float h4_phi   = na
var float h4_plo   = na
int h4_swc = 0
bool h4_fired = false
[h4_dir2, h4_lnum2, h4_bld2, h4_lhi2, h4_llo2, h4_phi2, h4_plo2, h4_swc2, h4_f2] = leg_transition(h4_cv, h4_sd, h4_dir, h4_lnum, h4_bld, h4_lhi, h4_llo, h4_phi, h4_plo, h1h, h1l)
h4_dir  := h4_dir2
h4_lnum := h4_lnum2
h4_bld  := h4_bld2
h4_lhi  := h4_lhi2
h4_llo  := h4_llo2
h4_phi  := h4_phi2
h4_plo  := h4_plo2
h4_swc  := h4_swc2
h4_fired := h4_f2
if h4_cv == 3
    h4_leg := h4_sd

// --- D ---
var int   d_leg = 0
if d_leg == 0 and nz(d_mid_d) != 0.0
    d_leg := nz(d_mid_d) > 0.0 ? 1 : -1
bool d_fbrk = h4l < d_env_floor
bool d_cbrk = h4h > d_env_ceil
bool d_mag  = (d_leg > 0 and nz(d_mid_d) < 0.0) or (d_leg < 0 and nz(d_mid_d) > 0.0)
bool d_mst  = math.abs(nz(d_mid_d)) < math.abs(nz(d_mid_d[1])) * 0.3
[d_cv, d_sd] = assess_conv(d_fbrk, d_cbrk, d_mag, d_mst, nz(d_floor_d), nz(d_ceil_d), d_leg)

var int   d_dir   = 0
var int   d_lnum  = 0
var int   d_bld   = 0
var float d_lhi   = na
var float d_llo   = na
var float d_phi   = na
var float d_plo   = na
int d_swc = 0
bool d_fired = false
[d_dir2, d_lnum2, d_bld2, d_lhi2, d_llo2, d_phi2, d_plo2, d_swc2, d_f2] = leg_transition(d_cv, d_sd, d_dir, d_lnum, d_bld, d_lhi, d_llo, d_phi, d_plo, h4h, h4l)
d_dir  := d_dir2
d_lnum := d_lnum2
d_bld  := d_bld2
d_lhi  := d_lhi2
d_llo  := d_llo2
d_phi  := d_phi2
d_plo  := d_plo2
d_swc  := d_swc2
d_fired := d_f2
if d_cv == 3
    d_leg := d_sd

// --- W ---
var int   w_leg = 0
if w_leg == 0 and nz(w_mid_d) != 0.0
    w_leg := nz(w_mid_d) > 0.0 ? 1 : -1
bool w_fbrk = d_l < w_env_floor
bool w_cbrk = d_h > w_env_ceil
bool w_mag  = (w_leg > 0 and nz(w_mid_d) < 0.0) or (w_leg < 0 and nz(w_mid_d) > 0.0)
bool w_mst  = math.abs(nz(w_mid_d)) < math.abs(nz(w_mid_d[1])) * 0.3
[w_cv, w_sd] = assess_conv(w_fbrk, w_cbrk, w_mag, w_mst, nz(w_floor_d), nz(w_ceil_d), w_leg)

var int   w_dir   = 0
var int   w_lnum  = 0
var int   w_bld   = 0
var float w_lhi   = na
var float w_llo   = na
var float w_phi   = na
var float w_plo   = na
int w_swc = 0
bool w_fired = false
[w_dir2, w_lnum2, w_bld2, w_lhi2, w_llo2, w_phi2, w_plo2, w_swc2, w_f2] = leg_transition(w_cv, w_sd, w_dir, w_lnum, w_bld, w_lhi, w_llo, w_phi, w_plo, d_h, d_l)
w_dir  := w_dir2
w_lnum := w_lnum2
w_bld  := w_bld2
w_lhi  := w_lhi2
w_llo  := w_llo2
w_phi  := w_phi2
w_plo  := w_plo2
w_swc  := w_swc2
w_fired := w_f2
if w_cv == 3
    w_leg := w_sd

// =============================================================================
// ELLIOTT WAVE TRACKING — on the user-selected TF
// Tracks impulse wave pivots (W1-W5) and correction pivots (A/B/C).
// Uses leg swing classifications (HH/LH/HL/LL) to count waves.
// wave_phase: 0=INIT, 1=BULL_IMPULSE, 2=BULL_CORRECTION, 3=BEAR_IMPULSE, 4=BEAR_CORRECTION
// =============================================================================

// Mux: select the TF's leg state for EW tracking
int   ew_dir   = 0
int   ew_lnum  = 0
int   ew_swc   = 0
bool  ew_fired = false
float ew_lhi   = na
float ew_llo   = na
float ew_phi   = na
float ew_plo   = na

if i_ew_tf == "M15"
    ew_dir   := m15_dir
    ew_lnum  := m15_lnum
    ew_swc   := m15_swc
    ew_fired := m15_fired
    ew_lhi   := m15_lhi
    ew_llo   := m15_llo
    ew_phi   := m15_phi
    ew_plo   := m15_plo
else if i_ew_tf == "H1"
    ew_dir   := h1_dir
    ew_lnum  := h1_lnum
    ew_swc   := h1_swc
    ew_fired := h1_fired
    ew_lhi   := h1_lhi
    ew_llo   := h1_llo
    ew_phi   := h1_phi
    ew_plo   := h1_plo
else if i_ew_tf == "H4"
    ew_dir   := h4_dir
    ew_lnum  := h4_lnum
    ew_swc   := h4_swc
    ew_fired := h4_fired
    ew_lhi   := h4_lhi
    ew_llo   := h4_llo
    ew_phi   := h4_phi
    ew_plo   := h4_plo
else if i_ew_tf == "D"
    ew_dir   := d_dir
    ew_lnum  := d_lnum
    ew_swc   := d_swc
    ew_fired := d_fired
    ew_lhi   := d_lhi
    ew_llo   := d_llo
    ew_phi   := d_phi
    ew_plo   := d_plo

// EW state variables (persistent)
var int   ew_phase    = 0
var int   ew_imp_cnt  = 0
var int   ew_cor_cnt  = 0

// Bullish impulse pivots
var float ew_b_w1_top = na
var float ew_b_w1_bot = na
var float ew_b_w2_bot = na
var float ew_b_w3_top = na
var float ew_b_w4_bot = na
var float ew_b_w5_top = na

// Bearish impulse pivots
var float ew_s_w1_bot = na
var float ew_s_w1_top = na
var float ew_s_w2_top = na
var float ew_s_w3_bot = na
var float ew_s_w4_top = na
var float ew_s_w5_bot = na

// Correction pivots
var float ew_cor_start = na
var float ew_cor_a     = na
var float ew_cor_b     = na
var float ew_cor_c     = na
var bool  ew_cor_bull  = false

// Pattern classification: 0=UNK, 1=IMPULSE, 2=DIAGONAL, 3=EXTENDED,
//   4=REG_FLAT, 5=EXP_FLAT, 6=RUN_FLAT, 7=SYM_TRI, 8=ASC_TRI, 9=REV_SYM
var int ew_pattern = 0
var int ew_pat_prev = 0

// Wave count tracking — uses swing classifications from leg tracker
// HH (swc==1) in UP phase = impulse continuation
// LL (swc==3) in DOWN phase = impulse continuation
// LH (swc==2) after UP = potential reversal
// HL (swc==4) after DOWN = potential reversal

if ew_fired
    ew_pat_prev := ew_pattern

    // Phase 0: INIT — wait for first classified swing
    if ew_phase == 0
        if ew_swc == 1
            // HH = bullish impulse starting
            ew_phase    := 1
            ew_imp_cnt  := 1
            ew_b_w1_top := ew_phi
            ew_b_w1_bot := nz(ew_plo)
            ew_b_w2_bot := na
            ew_b_w3_top := na
            ew_b_w4_bot := na
            ew_b_w5_top := na
        else if ew_swc == 3
            // LL = bearish impulse starting
            ew_phase    := 3
            ew_imp_cnt  := 1
            ew_s_w1_bot := ew_plo
            ew_s_w1_top := nz(ew_phi)
            ew_s_w2_top := na
            ew_s_w3_bot := na
            ew_s_w4_top := na
            ew_s_w5_bot := na

    // Phase 1: BULL IMPULSE — counting HH as impulse zones
    else if ew_phase == 1
        if ew_swc == 1
            // HH = impulse continuation
            ew_imp_cnt += 1
            if ew_imp_cnt == 3
                ew_b_w3_top := ew_phi
            else if ew_imp_cnt == 5
                ew_b_w5_top := ew_phi
        else if ew_swc == 4
            // HL = correction within impulse (Wave 2 or 4)
            if ew_imp_cnt == 1
                ew_b_w2_bot := ew_plo
            else if ew_imp_cnt >= 3 and na(ew_b_w4_bot)
                ew_b_w4_bot := ew_plo
        else if ew_swc == 2
            // LH = impulse is weakening, potential transition to correction
            if ew_imp_cnt >= 3
                ew_phase     := 2
                ew_cor_cnt   := 1
                ew_cor_start := nz(ew_b_w5_top, nz(ew_b_w3_top, ew_b_w1_top))
                ew_cor_a     := ew_plo
                ew_cor_b     := na
                ew_cor_c     := na
                ew_cor_bull  := false
        else if ew_swc == 3
            // LL = full reversal to bearish impulse
            ew_phase    := 3
            ew_imp_cnt  := 1
            ew_s_w1_bot := ew_plo
            ew_s_w1_top := nz(ew_phi)
            ew_s_w2_top := na
            ew_s_w3_bot := na
            ew_s_w4_top := na
            ew_s_w5_bot := na

    // Phase 2: BULL CORRECTION (correcting a bullish impulse = bearish correction)
    else if ew_phase == 2
        if ew_swc == 1
            // HH during correction = correction may be over, new bull impulse
            ew_phase    := 1
            ew_imp_cnt  := 1
            ew_b_w1_top := ew_phi
            ew_b_w1_bot := nz(ew_plo)
            ew_b_w2_bot := na
            ew_b_w3_top := na
            ew_b_w4_bot := na
            ew_b_w5_top := na
            ew_cor_start := na
            ew_cor_a     := na
            ew_cor_b     := na
            ew_cor_c     := na
        else if ew_swc == 4 or ew_swc == 2
            // HL or LH within correction
            ew_cor_cnt += 1
            if ew_cor_cnt == 2
                ew_cor_b := ew_swc == 4 ? ew_phi : ew_phi
            else if ew_cor_cnt >= 3
                ew_cor_c := ew_plo
        else if ew_swc == 3
            // LL during correction = bearish impulse taking over
            ew_phase    := 3
            ew_imp_cnt  := 1
            ew_s_w1_bot := ew_plo
            ew_s_w1_top := nz(ew_phi)
            ew_s_w2_top := na
            ew_s_w3_bot := na
            ew_s_w4_top := na
            ew_s_w5_bot := na
            ew_cor_start := na
            ew_cor_a     := na
            ew_cor_b     := na
            ew_cor_c     := na

    // Phase 3: BEAR IMPULSE — counting LL as impulse zones
    else if ew_phase == 3
        if ew_swc == 3
            // LL = impulse continuation
            ew_imp_cnt += 1
            if ew_imp_cnt == 3
                ew_s_w3_bot := ew_plo
            else if ew_imp_cnt == 5
                ew_s_w5_bot := ew_plo
        else if ew_swc == 2
            // LH = correction within impulse (Wave 2 or 4)
            if ew_imp_cnt == 1
                ew_s_w2_top := ew_phi
            else if ew_imp_cnt >= 3 and na(ew_s_w4_top)
                ew_s_w4_top := ew_phi
        else if ew_swc == 4
            // HL = impulse weakening, potential transition to correction
            if ew_imp_cnt >= 3
                ew_phase     := 4
                ew_cor_cnt   := 1
                ew_cor_start := nz(ew_s_w5_bot, nz(ew_s_w3_bot, ew_s_w1_bot))
                ew_cor_a     := ew_phi
                ew_cor_b     := na
                ew_cor_c     := na
                ew_cor_bull  := true
        else if ew_swc == 1
            // HH = full reversal to bullish impulse
            ew_phase    := 1
            ew_imp_cnt  := 1
            ew_b_w1_top := ew_phi
            ew_b_w1_bot := nz(ew_plo)
            ew_b_w2_bot := na
            ew_b_w3_top := na
            ew_b_w4_bot := na
            ew_b_w5_top := na

    // Phase 4: BEAR CORRECTION (correcting a bearish impulse = bullish correction)
    else if ew_phase == 4
        if ew_swc == 3
            // LL during correction = correction over, new bear impulse
            ew_phase    := 3
            ew_imp_cnt  := 1
            ew_s_w1_bot := ew_plo
            ew_s_w1_top := nz(ew_phi)
            ew_s_w2_top := na
            ew_s_w3_bot := na
            ew_s_w4_top := na
            ew_s_w5_bot := na
            ew_cor_start := na
            ew_cor_a     := na
            ew_cor_b     := na
            ew_cor_c     := na
        else if ew_swc == 2 or ew_swc == 4
            // LH or HL within correction
            ew_cor_cnt += 1
            if ew_cor_cnt == 2
                ew_cor_b := ew_swc == 2 ? ew_plo : ew_plo
            else if ew_cor_cnt >= 3
                ew_cor_c := ew_phi
        else if ew_swc == 1
            // HH during correction = bullish impulse taking over
            ew_phase    := 1
            ew_imp_cnt  := 1
            ew_b_w1_top := ew_phi
            ew_b_w1_bot := nz(ew_plo)
            ew_b_w2_bot := na
            ew_b_w3_top := na
            ew_b_w4_bot := na
            ew_b_w5_top := na
            ew_cor_start := na
            ew_cor_a     := na
            ew_cor_b     := na
            ew_cor_c     := na

// =============================================================================
// EW PATTERN CLASSIFICATION
// =============================================================================

// Motive patterns (phase 1 or 3)
if ew_phase == 1 and ew_imp_cnt >= 2
    if not na(ew_b_w1_top) and not na(ew_b_w4_bot)
        // DIAGONAL: W4 overlaps W1
        if ew_b_w4_bot < ew_b_w1_top
            ew_pattern := 2
        else
            // EXTENDED: W3 > 1.618 * W1
            float w1_rng = nz(ew_b_w1_top) - nz(ew_b_w1_bot)
            float w3_rng = not na(ew_b_w3_top) and not na(ew_b_w2_bot) ? (ew_b_w3_top - ew_b_w2_bot) : 0.0
            if w1_rng > 0 and w3_rng > w1_rng * 1.618
                ew_pattern := 3
            else
                ew_pattern := 1
    else if not na(ew_b_w1_top)
        ew_pattern := 1
else if ew_phase == 3 and ew_imp_cnt >= 2
    if not na(ew_s_w1_bot) and not na(ew_s_w4_top)
        // DIAGONAL: W4 overlaps W1
        if ew_s_w4_top > ew_s_w1_bot
            ew_pattern := 2
        else
            // EXTENDED: W3 > 1.618 * W1
            float w1_rng_s = nz(ew_s_w1_top) - nz(ew_s_w1_bot)
            float w3_rng_s = not na(ew_s_w3_bot) and not na(ew_s_w2_top) ? (ew_s_w2_top - ew_s_w3_bot) : 0.0
            if w1_rng_s > 0 and w3_rng_s > w1_rng_s * 1.618
                ew_pattern := 3
            else
                ew_pattern := 1
    else if not na(ew_s_w1_bot)
        ew_pattern := 1

// Corrective patterns (phase 2 or 4)
else if (ew_phase == 2 or ew_phase == 4) and not na(ew_cor_start) and not na(ew_cor_a)
    if not na(ew_cor_b)
        float a_rng = 0.0
        float b_ret = 0.0
        bool  b_past = false
        if not ew_cor_bull
            // Bearish correction (after bullish impulse)
            a_rng  := ew_cor_start - ew_cor_a
            b_ret  := ew_cor_b - ew_cor_a
            b_past := ew_cor_b > ew_cor_start
        else
            // Bullish correction (after bearish impulse)
            a_rng  := ew_cor_a - ew_cor_start
            b_ret  := ew_cor_a - ew_cor_b
            b_past := ew_cor_b < ew_cor_start
        float ret_pct = a_rng != 0 ? math.abs(b_ret / a_rng) : 0.0

        if b_past
            ew_pattern := 5
        else if ret_pct >= 0.9 and ret_pct <= 1.1
            ew_pattern := 4
        else if not na(ew_cor_c)
            bool run_ok = false
            if not ew_cor_bull
                run_ok := ew_cor_b > ew_cor_a and ew_cor_c < ew_cor_start
            else
                run_ok := ew_cor_b < ew_cor_a and ew_cor_c > ew_cor_start
            ew_pattern := run_ok ? 6 : 4
        else
            ew_pattern := 4
    else if ew_cor_cnt >= 1
        ew_pattern := 4

// =============================================================================
// DYNAMIC EXHAUSTION THRESHOLD
// Standard=5, Extended W3=7-9, Diagonal=3-4
// =============================================================================

var int ew_threshold = 5
if ew_pattern == 2
    ew_threshold := 4
else if ew_pattern == 3
    ew_threshold := 8
else
    ew_threshold := 5

// How close to exhaustion: 0.0 = fresh, 1.0 = at threshold, >1.0 = past
float ew_exhaust_pct = ew_imp_cnt > 0 ? ew_imp_cnt / float(ew_threshold) : 0.0

// =============================================================================
// EW WAVE LABELS (optional on-chart markers)
// =============================================================================

ew_wave_str(int phase, int imp_cnt, int cor_cnt) =>
    string result = ""
    if phase == 1 or phase == 3
        result := "W" + str.tostring(imp_cnt)
    else if phase == 2 or phase == 4
        result := cor_cnt == 1 ? "A" : cor_cnt == 2 ? "B" : "C"
    result

if i_ew_lbl and ew_fired and ew_swc > 0
    string wtxt = ew_wave_str(ew_phase, ew_imp_cnt, ew_cor_cnt)
    if str.length(wtxt) > 0
        color wclr = (ew_phase == 1 or ew_phase == 4) ? #26A69A : #EF5350
        if ew_dir > 0
            label.new(bar_index, low, wtxt, style=label.style_label_up, color=color.new(wclr, 70), textcolor=wclr, size=size.small)
        else
            label.new(bar_index, high, wtxt, style=label.style_label_down, color=color.new(wclr, 70), textcolor=wclr, size=size.small)

// =============================================================================
// FIBONACCI PROJECTION LINES (optional)
// =============================================================================

var line fib_w3_ln = na
var line fib_w5_ln = na

if i_ew_fib and barstate.islast
    if ew_phase == 1 and not na(ew_b_w1_top) and not na(ew_b_w1_bot)
        float w1_rng_f = ew_b_w1_top - ew_b_w1_bot
        // W3 target: 161.8% extension from W2 bottom
        if not na(ew_b_w2_bot)
            float w3_tgt = ew_b_w2_bot + w1_rng_f * 1.618
            if not na(fib_w3_ln)
                line.delete(fib_w3_ln)
            fib_w3_ln := line.new(bar_index - 20, w3_tgt, bar_index, w3_tgt, color=color.new(#26A69A, 50), style=line.style_dashed, width=1)
        // W5 target: 100% of W1 from W4 bottom
        if not na(ew_b_w4_bot)
            float w5_tgt = ew_b_w4_bot + w1_rng_f
            if not na(fib_w5_ln)
                line.delete(fib_w5_ln)
            fib_w5_ln := line.new(bar_index - 20, w5_tgt, bar_index, w5_tgt, color=color.new(#42A5F5, 50), style=line.style_dashed, width=1)
    else if ew_phase == 3 and not na(ew_s_w1_top) and not na(ew_s_w1_bot)
        float w1_rng_f = ew_s_w1_top - ew_s_w1_bot
        // W3 target: 161.8% extension from W2 top
        if not na(ew_s_w2_top)
            float w3_tgt = ew_s_w2_top - w1_rng_f * 1.618
            if not na(fib_w3_ln)
                line.delete(fib_w3_ln)
            fib_w3_ln := line.new(bar_index - 20, w3_tgt, bar_index, w3_tgt, color=color.new(#EF5350, 50), style=line.style_dashed, width=1)
        // W5 target: 100% of W1 from W4 top
        if not na(ew_s_w4_top)
            float w5_tgt = ew_s_w4_top - w1_rng_f
            if not na(fib_w5_ln)
                line.delete(fib_w5_ln)
            fib_w5_ln := line.new(bar_index - 20, w5_tgt, bar_index, w5_tgt, color=color.new(#42A5F5, 50), style=line.style_dashed, width=1)

// =============================================================================
// LEG TRANSITION MARKERS (plotshape for selected TF)
// =============================================================================

int   sel_swc   = 0
bool  sel_fired = false
int   sel_dir   = 0
if i_leg_tf == "M5"
    sel_swc   := m5_swc
    sel_fired := m5_fired
    sel_dir   := m5_dir
else if i_leg_tf == "M15"
    sel_swc   := m15_swc
    sel_fired := m15_fired
    sel_dir   := m15_dir
else if i_leg_tf == "H1"
    sel_swc   := h1_swc
    sel_fired := h1_fired
    sel_dir   := h1_dir
else if i_leg_tf == "H4"
    sel_swc   := h4_swc
    sel_fired := h4_fired
    sel_dir   := h4_dir
else if i_leg_tf == "D"
    sel_swc   := d_swc
    sel_fired := d_fired
    sel_dir   := d_dir
else if i_leg_tf == "W"
    sel_swc   := w_swc
    sel_fired := w_fired
    sel_dir   := w_dir

// Swing class labels at transition points
bool show_hh = sel_fired and sel_swc == 1 and i_leg_lbl
bool show_lh = sel_fired and sel_swc == 2 and i_leg_lbl
bool show_ll = sel_fired and sel_swc == 3 and i_leg_lbl
bool show_hl = sel_fired and sel_swc == 4 and i_leg_lbl

plotshape(show_hh, "HH", shape.triangleup,   location.belowbar, #26A69A, size=size.tiny)
plotshape(show_lh, "LH", shape.triangledown,  location.abovebar, color.new(#EF5350, 30), size=size.tiny)
plotshape(show_ll, "LL", shape.triangledown,  location.abovebar, #EF5350, size=size.tiny)
plotshape(show_hl, "HL", shape.triangleup,    location.belowbar, color.new(#26A69A, 30), size=size.tiny)

// =============================================================================
// DASHBOARD TABLE
// =============================================================================

string tbl_pos = switch i_dash_pos
    "Top Left"     => position.top_left
    "Top Right"    => position.top_right
    "Bottom Left"  => position.bottom_left
    "Bottom Right" => position.bottom_right
    => position.bottom_right

var table dash = table.new(tbl_pos, 8, 9, border_width=1, border_color=#363636, bgcolor=#1A1A2E)

// Helpers
dir_str(int d) =>
    d > 0 ? "UP" : d < 0 ? "DN" : "—"

dir_clr(int d) =>
    d > 0 ? #26A69A : d < 0 ? #EF5350 : #808080

bld_str(int b) =>
    b > 0 ? "P.HI" : b < 0 ? "P.LO" : "—"

swc_str(int s) =>
    switch s
        1 => "HH"
        2 => "LH"
        3 => "LL"
        4 => "HL"
        => "—"

swc_clr(int s) =>
    switch s
        1 => #26A69A
        2 => color.new(#EF5350, 30)
        3 => #EF5350
        4 => color.new(#26A69A, 30)
        => #808080

pat_str(int p) =>
    switch p
        1 => "IMP"
        2 => "DIAG"
        3 => "EXT"
        4 => "RFLAT"
        5 => "XFLAT"
        6 => "RFLAT"
        7 => "STRI"
        8 => "ATRI"
        9 => "RTRI"
        => "—"

pat_clr(int p) =>
    if p >= 1 and p <= 3
        p == 2 ? #FF9800 : (ew_phase == 1 ? #26A69A : #EF5350)
    else if p >= 4 and p <= 6
        #AB47BC
    else if p >= 7 and p <= 9
        #42A5F5
    else
        #808080

phase_str(int p) =>
    switch p
        1 => "BULL"
        2 => "B.COR"
        3 => "BEAR"
        4 => "S.COR"
        => "INIT"

// Dashboard rows
dash_leg_row(int row, string tf, int dir, int lnum, int bld, int swc) =>
    table.cell(dash, 0, row, tf,                  text_color=#AAAAAA, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 1, row, dir_str(dir),        text_color=dir_clr(dir), text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, row, str.tostring(lnum),  text_color=#CCCCCC, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 3, row, bld_str(bld),        text_color=dir_clr(bld), text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 4, row, swc_str(swc),        text_color=swc_clr(swc), text_size=size.small, text_halign=text.align_center)

if i_dash_on and barstate.islast
    // Header
    table.cell(dash, 0, 0, "TF",    text_color=#AAAAAA, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 1, 0, "Dir",   text_color=#AAAAAA, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 2, 0, "Leg#",  text_color=#AAAAAA, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 3, 0, "Build", text_color=#AAAAAA, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 4, 0, "Swing", text_color=#AAAAAA, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 5, 0, "EW",    text_color=#AAAAAA, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 6, 0, "Pat",   text_color=#AAAAAA, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 7, 0, "Exh",   text_color=#AAAAAA, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)

    // Leg rows (M5 through W)
    dash_leg_row(1, "M5",  m5_dir,  m5_lnum,  m5_bld,  m5_swc)
    dash_leg_row(2, "M15", m15_dir, m15_lnum, m15_bld, m15_swc)
    dash_leg_row(3, "H1",  h1_dir,  h1_lnum,  h1_bld,  h1_swc)
    dash_leg_row(4, "H4",  h4_dir,  h4_lnum,  h4_bld,  h4_swc)
    dash_leg_row(5, "D",   d_dir,   d_lnum,   d_bld,   d_swc)
    dash_leg_row(6, "W",   w_dir,   w_lnum,   w_bld,   w_swc)

    // EW columns — only for the selected TF row
    int ew_row = switch i_ew_tf
        "M15" => 2
        "H1"  => 3
        "H4"  => 4
        "D"   => 5
        => 3

    // Fill EW columns for all rows as blank first
    for int r = 1 to 6
        if r != ew_row
            table.cell(dash, 5, r, "",  text_color=#808080, text_size=size.small, text_halign=text.align_center)
            table.cell(dash, 6, r, "",  text_color=#808080, text_size=size.small, text_halign=text.align_center)
            table.cell(dash, 7, r, "",  text_color=#808080, text_size=size.small, text_halign=text.align_center)

    // EW data for selected TF
    string phase_txt = phase_str(ew_phase)
    string cnt_txt = (ew_phase == 1 or ew_phase == 3) ? str.tostring(ew_imp_cnt) : str.tostring(ew_cor_cnt)
    string ew_txt = phase_txt + " " + cnt_txt
    color  ew_clr = (ew_phase == 1 or ew_phase == 4) ? #26A69A : (ew_phase == 3 or ew_phase == 2) ? #EF5350 : #808080
    table.cell(dash, 5, ew_row, ew_txt,           text_color=ew_clr, text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 6, ew_row, pat_str(ew_pattern), text_color=pat_clr(ew_pattern), text_size=size.small, text_halign=text.align_center)

    // Exhaustion meter
    string exh_txt = str.tostring(ew_imp_cnt) + "/" + str.tostring(ew_threshold)
    color  exh_clr = ew_exhaust_pct >= 1.0 ? #EF5350 : ew_exhaust_pct >= 0.8 ? #FF9800 : ew_exhaust_pct >= 0.6 ? #FFCA28 : #26A69A
    table.cell(dash, 7, ew_row, exh_txt,          text_color=exh_clr, text_size=size.small, text_halign=text.align_center)

    // Summary row
    table.cell(dash, 0, 7, "EW",         text_color=#AAAAAA, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 1, 7, i_ew_tf,      text_color=#CCCCCC, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 2, 7, phase_txt,    text_color=ew_clr,  text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 3, 7, pat_str(ew_pattern), text_color=pat_clr(ew_pattern), text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 4, 7, exh_txt,      text_color=exh_clr, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)

    // Fib projections summary
    string fib_txt = ""
    if ew_phase == 1
        if not na(ew_b_w3_top) and not na(ew_b_w2_bot)
            float r = (ew_b_w3_top - ew_b_w2_bot) / math.max(ew_b_w1_top - ew_b_w1_bot, syminfo.mintick)
            fib_txt := "W3=" + str.tostring(r, "#.##") + "x"
    else if ew_phase == 3
        if not na(ew_s_w3_bot) and not na(ew_s_w2_top)
            float r = (ew_s_w2_top - ew_s_w3_bot) / math.max(ew_s_w1_top - ew_s_w1_bot, syminfo.mintick)
            fib_txt := "W3=" + str.tostring(r, "#.##") + "x"
    table.cell(dash, 5, 7, fib_txt,      text_color=#42A5F5, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 6, 7, "",           text_color=#808080, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 7, 7, "",           text_color=#808080, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
