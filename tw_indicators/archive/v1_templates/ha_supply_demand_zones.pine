//@version=6
indicator("HA Supply/Demand Zones", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// =============================================================================
// TYPES
// =============================================================================

type Zone
    float   top
    float   bottom
    bool    is_supply
    int     created_bar
    box     bx

// =============================================================================
// INPUTS
// =============================================================================

string GRP_ZONE  = "Zone Settings"
float  i_doji    = input.float(5.0, "Doji Body %", group = GRP_ZONE, minval = 0.1, maxval = 50.0, tooltip = "Max body/range % to classify as doji candle")

string GRP_TF    = "Timeframes"
bool   i_tf0_on  = input.bool(false, "M1",     group = GRP_TF, inline = "t0")
string i_tf0     = input.timeframe("1",   "",  group = GRP_TF, inline = "t0")
bool   i_tf1_on  = input.bool(false, "M5",     group = GRP_TF, inline = "t1")
string i_tf1     = input.timeframe("5",   "",  group = GRP_TF, inline = "t1")
bool   i_tf2_on  = input.bool(false, "M15",    group = GRP_TF, inline = "t2")
string i_tf2     = input.timeframe("15",  "",  group = GRP_TF, inline = "t2")
bool   i_tf3_on  = input.bool(true,  "H1",     group = GRP_TF, inline = "t3")
string i_tf3     = input.timeframe("60",  "",  group = GRP_TF, inline = "t3")
bool   i_tf4_on  = input.bool(false, "H4",     group = GRP_TF, inline = "t4")
string i_tf4     = input.timeframe("240", "",  group = GRP_TF, inline = "t4")
bool   i_tf5_on  = input.bool(false, "D",      group = GRP_TF, inline = "t5")
string i_tf5     = input.timeframe("1D",  "",  group = GRP_TF, inline = "t5")
bool   i_tf6_on  = input.bool(false, "W",      group = GRP_TF, inline = "t6")
string i_tf6     = input.timeframe("1W",  "",  group = GRP_TF, inline = "t6")
bool   i_tf7_on  = input.bool(false, "MN",     group = GRP_TF, inline = "t7")
string i_tf7     = input.timeframe("1M",  "",  group = GRP_TF, inline = "t7")

string GRP_AGE   = "Zone Age (max bars per TF)"
int    i_age_m1  = input.int(50, "M1",  group = GRP_AGE, minval = 1)
int    i_age_m5  = input.int(50, "M5",  group = GRP_AGE, minval = 1)
int    i_age_m15 = input.int(50, "M15", group = GRP_AGE, minval = 1)
int    i_age_h1  = input.int(50, "H1",  group = GRP_AGE, minval = 1)
int    i_age_h4  = input.int(50, "H4",  group = GRP_AGE, minval = 1)
int    i_age_d   = input.int(50, "D",   group = GRP_AGE, minval = 1)
int    i_age_w   = input.int(30, "W",   group = GRP_AGE, minval = 1)
int    i_age_mn  = input.int(20, "MN",  group = GRP_AGE, minval = 1)

string GRP_CLR   = "Colors"
color  i_sup_bg  = input.color(color.new(#FF4444, 85), "Supply Fill",   group = GRP_CLR)
color  i_sup_br  = input.color(color.new(#FF4444, 20), "Supply Border", group = GRP_CLR)
color  i_dem_bg  = input.color(color.new(#2196F3, 85), "Demand Fill",   group = GRP_CLR)
color  i_dem_br  = input.color(color.new(#2196F3, 20), "Demand Border", group = GRP_CLR)
bool   i_labels  = input.bool(true, "Show Zone Labels", group = GRP_CLR)

string GRP_HL    = "HA Sequence HH / LL Lines"
bool   i_show_hl = input.bool(true,  "Show Sequence HH/LL", group = GRP_HL)
color  i_hh_clr  = input.color(color.new(#FF9800, 0), "HH Color", group = GRP_HL)
color  i_ll_clr  = input.color(color.new(#26C6DA, 0), "LL Color", group = GRP_HL)
bool   i_seq_lbl = input.bool(true, "Show Sequence Labels", group = GRP_HL)

// =============================================================================
// HELPERS
// =============================================================================

// Per-TF max age resolver
tf_max_age(string tf) =>
    int sec = timeframe.in_seconds(tf)
    int out = sec <= 60 ? i_age_m1 : sec <= 300 ? i_age_m5 : sec <= 900 ? i_age_m15 : sec <= 3600 ? i_age_h1 : sec <= 14400 ? i_age_h4 : sec <= 86400 ? i_age_d : sec <= 604800 ? i_age_w : i_age_mn
    out

// Short TF label
tf_label(string tf) =>
    int sec = timeframe.in_seconds(tf)
    string out = sec <= 60 ? "M1" : sec <= 300 ? "M5" : sec <= 900 ? "M15" : sec <= 3600 ? "H1" : sec <= 14400 ? "H4" : sec <= 86400 ? "D" : sec <= 604800 ? "W" : "MN"
    out

// =============================================================================
// HA ZONE DETECTION + SEQUENCE TRACKING
// Runs on raw OHLC via request.security(syminfo.tickerid, ...).
// HA candles computed manually from OHLC; structural pivots use OHLC high/low.
//
// Zone boundaries (Oriz spec):
//   Supply: top = OHLC high (structural extreme), bottom = HA low (order-block edge)
//   Demand: top = HA high (order-block edge), bottom = OHLC low (structural extreme)
//
// Sequence HH/LL use OHLC structural prices.
// Walkback cap: 50 bars.
// =============================================================================

ha_detect(float doji_pct) =>
    // HA candle calculation from raw OHLC
    float haC = (open + high + low + close) / 4.0
    float haO = float(na)
    haO := na(haO[1]) ? (open + close) / 2.0 : (nz(haO[1]) + nz(haC[1])) / 2.0
    float haH = math.max(high, math.max(haO, haC))
    float haL = math.min(low, math.min(haO, haC))

    bool is_blue = haC >= haO
    bool is_red  = haC < haO

    // Max lookback for run scanning (capped to available bars)
    int max_run = math.min(50, bar_index)

    // Sequence tracking state (persists across bars via var)
    var float prev_run_hi   = na
    var float prev_run_lo   = na
    var float seq_hh        = na
    var float seq_ll        = na
    var int   seq_hh_time   = na
    var int   seq_ll_time   = na
    var float  hi1_lvl      = na
    var int    hi1_time     = na
    var string hi1_txt      = ""
    var float  hi2_lvl      = na
    var int    hi2_time     = na
    var string hi2_txt      = ""
    var float  lo1_lvl      = na
    var int    lo1_time     = na
    var string lo1_txt      = ""
    var float  lo2_lvl      = na
    var int    lo2_time     = na
    var string lo2_txt      = ""

    // Outputs
    bool  fire      = false
    float ztop      = 0.0
    float zbot      = 0.0
    bool  is_sup    = false
    int   zt_origin = time

    // DEMAND: red -> blue — a red run just completed
    if is_blue and is_red[1]
        float run_lo_ha   = haL[1]
        float run_lo_ohlc = low[1]
        int   ext_time    = time[1]
        int   k           = 2
        while k < max_run and is_red[k]
            if haL[k] < run_lo_ha
                run_lo_ha := haL[k]
            if low[k] < run_lo_ohlc
                run_lo_ohlc := low[k]
                ext_time    := time[k]
            k += 1

        bool is_new_ll = na(prev_run_lo) or run_lo_ohlc < prev_run_lo
        seq_ll      := run_lo_ohlc
        seq_ll_time := ext_time
        prev_run_lo := run_lo_ohlc

        lo2_lvl  := lo1_lvl
        lo2_time := lo1_time
        lo2_txt  := lo1_txt
        lo1_lvl  := run_lo_ohlc
        lo1_time := ext_time
        lo1_txt  := is_new_ll ? "LL" : "HL"

        float body = math.abs(haC - haO)
        float rng  = haH - haL
        bool  doji = rng > 0.0 and (body / rng * 100.0) < doji_pct

        // ORIZ spec:
        // - bottom = lowest OHLC low of the red run (structural extreme)
        // - top    = HA high of the last red candle before the blue flip (or trigger bar HA high if doji)
        // nz() guards replay/rollback when [1] can be na
        ztop      := doji ? nz(haH, high) : nz(haH[1], high[1])
        zbot      := nz(run_lo_ohlc, low[1])
        zt_origin := nz(ext_time, time[1])
        fire      := true

    // SUPPLY: blue -> red — a blue run just completed
    else if is_red and is_blue[1]
        float run_hi_ha   = haH[1]
        float run_hi_ohlc = high[1]
        int   ext_time    = time[1]
        int   k           = 2
        while k < max_run and is_blue[k]
            if haH[k] > run_hi_ha
                run_hi_ha := haH[k]
            if high[k] > run_hi_ohlc
                run_hi_ohlc := high[k]
                ext_time    := time[k]
            k += 1

        bool is_new_hh = na(prev_run_hi) or run_hi_ohlc > prev_run_hi
        seq_hh      := run_hi_ohlc
        seq_hh_time := ext_time
        prev_run_hi := run_hi_ohlc

        hi2_lvl  := hi1_lvl
        hi2_time := hi1_time
        hi2_txt  := hi1_txt
        hi1_lvl  := run_hi_ohlc
        hi1_time := ext_time
        hi1_txt  := is_new_hh ? "HH" : "LH"

        float body = math.abs(haC - haO)
        float rng  = haH - haL
        bool  doji = rng > 0.0 and (body / rng * 100.0) < doji_pct

        // ORIZ spec:
        // - top    = highest OHLC high of the blue run (structural extreme)
        // - bottom = HA low of the last blue candle before the red flip (or trigger bar HA low if doji)
        // nz() guards replay/rollback when [1] can be na
        ztop      := nz(run_hi_ohlc, high[1])
        zbot      := doji ? nz(haL, low) : nz(haL[1], low[1])
        zt_origin := nz(ext_time, time[1])
        fire      := true
        is_sup    := true

    [fire, ztop, zbot, is_sup, zt_origin, seq_hh, seq_ll, seq_hh_time, seq_ll_time, hi1_lvl, hi1_time, hi1_txt, hi2_lvl, hi2_time, hi2_txt, lo1_lvl, lo1_time, lo1_txt, lo2_lvl, lo2_time, lo2_txt]

// =============================================================================
// ZONE MANAGER METHODS
// =============================================================================

method delete_zone(array<Zone> zones, int idx) =>
    Zone z = zones.get(idx)
    if not na(z.bx)
        box.delete(z.bx)
    zones.remove(idx)

method process(array<Zone> zones, bool fire, float ztop, float zbot, bool is_sup, int z_time, string tf_str) =>
    int tf_ms  = timeframe.in_seconds(tf_str) * 1000
    int max_ms = tf_max_age(tf_str) * tf_ms

    if zones.size() > 0
        for i = zones.size() - 1 to 0
            Zone z = zones.get(i)
            bool expired = (time - z.created_bar) > max_ms
            if expired
                zones.delete_zone(i)
                continue
            bool broken = z.is_supply ? (high > z.top) : (low < z.bottom)
            if broken
                zones.delete_zone(i)

    // Only create box when values are valid (avoids replay/rollback na)
    bool valid = not na(ztop) and not na(zbot) and not na(z_time) and ztop > zbot
    if fire and (time - z_time) < max_ms and valid
        string lbl_txt = i_labels ? tf_label(tf_str) + (is_sup ? " S" : " D") : na
        color  bg_clr  = is_sup ? i_sup_bg : i_dem_bg
        color  br_clr  = is_sup ? i_sup_br : i_dem_br
        color  tx_clr  = is_sup ? color.new(#FF4444, 0) : color.new(#2196F3, 0)
        box new_box    = box.new(z_time, ztop, z_time + tf_ms * 6, zbot, xloc = xloc.bar_time, extend = extend.right, bgcolor = bg_clr, border_color = br_clr, border_width = 1, text = lbl_txt, text_size = size.tiny, text_color = tx_clr, text_halign = text.align_right, text_valign = text.align_top)
        zones.push(Zone.new(ztop, zbot, is_sup, z_time, new_box))

// =============================================================================
// HH/LL LINE HELPER (display only)
// =============================================================================

update_hl_line(line ln, float lvl, int origin, color clr) =>
    if na(lvl) or na(origin)
        ln
    else if na(ln)
        line.new(origin, lvl, time, lvl, xloc = xloc.bar_time, extend = extend.right, color = clr, style = line.style_dashed, width = 1)
    else
        ln.set_y1(lvl)
        ln.set_y2(lvl)
        ln.set_x1(origin)
        ln.set_x2(time)
        ln

// =============================================================================
// SEQUENCE LABEL HELPER (display only)
// =============================================================================

update_seq_label(label lbl, float lvl, int origin, string txt, string prefix, color clr, bool above) =>
    if na(lvl) or na(origin) or txt == ""
        lbl
    else
        string full = prefix + " " + txt
        if na(lbl)
            label.new(origin, lvl, full, xloc = xloc.bar_time, style = above ? label.style_label_down : label.style_label_up, color = color.new(color.white, 100), textcolor = clr, size = size.tiny)
        else
            lbl.set_y(lvl)
            lbl.set_x(origin)
            lbl.set_text(full)
            lbl.set_textcolor(clr)
            lbl

// =============================================================================
// DATA REQUESTS — 8 calls on raw OHLC (standard ticker)
// HA computed inside ha_detect(); structural pivots use OHLC high/low.
// calc_bars_count limits historical buffer to avoid memory limits exceeded.
// =============================================================================

string _base_sym = ticker.standard(syminfo.tickerid)

[f0_raw, zt0, zb0, s0, tm0, hh0, ll0, hht0, llt0, h1v0, h1t0, h1s0, h2v0, h2t0, h2s0, l1v0, l1t0, l1s0, l2v0, l2t0, l2s0] = request.security(_base_sym, i_tf0, ha_detect(i_doji), calc_bars_count = 500)
[f1_raw, zt1, zb1, s1, tm1, hh1, ll1, hht1, llt1, h1v1, h1t1, h1s1, h2v1, h2t1, h2s1, l1v1, l1t1, l1s1, l2v1, l2t1, l2s1] = request.security(_base_sym, i_tf1, ha_detect(i_doji), calc_bars_count = 500)
[f2_raw, zt2, zb2, s2, tm2, hh2, ll2, hht2, llt2, h1v2, h1t2, h1s2, h2v2, h2t2, h2s2, l1v2, l1t2, l1s2, l2v2, l2t2, l2s2] = request.security(_base_sym, i_tf2, ha_detect(i_doji), calc_bars_count = 500)
[f3_raw, zt3, zb3, s3, tm3, hh3, ll3, hht3, llt3, h1v3, h1t3, h1s3, h2v3, h2t3, h2s3, l1v3, l1t3, l1s3, l2v3, l2t3, l2s3] = request.security(_base_sym, i_tf3, ha_detect(i_doji), calc_bars_count = 500)
[f4_raw, zt4, zb4, s4, tm4, hh4, ll4, hht4, llt4, h1v4, h1t4, h1s4, h2v4, h2t4, h2s4, l1v4, l1t4, l1s4, l2v4, l2t4, l2s4] = request.security(_base_sym, i_tf4, ha_detect(i_doji), calc_bars_count = 500)
[f5_raw, zt5, zb5, s5, tm5, hh5, ll5, hht5, llt5, h1v5, h1t5, h1s5, h2v5, h2t5, h2s5, l1v5, l1t5, l1s5, l2v5, l2t5, l2s5] = request.security(_base_sym, i_tf5, ha_detect(i_doji), calc_bars_count = 500)
[f6_raw, zt6, zb6, s6, tm6, hh6, ll6, hht6, llt6, h1v6, h1t6, h1s6, h2v6, h2t6, h2s6, l1v6, l1t6, l1s6, l2v6, l2t6, l2s6] = request.security(_base_sym, i_tf6, ha_detect(i_doji), calc_bars_count = 500)
[f7_raw, zt7, zb7, s7, tm7, hh7, ll7, hht7, llt7, h1v7, h1t7, h1s7, h2v7, h2t7, h2s7, l1v7, l1t7, l1s7, l2v7, l2t7, l2s7] = request.security(_base_sym, i_tf7, ha_detect(i_doji), calc_bars_count = 500)

// Edge-detect: fire only once per HTF event
bool f0 = f0_raw and not f0_raw[1]
bool f1 = f1_raw and not f1_raw[1]
bool f2 = f2_raw and not f2_raw[1]
bool f3 = f3_raw and not f3_raw[1]
bool f4 = f4_raw and not f4_raw[1]
bool f5 = f5_raw and not f5_raw[1]
bool f6 = f6_raw and not f6_raw[1]
bool f7 = f7_raw and not f7_raw[1]

// =============================================================================
// ZONE ARRAYS
// =============================================================================

var array<Zone> zones0 = array.new<Zone>()
var array<Zone> zones1 = array.new<Zone>()
var array<Zone> zones2 = array.new<Zone>()
var array<Zone> zones3 = array.new<Zone>()
var array<Zone> zones4 = array.new<Zone>()
var array<Zone> zones5 = array.new<Zone>()
var array<Zone> zones6 = array.new<Zone>()
var array<Zone> zones7 = array.new<Zone>()

// =============================================================================
// EXECUTION
// =============================================================================

if i_tf0_on
    zones0.process(f0, zt0, zb0, s0, tm0, i_tf0)

if i_tf1_on
    zones1.process(f1, zt1, zb1, s1, tm1, i_tf1)

if i_tf2_on
    zones2.process(f2, zt2, zb2, s2, tm2, i_tf2)

if i_tf3_on
    zones3.process(f3, zt3, zb3, s3, tm3, i_tf3)

if i_tf4_on
    zones4.process(f4, zt4, zb4, s4, tm4, i_tf4)

if i_tf5_on
    zones5.process(f5, zt5, zb5, s5, tm5, i_tf5)

if i_tf6_on
    zones6.process(f6, zt6, zb6, s6, tm6, i_tf6)

if i_tf7_on
    zones7.process(f7, zt7, zb7, s7, tm7, i_tf7)

// =============================================================================
// HA SEQUENCE HH / LL LINES — OHLC structural pivots
// =============================================================================

var line ln_hh0 = na, var line ln_ll0 = na
var line ln_hh1 = na, var line ln_ll1 = na
var line ln_hh2 = na, var line ln_ll2 = na
var line ln_hh3 = na, var line ln_ll3 = na
var line ln_hh4 = na, var line ln_ll4 = na
var line ln_hh5 = na, var line ln_ll5 = na
var line ln_hh6 = na, var line ln_ll6 = na
var line ln_hh7 = na, var line ln_ll7 = na

var label lb_h10 = na, var label lb_h20 = na, var label lb_l10 = na, var label lb_l20 = na
var label lb_h11 = na, var label lb_h21 = na, var label lb_l11 = na, var label lb_l21 = na
var label lb_h12 = na, var label lb_h22 = na, var label lb_l12 = na, var label lb_l22 = na
var label lb_h13 = na, var label lb_h23 = na, var label lb_l13 = na, var label lb_l23 = na
var label lb_h14 = na, var label lb_h24 = na, var label lb_l14 = na, var label lb_l24 = na
var label lb_h15 = na, var label lb_h25 = na, var label lb_l15 = na, var label lb_l25 = na
var label lb_h16 = na, var label lb_h26 = na, var label lb_l16 = na, var label lb_l26 = na
var label lb_h17 = na, var label lb_h27 = na, var label lb_l17 = na, var label lb_l27 = na

if i_show_hl
    if i_tf0_on
        ln_hh0 := update_hl_line(ln_hh0, hh0, hht0, i_hh_clr)
        ln_ll0 := update_hl_line(ln_ll0, ll0, llt0, i_ll_clr)
    if i_tf1_on
        ln_hh1 := update_hl_line(ln_hh1, hh1, hht1, i_hh_clr)
        ln_ll1 := update_hl_line(ln_ll1, ll1, llt1, i_ll_clr)
    if i_tf2_on
        ln_hh2 := update_hl_line(ln_hh2, hh2, hht2, i_hh_clr)
        ln_ll2 := update_hl_line(ln_ll2, ll2, llt2, i_ll_clr)
    if i_tf3_on
        ln_hh3 := update_hl_line(ln_hh3, hh3, hht3, i_hh_clr)
        ln_ll3 := update_hl_line(ln_ll3, ll3, llt3, i_ll_clr)
    if i_tf4_on
        ln_hh4 := update_hl_line(ln_hh4, hh4, hht4, i_hh_clr)
        ln_ll4 := update_hl_line(ln_ll4, ll4, llt4, i_ll_clr)
    if i_tf5_on
        ln_hh5 := update_hl_line(ln_hh5, hh5, hht5, i_hh_clr)
        ln_ll5 := update_hl_line(ln_ll5, ll5, llt5, i_ll_clr)
    if i_tf6_on
        ln_hh6 := update_hl_line(ln_hh6, hh6, hht6, i_hh_clr)
        ln_ll6 := update_hl_line(ln_ll6, ll6, llt6, i_ll_clr)
    if i_tf7_on
        ln_hh7 := update_hl_line(ln_hh7, hh7, hht7, i_hh_clr)
        ln_ll7 := update_hl_line(ln_ll7, ll7, llt7, i_ll_clr)

// =============================================================================
// HA SEQUENCE LABELS — last 2 highs + last 2 lows per enabled TF
// =============================================================================

if i_seq_lbl
    if i_tf0_on
        lb_h10 := update_seq_label(lb_h10, h1v0, h1t0, h1s0, tf_label(i_tf0), i_hh_clr, true)
        lb_h20 := update_seq_label(lb_h20, h2v0, h2t0, h2s0, tf_label(i_tf0), i_hh_clr, true)
        lb_l10 := update_seq_label(lb_l10, l1v0, l1t0, l1s0, tf_label(i_tf0), i_ll_clr, false)
        lb_l20 := update_seq_label(lb_l20, l2v0, l2t0, l2s0, tf_label(i_tf0), i_ll_clr, false)
    if i_tf1_on
        lb_h11 := update_seq_label(lb_h11, h1v1, h1t1, h1s1, tf_label(i_tf1), i_hh_clr, true)
        lb_h21 := update_seq_label(lb_h21, h2v1, h2t1, h2s1, tf_label(i_tf1), i_hh_clr, true)
        lb_l11 := update_seq_label(lb_l11, l1v1, l1t1, l1s1, tf_label(i_tf1), i_ll_clr, false)
        lb_l21 := update_seq_label(lb_l21, l2v1, l2t1, l2s1, tf_label(i_tf1), i_ll_clr, false)
    if i_tf2_on
        lb_h12 := update_seq_label(lb_h12, h1v2, h1t2, h1s2, tf_label(i_tf2), i_hh_clr, true)
        lb_h22 := update_seq_label(lb_h22, h2v2, h2t2, h2s2, tf_label(i_tf2), i_hh_clr, true)
        lb_l12 := update_seq_label(lb_l12, l1v2, l1t2, l1s2, tf_label(i_tf2), i_ll_clr, false)
        lb_l22 := update_seq_label(lb_l22, l2v2, l2t2, l2s2, tf_label(i_tf2), i_ll_clr, false)
    if i_tf3_on
