//@version=6
indicator("Iora Structure Levels", overlay = true, max_lines_count = 44, max_labels_count = 44)

// =============================================================================
// Previous closed period high/low: Daily, Weekly, Monthly, Quarterly,
// Half-Year, Yearly. Lines originate from the bar that printed the extreme.
// Broken lines stop at the break candle. Unbroken extend right.
// =============================================================================

// =============================================================================
// INPUTS
// =============================================================================

string GRP = "Levels"
bool   i_m5_on  = input.bool(false, "M5",         group = GRP, inline = "m5")
color  i_m5_clr = input.color(color.new(#78909C, 0), "", group = GRP, inline = "m5")
bool   i_m15_on = input.bool(false, "M15",        group = GRP, inline = "m15")
color  i_m15_clr = input.color(color.new(#90A4AE, 0), "", group = GRP, inline = "m15")
bool   i_m30_on = input.bool(false, "M30",        group = GRP, inline = "m30")
color  i_m30_clr = input.color(color.new(#B0BEC5, 0), "", group = GRP, inline = "m30")
bool   i_h1_on  = input.bool(false, "H1",         group = GRP, inline = "h1")
color  i_h1_clr = input.color(color.new(#CE93D8, 0), "", group = GRP, inline = "h1")
bool   i_h4_on  = input.bool(false, "H4",         group = GRP, inline = "h4")
color  i_h4_clr = input.color(color.new(#BA68C8, 0), "", group = GRP, inline = "h4")
bool   i_dy_on  = input.bool(true, "Daily",       group = GRP, inline = "dy")
color  i_dy_clr = input.color(color.new(#9C27B0, 0), "", group = GRP, inline = "dy")
bool   i_wk_on  = input.bool(true, "Weekly",      group = GRP, inline = "wk")
color  i_wk_clr = input.color(color.new(#2196F3, 0), "", group = GRP, inline = "wk")
bool   i_mn_on  = input.bool(true, "Monthly",     group = GRP, inline = "mn")
color  i_mn_clr = input.color(color.new(#FF9800, 0), "", group = GRP, inline = "mn")
bool   i_qt_on  = input.bool(true, "Quarterly",   group = GRP, inline = "qt")
color  i_qt_clr = input.color(color.new(#4CAF50, 0), "", group = GRP, inline = "qt")
bool   i_hy_on  = input.bool(false, "Half-Year",  group = GRP, inline = "hy")
color  i_hy_clr = input.color(color.new(#E91E63, 0), "", group = GRP, inline = "hy")
bool   i_yr_on  = input.bool(false, "Yearly",     group = GRP, inline = "yr")
color  i_yr_clr = input.color(color.new(#FFD700, 0), "", group = GRP, inline = "yr")
int    i_brk_alpha = input.int(70, "Broken Transparency", minval = 0, maxval = 95, group = GRP)

// =============================================================================
// PERIOD TRACKING + BREAK DETECTION
// Runs on chart TF. Finds exact bar of each extreme.
// Also tracks first break time per level (resets each new period).
// =============================================================================

track_period(string tf) =>
    bool new_period = ta.change(time(tf)) != 0

    var float cur_hi   = na
    var int   cur_hi_t = na
    var float cur_lo   = na
    var int   cur_lo_t = na
    var float prev_hi   = na
    var int   prev_hi_t = na
    var float prev_lo   = na
    var int   prev_lo_t = na
    var int   hi_brk_t  = na
    var int   lo_brk_t  = na

    if new_period
        prev_hi   := cur_hi
        prev_hi_t := cur_hi_t
        prev_lo   := cur_lo
        prev_lo_t := cur_lo_t
        cur_hi    := high
        cur_hi_t  := time
        cur_lo    := low
        cur_lo_t  := time
        hi_brk_t  := na
        lo_brk_t  := na
    else
        if high >= nz(cur_hi)
            cur_hi   := high
            cur_hi_t := time
        if low <= nz(cur_lo, 1e18)
            cur_lo   := low
            cur_lo_t := time

    // Detect first break of previous period levels (only after new_period)
    if na(hi_brk_t) and not na(prev_hi) and high > prev_hi
        hi_brk_t := time
    if na(lo_brk_t) and not na(prev_lo) and low < prev_lo
        lo_brk_t := time

    [prev_hi, prev_hi_t, prev_lo, prev_lo_t, hi_brk_t, lo_brk_t]

[m5_hi,  m5_hi_t,  m5_lo,  m5_lo_t,  m5_hi_brk,  m5_lo_brk]  = track_period("5")
[m15_hi, m15_hi_t, m15_lo, m15_lo_t, m15_hi_brk, m15_lo_brk] = track_period("15")
[m30_hi, m30_hi_t, m30_lo, m30_lo_t, m30_hi_brk, m30_lo_brk] = track_period("30")
[h1_hi,  h1_hi_t,  h1_lo,  h1_lo_t,  h1_hi_brk,  h1_lo_brk]  = track_period("60")
[h4_hi,  h4_hi_t,  h4_lo,  h4_lo_t,  h4_hi_brk,  h4_lo_brk]  = track_period("240")
[dy_hi,  dy_hi_t,  dy_lo,  dy_lo_t,  dy_hi_brk,  dy_lo_brk]  = track_period("1D")
[wk_hi,  wk_hi_t,  wk_lo,  wk_lo_t,  wk_hi_brk,  wk_lo_brk]  = track_period("1W")
[mn_hi,  mn_hi_t,  mn_lo,  mn_lo_t,  mn_hi_brk,  mn_lo_brk]  = track_period("1M")
[qt_hi,  qt_hi_t,  qt_lo,  qt_lo_t,  qt_hi_brk,  qt_lo_brk]  = track_period("3M")
[hy_hi,  hy_hi_t,  hy_lo,  hy_lo_t,  hy_hi_brk,  hy_lo_brk]  = track_period("6M")
[yr_hi,  yr_hi_t,  yr_lo,  yr_lo_t,  yr_hi_brk,  yr_lo_brk]  = track_period("12M")

// =============================================================================
// DRAWING — broken lines: dashed, faded, stop at break candle.
//           unbroken lines: solid, extend right.
//           Labels sit along the line at fractional position.
// =============================================================================

draw_level(line ln, label lbl, float lvl, int origin, int brk_time, color base_clr, string txt, bool is_hi, float frac) =>
    if na(lvl) or na(origin)
        [ln, lbl]
    else
        bool   broken = not na(brk_time)
        color  clr    = base_clr
        int    wid    = 2
        string stl    = line.style_solid
        string full   = txt + (broken ? " ✗" : "")
        int    x2     = broken ? brk_time : time
        string ext    = broken ? extend.none : extend.right
        int    lx     = int(origin + (x2 - origin) * frac)
        string lsty   = is_hi ? label.style_label_down : label.style_label_up
        if na(ln)
            line  new_ln  = line.new(origin, lvl, x2, lvl, xloc = xloc.bar_time, extend = ext, color = clr, style = stl, width = wid)
            label new_lbl = label.new(lx, lvl, full, xloc = xloc.bar_time, style = lsty, color = color.new(color.white, 100), textcolor = clr, size = size.tiny)
            [new_ln, new_lbl]
        else
            ln.set_x1(origin)
            ln.set_y1(lvl)
            ln.set_x2(x2)
            ln.set_y2(lvl)
            ln.set_color(clr)
            ln.set_width(wid)
            ln.set_style(stl)
            ln.set_extend(ext)
            lbl.set_x(lx)
            lbl.set_y(lvl)
            lbl.set_text(full)
            lbl.set_textcolor(clr)
            lbl.set_style(lsty)
            [ln, lbl]

// =============================================================================
// LINE + LABEL STATE
// =============================================================================

var line ln_m5_hi  = na, var label lb_m5_hi  = na
var line ln_m5_lo  = na, var label lb_m5_lo  = na
var line ln_m15_hi = na, var label lb_m15_hi = na
var line ln_m15_lo = na, var label lb_m15_lo = na
var line ln_m30_hi = na, var label lb_m30_hi = na
var line ln_m30_lo = na, var label lb_m30_lo = na
var line ln_h1_hi  = na, var label lb_h1_hi  = na
var line ln_h1_lo  = na, var label lb_h1_lo  = na
var line ln_h4_hi  = na, var label lb_h4_hi  = na
var line ln_h4_lo  = na, var label lb_h4_lo  = na
var line ln_dy_hi  = na, var label lb_dy_hi  = na
var line ln_dy_lo  = na, var label lb_dy_lo  = na
var line ln_wk_hi = na, var label lb_wk_hi = na
var line ln_wk_lo = na, var label lb_wk_lo = na
var line ln_mn_hi = na, var label lb_mn_hi = na
var line ln_mn_lo = na, var label lb_mn_lo = na
var line ln_qt_hi = na, var label lb_qt_hi = na
var line ln_qt_lo = na, var label lb_qt_lo = na
var line ln_hy_hi = na, var label lb_hy_hi = na
var line ln_hy_lo = na, var label lb_hy_lo = na
var line ln_yr_hi = na, var label lb_yr_hi = na
var line ln_yr_lo = na, var label lb_yr_lo = na

// =============================================================================
// DRAW — frac staggers labels so different TFs don't overlap
// =============================================================================

if i_m5_on
    [a, b] = draw_level(ln_m5_hi, lb_m5_hi, m5_hi, m5_hi_t, m5_hi_brk, i_m5_clr, "M5 Hi", true, 0.05)
    ln_m5_hi := a
    lb_m5_hi := b
    [c, d] = draw_level(ln_m5_lo, lb_m5_lo, m5_lo, m5_lo_t, m5_lo_brk, i_m5_clr, "M5 Lo", false, 0.05)
    ln_m5_lo := c
    lb_m5_lo := d

if i_m15_on
    [a, b] = draw_level(ln_m15_hi, lb_m15_hi, m15_hi, m15_hi_t, m15_hi_brk, i_m15_clr, "M15 Hi", true, 0.06)
    ln_m15_hi := a
    lb_m15_hi := b
    [c, d] = draw_level(ln_m15_lo, lb_m15_lo, m15_lo, m15_lo_t, m15_lo_brk, i_m15_clr, "M15 Lo", false, 0.06)
    ln_m15_lo := c
    lb_m15_lo := d

if i_m30_on
    [a, b] = draw_level(ln_m30_hi, lb_m30_hi, m30_hi, m30_hi_t, m30_hi_brk, i_m30_clr, "M30 Hi", true, 0.07)
    ln_m30_hi := a
    lb_m30_hi := b
    [c, d] = draw_level(ln_m30_lo, lb_m30_lo, m30_lo, m30_lo_t, m30_lo_brk, i_m30_clr, "M30 Lo", false, 0.07)
    ln_m30_lo := c
    lb_m30_lo := d

if i_h1_on
    [a, b] = draw_level(ln_h1_hi, lb_h1_hi, h1_hi, h1_hi_t, h1_hi_brk, i_h1_clr, "H1 Hi", true, 0.08)
    ln_h1_hi := a
    lb_h1_hi := b
    [c, d] = draw_level(ln_h1_lo, lb_h1_lo, h1_lo, h1_lo_t, h1_lo_brk, i_h1_clr, "H1 Lo", false, 0.08)
    ln_h1_lo := c
    lb_h1_lo := d

if i_h4_on
    [a, b] = draw_level(ln_h4_hi, lb_h4_hi, h4_hi, h4_hi_t, h4_hi_brk, i_h4_clr, "H4 Hi", true, 0.09)
    ln_h4_hi := a
    lb_h4_hi := b
    [c, d] = draw_level(ln_h4_lo, lb_h4_lo, h4_lo, h4_lo_t, h4_lo_brk, i_h4_clr, "H4 Lo", false, 0.09)
    ln_h4_lo := c
    lb_h4_lo := d

if i_dy_on
    [a, b] = draw_level(ln_dy_hi, lb_dy_hi, dy_hi, dy_hi_t, dy_hi_brk, i_dy_clr, "DY Hi", true, 0.10)
    ln_dy_hi := a
    lb_dy_hi := b
    [c, d] = draw_level(ln_dy_lo, lb_dy_lo, dy_lo, dy_lo_t, dy_lo_brk, i_dy_clr, "DY Lo", false, 0.10)
    ln_dy_lo := c
    lb_dy_lo := d

if i_wk_on
    [a, b] = draw_level(ln_wk_hi, lb_wk_hi, wk_hi, wk_hi_t, wk_hi_brk, i_wk_clr, "WK Hi", true, 0.15)
    ln_wk_hi := a
    lb_wk_hi := b
    [c, d] = draw_level(ln_wk_lo, lb_wk_lo, wk_lo, wk_lo_t, wk_lo_brk, i_wk_clr, "WK Lo", false, 0.15)
    ln_wk_lo := c
    lb_wk_lo := d

if i_mn_on
    [a, b] = draw_level(ln_mn_hi, lb_mn_hi, mn_hi, mn_hi_t, mn_hi_brk, i_mn_clr, "MN Hi", true, 0.20)
    ln_mn_hi := a
    lb_mn_hi := b
    [c, d] = draw_level(ln_mn_lo, lb_mn_lo, mn_lo, mn_lo_t, mn_lo_brk, i_mn_clr, "MN Lo", false, 0.20)
    ln_mn_lo := c
    lb_mn_lo := d

if i_qt_on
    [a, b] = draw_level(ln_qt_hi, lb_qt_hi, qt_hi, qt_hi_t, qt_hi_brk, i_qt_clr, "QT Hi", true, 0.25)
    ln_qt_hi := a
    lb_qt_hi := b
    [c, d] = draw_level(ln_qt_lo, lb_qt_lo, qt_lo, qt_lo_t, qt_lo_brk, i_qt_clr, "QT Lo", false, 0.25)
    ln_qt_lo := c
    lb_qt_lo := d

if i_hy_on
    [a, b] = draw_level(ln_hy_hi, lb_hy_hi, hy_hi, hy_hi_t, hy_hi_brk, i_hy_clr, "HY Hi", true, 0.30)
    ln_hy_hi := a
    lb_hy_hi := b
    [c, d] = draw_level(ln_hy_lo, lb_hy_lo, hy_lo, hy_lo_t, hy_lo_brk, i_hy_clr, "HY Lo", false, 0.30)
    ln_hy_lo := c
    lb_hy_lo := d

if i_yr_on
    [a, b] = draw_level(ln_yr_hi, lb_yr_hi, yr_hi, yr_hi_t, yr_hi_brk, i_yr_clr, "YR Hi", true, 0.35)
    ln_yr_hi := a
    lb_yr_hi := b
    [c, d] = draw_level(ln_yr_lo, lb_yr_lo, yr_lo, yr_lo_t, yr_lo_brk, i_yr_clr, "YR Lo", false, 0.35)
    ln_yr_lo := c
    lb_yr_lo := d
