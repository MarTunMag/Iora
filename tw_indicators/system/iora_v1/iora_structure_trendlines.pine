//@version=6
indicator("Iora Structure Trendlines", overlay = true, max_lines_count = 500, max_labels_count = 500, calc_bars_count = 5000)

// =============================================================================
// S1 — TYPES
// =============================================================================

type StructTrend
    // Swing high pivots (for descending TL: LH → draw, HH → break)
    float   hi1_p       = na      // most recent swing high price
    int     hi1_t       = na      // most recent swing high time
    float   hi2_p       = na      // previous swing high price
    int     hi2_t       = na      // previous swing high time
    int     hi1_class   = 0       // 1 = HH, 2 = LH
    float   prev_sup    = na      // previous supply top for classification
    // Swing low pivots (for ascending TL: HL → draw, LL → break)
    float   lo1_p       = na
    int     lo1_t       = na
    float   lo2_p       = na
    int     lo2_t       = na
    int     lo1_class   = 0       // 3 = HL, 4 = LL
    float   prev_dem    = na      // previous demand bottom for classification
    // Active trendlines
    line    desc_ln     = na      // descending (through swing highs)
    line    asc_ln      = na      // ascending (through swing lows)
    // Broken trendlines (kept for one cycle)
    line    broken_desc = na
    line    broken_asc  = na
    // Labels
    label   desc_lbl    = na
    label   asc_lbl     = na

// =============================================================================
// S2 — INPUTS
// =============================================================================

string GRP_TF  = "Timeframes"
bool   i_mn_on  = input.bool(false, "Monthly",  group = GRP_TF, tooltip = "Chart TF must be lower than selected TF")
bool   i_wk_on  = input.bool(false, "Weekly",   group = GRP_TF)
bool   i_dy_on  = input.bool(true,  "Daily",    group = GRP_TF)
bool   i_h4_on  = input.bool(true,  "H4",       group = GRP_TF)
bool   i_h1_on  = input.bool(true,  "H1",       group = GRP_TF)
bool   i_m15_on = input.bool(false, "M15",      group = GRP_TF)
bool   i_m5_on  = input.bool(false, "M5",       group = GRP_TF)

string GRP_CLR  = "Colors"
color  i_mn_clr  = input.color(#FFD600, "Monthly", group = GRP_CLR)
color  i_wk_clr  = input.color(#FF6D00, "Weekly",  group = GRP_CLR)
color  i_dy_clr  = input.color(#FFFFFF, "Daily",   group = GRP_CLR)
color  i_h4_clr  = input.color(#26C6DA, "H4",      group = GRP_CLR)
color  i_h1_clr  = input.color(#66BB6A, "H1",      group = GRP_CLR)
color  i_m15_clr = input.color(#AB47BC, "M15",     group = GRP_CLR)
color  i_m5_clr  = input.color(#EF5350, "M5",      group = GRP_CLR)

string GRP_STY   = "Style"
color  i_brk_clr  = input.color(color.new(#9E9E9E, 40), "Broken Line Color",     group = GRP_STY)
int    i_ext_w    = input.int(3, "External Line Width",  group = GRP_STY, minval = 1, maxval = 5)
int    i_int_w    = input.int(1, "Internal Line Width",  group = GRP_STY, minval = 1, maxval = 3)
float  i_doji_pct = input.float(5.0, "Doji Body %",     group = GRP_STY, minval = 1.0, maxval = 20.0)

string GRP_IE  = "Internal / External"
string i_ie_mode = input.string("Auto (TF cascade)", "Pairing Mode", 
     options = ["Auto (TF cascade)", "All Internal", "All External"], 
     group = GRP_IE, 
     tooltip = "Auto: lower TF in each adjacent pair = internal, upper = external.\nAll Internal/External: force all TFs to one style.")

// =============================================================================
// S3 — HELPERS
// =============================================================================

tf_label(string tf) =>
    switch tf
        "1M"  => "MN"
        "1W"  => "W"
        "1D"  => "D"
        "240" => "H4"
        "60"  => "H1"
        "15"  => "M15"
        "5"   => "M5"
        => tf

// Determine if a TF is internal or external in the cascade
// TF cascade: M5 → M15 → H1 → H4 → D → W → MN
// Internal = lower TF (sub-swings), External = upper TF (structural swings)
is_external_tf(string tf) =>
    if i_ie_mode == "All Internal"
        false
    else if i_ie_mode == "All External"
        true
    else
        // Auto mode: a TF is external if the next lower TF in cascade is also enabled
        switch tf
            "1M"  => i_wk_on or i_dy_on or i_h4_on or i_h1_on or i_m15_on or i_m5_on
            "1W"  => i_dy_on or i_h4_on or i_h1_on or i_m15_on or i_m5_on
            "1D"  => i_h4_on or i_h1_on or i_m15_on or i_m5_on
            "240" => i_h1_on or i_m15_on or i_m5_on
            "60"  => i_m15_on or i_m5_on
            "15"  => i_m5_on
            "5"   => false  // M5 is always internal (lowest)
            => false

// =============================================================================
// S4 — ZONE-BASED SWING DETECTION
// =============================================================================
// Detects HA color transitions (zone creation events) and returns the
// OHLC swing extreme of the completed run.
// Supply transition (blue→red): swing high = highest OHLC high in blue run
// Demand transition (red→blue): swing low  = lowest OHLC low in red run
// =============================================================================

zone_swings() =>
    // HA calculation on OHLC data
    float haC = (open + high + low + close) / 4.0
    float haO = na
    haO := na(haO[1]) ? (open + close) / 2.0 : (nz(haO[1]) + nz(haC[1])) / 2.0

    // Doji detection: if body is tiny relative to range, treat as continuation
    float body = math.abs(haC - haO)
    float rng  = high - low
    bool  is_doji = rng > 0 ? (body / rng * 100.0) < i_doji_pct : true

    // HA color: blue = bullish, red = bearish (dojis inherit previous color)
    bool raw_blue = haC >= haO
    bool raw_red  = haC < haO
    var bool is_blue = true
    var bool is_red  = false
    if not is_doji
        is_blue := raw_blue
        is_red  := raw_red

    // Track run extremes using OHLC prices
    var float run_hi   = na    // highest OHLC high during current blue run
    var int   run_hi_t = na    // time of that bar
    var float run_lo   = na    // lowest OHLC low during current red run
    var int   run_lo_t = na    // time of that bar

    // Blue run tracking
    if is_blue
        if is_red[1] or na(run_hi)
            // First blue bar after red run (or very first bar) → reset blue tracking
            run_hi   := high
            run_hi_t := time
        else
            if high >= run_hi
                run_hi   := high
                run_hi_t := time

    // Red run tracking
    if is_red
        if is_blue[1] or na(run_lo)
            // First red bar after blue run (or very first bar) → reset red tracking
            run_lo   := low
            run_lo_t := time
        else
            if low <= run_lo
                run_lo   := low
                run_lo_t := time

    // Transition detection
    bool supply_fire = is_red and is_blue[1]   // blue → red = supply zone = swing high complete
    bool demand_fire = is_blue and is_red[1]   // red → blue = demand zone = swing low complete

    // Persistent step-function outputs: value changes only on transition,
    // stays constant between transitions. This makes ta.change() on the
    // chart TF fire exactly once per swing event.
    var float last_shi   = na
    var int   last_shi_t = na
    var float last_dlo   = na
    var int   last_dlo_t = na

    if supply_fire
        // Blue run completed → swing high = run's highest OHLC high
        // run_hi still holds the blue run max (red tracking reset run_lo, not run_hi)
        last_shi   := run_hi
        last_shi_t := run_hi_t

    if demand_fire
        // Red run completed → swing low = run's lowest OHLC low
        // run_lo still holds the red run min (blue tracking reset run_hi, not run_lo)
        last_dlo   := run_lo
        last_dlo_t := run_lo_t

    [last_shi, last_shi_t, last_dlo, last_dlo_t]

// =============================================================================
// S5 — DATA REQUESTS (7 TFs)
// =============================================================================

[mn_shi, mn_shi_t, mn_dlo, mn_dlo_t] = request.security(syminfo.tickerid, "1M",  zone_swings(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[wk_shi, wk_shi_t, wk_dlo, wk_dlo_t] = request.security(syminfo.tickerid, "1W",  zone_swings(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[dy_shi, dy_shi_t, dy_dlo, dy_dlo_t] = request.security(syminfo.tickerid, "1D",  zone_swings(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[h4_shi, h4_shi_t, h4_dlo, h4_dlo_t] = request.security(syminfo.tickerid, "240", zone_swings(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[h1_shi, h1_shi_t, h1_dlo, h1_dlo_t] = request.security(syminfo.tickerid, "60",  zone_swings(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[m15_shi, m15_shi_t, m15_dlo, m15_dlo_t] = request.security(syminfo.tickerid, "15", zone_swings(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[m5_shi, m5_shi_t, m5_dlo, m5_dlo_t] = request.security(syminfo.tickerid, "5",   zone_swings(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// =============================================================================
// S6 — CHART TF GUARD
// =============================================================================
// Skip TFs at or below the chart TF (can't see higher-TF structure on same TF)

int chart_s = timeframe.in_seconds()
bool mn_ok  = timeframe.in_seconds("1M")  > chart_s
bool wk_ok  = timeframe.in_seconds("1W")  > chart_s
bool dy_ok  = timeframe.in_seconds("1D")  > chart_s
bool h4_ok  = timeframe.in_seconds("240") > chart_s
bool h1_ok  = timeframe.in_seconds("60")  > chart_s
bool m15_ok = timeframe.in_seconds("15")  > chart_s
bool m5_ok  = timeframe.in_seconds("5")   > chart_s

// =============================================================================
// S7 — EDGE DETECTION
// =============================================================================
// HTF swing events arrive as step functions through request.security.
// Edge detection ensures each swing fires only once on the chart TF.
// Uses direct comparison (not ta.change) to handle na→value transitions.
// =============================================================================

// Supply swing highs: new swing = value is non-na AND differs from previous bar
bool mn_shi_new  = not na(mn_shi)  and (na(mn_shi[1])  or mn_shi  != mn_shi[1])
bool wk_shi_new  = not na(wk_shi)  and (na(wk_shi[1])  or wk_shi  != wk_shi[1])
bool dy_shi_new  = not na(dy_shi)  and (na(dy_shi[1])  or dy_shi  != dy_shi[1])
bool h4_shi_new  = not na(h4_shi)  and (na(h4_shi[1])  or h4_shi  != h4_shi[1])
bool h1_shi_new  = not na(h1_shi)  and (na(h1_shi[1])  or h1_shi  != h1_shi[1])
bool m15_shi_new = not na(m15_shi) and (na(m15_shi[1]) or m15_shi != m15_shi[1])
bool m5_shi_new  = not na(m5_shi)  and (na(m5_shi[1])  or m5_shi  != m5_shi[1])

// Demand swing lows: same pattern
bool mn_dlo_new  = not na(mn_dlo)  and (na(mn_dlo[1])  or mn_dlo  != mn_dlo[1])
bool wk_dlo_new  = not na(wk_dlo)  and (na(wk_dlo[1])  or wk_dlo  != wk_dlo[1])
bool dy_dlo_new  = not na(dy_dlo)  and (na(dy_dlo[1])  or dy_dlo  != dy_dlo[1])
bool h4_dlo_new  = not na(h4_dlo)  and (na(h4_dlo[1])  or h4_dlo  != h4_dlo[1])
bool h1_dlo_new  = not na(h1_dlo)  and (na(h1_dlo[1])  or h1_dlo  != h1_dlo[1])
bool m15_dlo_new = not na(m15_dlo) and (na(m15_dlo[1]) or m15_dlo != m15_dlo[1])
bool m5_dlo_new  = not na(m5_dlo)  and (na(m5_dlo[1])  or m5_dlo  != m5_dlo[1])

// Gate price and time through edge booleans
float mn_shi_edge  = mn_shi_new  ? mn_shi  : na
float wk_shi_edge  = wk_shi_new  ? wk_shi  : na
float dy_shi_edge  = dy_shi_new  ? dy_shi  : na
float h4_shi_edge  = h4_shi_new  ? h4_shi  : na
float h1_shi_edge  = h1_shi_new  ? h1_shi  : na
float m15_shi_edge = m15_shi_new ? m15_shi : na
float m5_shi_edge  = m5_shi_new  ? m5_shi  : na

float mn_dlo_edge  = mn_dlo_new  ? mn_dlo  : na
float wk_dlo_edge  = wk_dlo_new  ? wk_dlo  : na
float dy_dlo_edge  = dy_dlo_new  ? dy_dlo  : na
float h4_dlo_edge  = h4_dlo_new  ? h4_dlo  : na
float h1_dlo_edge  = h1_dlo_new  ? h1_dlo  : na
float m15_dlo_edge = m15_dlo_new ? m15_dlo : na
float m5_dlo_edge  = m5_dlo_new  ? m5_dlo  : na

// Swing high times (edge-gated)
int mn_shi_t_e  = mn_shi_new  ? mn_shi_t  : na
int wk_shi_t_e  = wk_shi_new  ? wk_shi_t  : na
int dy_shi_t_e  = dy_shi_new  ? dy_shi_t  : na
int h4_shi_t_e  = h4_shi_new  ? h4_shi_t  : na
int h1_shi_t_e  = h1_shi_new  ? h1_shi_t  : na
int m15_shi_t_e = m15_shi_new ? m15_shi_t : na
int m5_shi_t_e  = m5_shi_new  ? m5_shi_t  : na

// Swing low times (edge-gated)
int mn_dlo_t_e  = mn_dlo_new  ? mn_dlo_t  : na
int wk_dlo_t_e  = wk_dlo_new  ? wk_dlo_t  : na
int dy_dlo_t_e  = dy_dlo_new  ? dy_dlo_t  : na
int h4_dlo_t_e  = h4_dlo_new  ? h4_dlo_t  : na
int h1_dlo_t_e  = h1_dlo_new  ? h1_dlo_t  : na
int m15_dlo_t_e = m15_dlo_new ? m15_dlo_t : na
int m5_dlo_t_e  = m5_dlo_new  ? m5_dlo_t  : na

// =============================================================================
// S8 — TRENDLINE UPDATE METHOD
// =============================================================================
// Called when a new swing high or swing low is detected for a TF.
//
// SWING HIGH fires (supply zone / blue→red transition):
//   Classify HH or LH vs previous supply top.
//   LH → draw/update descending TL through last 2 swing highs
//   HH → break descending TL (marks bullish continuation / iBOS or eBOS)
//
// SWING LOW fires (demand zone / red→blue transition):
//   Classify HL or LL vs previous demand bottom.
//   HL → draw/update ascending TL through last 2 swing lows
//   LL → break ascending TL (marks bearish continuation / iBOS or eBOS)
//
// Both ascending + descending active simultaneously = compression / wedge / flag
// =============================================================================

method process_swing_high(StructTrend st, float price, int t, color aClr, color bClr, int lnW, string tfStr, bool isExt) =>
    if not na(price) and not na(t)
        // Classify: HH or LH
        bool is_hh = na(st.prev_sup) ? true : price > st.prev_sup
        st.hi1_class := is_hh ? 1 : 2
        st.prev_sup  := price

        // Shift pivots
        st.hi2_p := st.hi1_p
        st.hi2_t := st.hi1_t
        st.hi1_p := price
        st.hi1_t := t

        string lbl  = tf_label(tfStr)
        string pfx  = isExt ? "e" : "i"
        string cls  = is_hh ? "HH" : "LH"
        bool   ready = not na(st.hi2_p) and not na(st.hi2_t) and st.hi1_t != st.hi2_t

        if ready
            if not is_hh
                // LH → draw/update descending trendline
                if not na(st.desc_ln)
                    line.delete(st.desc_ln)
                if not na(st.desc_lbl)
                    label.delete(st.desc_lbl)
                st.desc_ln  := line.new(st.hi2_t, st.hi2_p, st.hi1_t, st.hi1_p,
                     xloc = xloc.bar_time, extend = extend.right,
                     color = aClr, width = lnW,
                     style = isExt ? line.style_solid : line.style_dashed)
                st.desc_lbl := label.new(st.hi1_t, st.hi1_p, pfx + " " + lbl + " ↘ " + cls,
                     xloc = xloc.bar_time, style = label.style_none,
                     textcolor = aClr, size = size.small)
            else
                // HH → break descending trendline
                if not na(st.desc_ln)
                    int brkW = math.max(lnW - 1, 1)
                    line.set_color(st.desc_ln, bClr)
                    line.set_style(st.desc_ln, line.style_dotted)
                    line.set_width(st.desc_ln, brkW)
                    if not na(st.desc_lbl)
                        label.delete(st.desc_lbl)
                    st.desc_lbl := na
                    if not na(st.broken_desc)
                        line.delete(st.broken_desc)
                    st.broken_desc := st.desc_ln
                    st.desc_ln := na
            true

method process_swing_low(StructTrend st, float price, int t, color aClr, color bClr, int lnW, string tfStr, bool isExt) =>
    if not na(price) and not na(t)
        // Classify: HL or LL
        bool is_ll = na(st.prev_dem) ? true : price < st.prev_dem
        st.lo1_class := is_ll ? 4 : 3
        st.prev_dem  := price

        // Shift pivots
        st.lo2_p := st.lo1_p
        st.lo2_t := st.lo1_t
        st.lo1_p := price
        st.lo1_t := t

        string lbl  = tf_label(tfStr)
        string pfx  = isExt ? "e" : "i"
        string cls  = is_ll ? "LL" : "HL"
        bool   ready = not na(st.lo2_p) and not na(st.lo2_t) and st.lo1_t != st.lo2_t

        if ready
            if not is_ll
                // HL → draw/update ascending trendline
                if not na(st.asc_ln)
                    line.delete(st.asc_ln)
                if not na(st.asc_lbl)
                    label.delete(st.asc_lbl)
                st.asc_ln  := line.new(st.lo2_t, st.lo2_p, st.lo1_t, st.lo1_p,
                     xloc = xloc.bar_time, extend = extend.right,
                     color = aClr, width = lnW,
                     style = isExt ? line.style_solid : line.style_dashed)
                st.asc_lbl := label.new(st.lo1_t, st.lo1_p, pfx + " " + lbl + " ↗ " + cls,
                     xloc = xloc.bar_time, style = label.style_none,
                     textcolor = aClr, size = size.small)
            else
                // LL → break ascending trendline
                if not na(st.asc_ln)
                    int brkW = math.max(lnW - 1, 1)
                    line.set_color(st.asc_ln, bClr)
                    line.set_style(st.asc_ln, line.style_dotted)
                    line.set_width(st.asc_ln, brkW)
                    if not na(st.asc_lbl)
                        label.delete(st.asc_lbl)
                    st.asc_lbl := na
                    if not na(st.broken_asc)
                        line.delete(st.broken_asc)
                    st.broken_asc := st.asc_ln
                    st.asc_ln := na
            true

// =============================================================================
// S9 — STATE INSTANCES + EXECUTION
// =============================================================================

var StructTrend ts_mn  = StructTrend.new()
var StructTrend ts_wk  = StructTrend.new()
var StructTrend ts_dy  = StructTrend.new()
var StructTrend ts_h4  = StructTrend.new()
var StructTrend ts_h1  = StructTrend.new()
var StructTrend ts_m15 = StructTrend.new()
var StructTrend ts_m5  = StructTrend.new()

// Determine internal/external per TF
bool mn_ext  = is_external_tf("1M")
bool wk_ext  = is_external_tf("1W")
bool dy_ext  = is_external_tf("1D")
bool h4_ext  = is_external_tf("240")
bool h1_ext  = is_external_tf("60")
bool m15_ext = is_external_tf("15")
bool m5_ext  = is_external_tf("5")

// Line widths based on internal/external
int mn_w  = mn_ext  ? i_ext_w : i_int_w
int wk_w  = wk_ext  ? i_ext_w : i_int_w
int dy_w  = dy_ext  ? i_ext_w : i_int_w
int h4_w  = h4_ext  ? i_ext_w : i_int_w
int h1_w  = h1_ext  ? i_ext_w : i_int_w
int m15_w = m15_ext ? i_ext_w : i_int_w
int m5_w  = m5_ext  ? i_ext_w : i_int_w

// --- Monthly ---
if i_mn_on and mn_ok
    if not na(mn_shi_edge)
        ts_mn.process_swing_high(mn_shi_edge, mn_shi_t_e, i_mn_clr, i_brk_clr, mn_w, "1M", mn_ext)
    if not na(mn_dlo_edge)
        ts_mn.process_swing_low(mn_dlo_edge, mn_dlo_t_e, i_mn_clr, i_brk_clr, mn_w, "1M", mn_ext)

// --- Weekly ---
if i_wk_on and wk_ok
    if not na(wk_shi_edge)
        ts_wk.process_swing_high(wk_shi_edge, wk_shi_t_e, i_wk_clr, i_brk_clr, wk_w, "1W", wk_ext)
    if not na(wk_dlo_edge)
        ts_wk.process_swing_low(wk_dlo_edge, wk_dlo_t_e, i_wk_clr, i_brk_clr, wk_w, "1W", wk_ext)

// --- Daily ---
if i_dy_on and dy_ok
    if not na(dy_shi_edge)
        ts_dy.process_swing_high(dy_shi_edge, dy_shi_t_e, i_dy_clr, i_brk_clr, dy_w, "1D", dy_ext)
    if not na(dy_dlo_edge)
        ts_dy.process_swing_low(dy_dlo_edge, dy_dlo_t_e, i_dy_clr, i_brk_clr, dy_w, "1D", dy_ext)

// --- H4 ---
if i_h4_on and h4_ok
    if not na(h4_shi_edge)
        ts_h4.process_swing_high(h4_shi_edge, h4_shi_t_e, i_h4_clr, i_brk_clr, h4_w, "240", h4_ext)
    if not na(h4_dlo_edge)
        ts_h4.process_swing_low(h4_dlo_edge, h4_dlo_t_e, i_h4_clr, i_brk_clr, h4_w, "240", h4_ext)

// --- H1 ---
if i_h1_on and h1_ok
    if not na(h1_shi_edge)
        ts_h1.process_swing_high(h1_shi_edge, h1_shi_t_e, i_h1_clr, i_brk_clr, h1_w, "60", h1_ext)
    if not na(h1_dlo_edge)
        ts_h1.process_swing_low(h1_dlo_edge, h1_dlo_t_e, i_h1_clr, i_brk_clr, h1_w, "60", h1_ext)

// --- M15 ---
if i_m15_on and m15_ok
    if not na(m15_shi_edge)
        ts_m15.process_swing_high(m15_shi_edge, m15_shi_t_e, i_m15_clr, i_brk_clr, m15_w, "15", m15_ext)
    if not na(m15_dlo_edge)
        ts_m15.process_swing_low(m15_dlo_edge, m15_dlo_t_e, i_m15_clr, i_brk_clr, m15_w, "15", m15_ext)

// --- M5 ---
if i_m5_on and m5_ok
    if not na(m5_shi_edge)
        ts_m5.process_swing_high(m5_shi_edge, m5_shi_t_e, i_m5_clr, i_brk_clr, m5_w, "5", m5_ext)
    if not na(m5_dlo_edge)
        ts_m5.process_swing_low(m5_dlo_edge, m5_dlo_t_e, i_m5_clr, i_brk_clr, m5_w, "5", m5_ext)
