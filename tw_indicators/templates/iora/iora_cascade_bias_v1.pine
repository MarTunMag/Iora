//@version=6
indicator("Iora Cascade Bias", shorttitle = "Cascade Bias", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// =============================================================================
// S1 — INPUTS
// =============================================================================

string GRP_ZONES = "Bias Zones"
bool   i_show_d1     = input.bool(true, "D1 Push Zones",            group = GRP_ZONES)
bool   i_show_w1     = input.bool(true, "W1 Push Zones (lines)",    group = GRP_ZONES)
bool   i_show_mn     = input.bool(true, "MN Levels",                group = GRP_ZONES)
int    i_d1_keep     = input.int(3, "D1 Zones Per Side",            group = GRP_ZONES, minval = 1, maxval = 10)
int    i_w1_keep     = input.int(2, "W1 Zones Per Side",            group = GRP_ZONES, minval = 1, maxval = 5)
float  i_doji        = input.float(5.0, "Doji Body %",              group = GRP_ZONES, minval = 0.1, maxval = 50.0)

string GRP_DISP = "Bias Display"
bool   i_show_ribbon      = input.bool(true, "Bias Ribbon (bgcolor)",    group = GRP_DISP)
bool   i_show_d2w         = input.bool(true, "D-to-W Label",            group = GRP_DISP)
bool   i_show_transitions = input.bool(true, "Transition Markers",      group = GRP_DISP)
bool   i_show_labels      = input.bool(true, "Zone Labels",             group = GRP_DISP)

string GRP_CLR = "Colors"
color  i_d1_sup_bg  = input.color(color.new(#FF4444, 85), "D1 Supply Fill",      group = GRP_CLR)
color  i_d1_sup_br  = input.color(color.new(#FF4444, 20), "D1 Supply Border",    group = GRP_CLR)
color  i_d1_dem_bg  = input.color(color.new(#2196F3, 85), "D1 Demand Fill",      group = GRP_CLR)
color  i_d1_dem_br  = input.color(color.new(#2196F3, 20), "D1 Demand Border",    group = GRP_CLR)
color  i_d1_rev_bg  = input.color(color.new(#FFB300, 88), "D1 Reversal Fill",    group = GRP_CLR)
color  i_d1_rev_br  = input.color(color.new(#FFB300, 20), "D1 Reversal Border",  group = GRP_CLR)
color  i_pri_br     = input.color(color.new(#FFD700, 0),  "Primary Bias Border", group = GRP_CLR)
color  i_w1_sup_clr = input.color(color.new(#FF4444, 40), "W1 Supply",           group = GRP_CLR)
color  i_w1_dem_clr = input.color(color.new(#2196F3, 40), "W1 Demand",           group = GRP_CLR)
color  i_mn_clr     = input.color(color.new(#808080, 40), "MN Levels",           group = GRP_CLR)

// =============================================================================
// S2 — ZONE UDT
// =============================================================================

type BiasZone
    float   top          = 0.0
    float   bottom       = 0.0
    bool    is_supply    = false
    int     origin_time  = 0
    box     bx
    bool    is_push      = false
    bool    is_reversal  = false
    string  struct_cls   = ""       // BOS, CHoCH
    string  swing_cls    = ""       // HH, LH, LL, HL
    bool    is_primary   = false    // highlighted as primary bias zone

type W1Line
    float   price        = 0.0
    bool    is_supply    = false
    bool    is_top       = true     // top or bottom of the zone
    int     origin_time  = 0
    line    ln
    label   lbl
    bool    is_push      = false
    string  swing_cls    = ""

// =============================================================================
// S3 — HA ZONE DETECTION (from push_zones_v2)
// Runs on target TF via request.security. HA candles computed manually.
// Zone boundaries (ORIZ spec):
//   Supply: top = OHLC high, bottom = HA low
//   Demand: top = HA high, bottom = OHLC low
// =============================================================================

ha_detect(float doji_pct) =>
    float haC = (open + high + low + close) / 4.0
    float haO = float(na)
    haO := na(haO[1]) ? (open + close) / 2.0 : (nz(haO[1]) + nz(haC[1])) / 2.0
    float haH = math.max(high, math.max(haO, haC))
    float haL = math.min(low, math.min(haO, haC))

    bool is_blue = haC >= haO
    bool is_red  = haC < haO

    int max_run = math.min(50, bar_index)

    var float prev_run_hi   = na
    var float prev_run_lo   = na
    var float seq_hh        = na
    var float seq_ll        = na
    var int   seq_hh_time   = na
    var int   seq_ll_time   = na
    var string hi1_txt      = ""
    var string lo1_txt      = ""

    bool  fire      = false
    float ztop      = 0.0
    float zbot      = 0.0
    bool  is_sup    = false
    int   zt_origin = time

    // DEMAND: red -> blue
    if is_blue and is_red[1]
        float run_lo_ohlc = low[1]
        int   ext_time    = time[1]
        int   k           = 2
        while k < max_run and is_red[k]
            if low[k] < run_lo_ohlc
                run_lo_ohlc := low[k]
                ext_time    := time[k]
            k += 1

        bool is_new_ll = na(prev_run_lo) or run_lo_ohlc < prev_run_lo
        seq_ll      := run_lo_ohlc
        seq_ll_time := ext_time
        prev_run_lo := run_lo_ohlc
        lo1_txt     := is_new_ll ? "LL" : "HL"

        float body = math.abs(haC - haO)
        float rng  = haH - haL
        bool  doji = rng > 0.0 and (body / rng * 100.0) < doji_pct

        ztop      := doji ? nz(haH, high) : nz(haH[1], high[1])
        zbot      := nz(run_lo_ohlc, low[1])
        zt_origin := nz(ext_time, time[1])
        fire      := true

    // SUPPLY: blue -> red
    else if is_red and is_blue[1]
        float run_hi_ohlc = high[1]
        int   ext_time    = time[1]
        int   k           = 2
        while k < max_run and is_blue[k]
            if high[k] > run_hi_ohlc
                run_hi_ohlc := high[k]
                ext_time    := time[k]
            k += 1

        bool is_new_hh = na(prev_run_hi) or run_hi_ohlc > prev_run_hi
        seq_hh      := run_hi_ohlc
        seq_hh_time := ext_time
        prev_run_hi := run_hi_ohlc
        hi1_txt     := is_new_hh ? "HH" : "LH"

        float body = math.abs(haC - haO)
        float rng  = haH - haL
        bool  doji = rng > 0.0 and (body / rng * 100.0) < doji_pct

        ztop      := nz(run_hi_ohlc, high[1])
        zbot      := doji ? nz(haL, low) : nz(haL[1], low[1])
        zt_origin := nz(ext_time, time[1])
        fire      := true
        is_sup    := true

    [fire, ztop, zbot, is_sup, zt_origin, seq_hh, seq_ll, seq_hh_time, seq_ll_time, hi1_txt, lo1_txt]

// =============================================================================
// S4 — PERIOD TRACKING (from push_zones_v2)
// Tracks previous closed period high/low with break detection.
// =============================================================================

track_period(string tf) =>
    bool new_period = ta.change(time(tf)) != 0

    var float cur_hi   = na
    var int   cur_hi_t = na
    var float cur_lo   = na
    var int   cur_lo_t = na
    var float prev_hi   = na
    var int   prev_hi_t = na
    var float prev_lo   = na
    var int   prev_lo_t = na
    var int   hi_brk_t  = na
    var int   lo_brk_t  = na

    if new_period
        prev_hi   := cur_hi
        prev_hi_t := cur_hi_t
        prev_lo   := cur_lo
        prev_lo_t := cur_lo_t
        cur_hi    := high
        cur_hi_t  := time
        cur_lo    := low
        cur_lo_t  := time
        hi_brk_t  := na
        lo_brk_t  := na
    else
        if high >= nz(cur_hi)
            cur_hi   := high
            cur_hi_t := time
        if low <= nz(cur_lo, 1e18)
            cur_lo   := low
            cur_lo_t := time

    if na(hi_brk_t) and not na(prev_hi) and high > prev_hi
        hi_brk_t := time
    if na(lo_brk_t) and not na(prev_lo) and low < prev_lo
        lo_brk_t := time

    [prev_hi, prev_hi_t, prev_lo, prev_lo_t, hi_brk_t, lo_brk_t]

// =============================================================================
// S5 — DATA REQUESTS
// 3 request.security() calls: D1, W1, MN1
// =============================================================================

string _sym = ticker.standard(syminfo.tickerid)

// D1 HA detection
[d1_fire_raw, d1_zt, d1_zb, d1_sup, d1_tm, d1_hh, d1_ll, d1_hht, d1_llt, d1_hi_txt, d1_lo_txt] = request.security(_sym, "1D", ha_detect(i_doji))

// W1 HA detection
[w1_fire_raw, w1_zt, w1_zb, w1_sup, w1_tm, w1_hh, w1_ll, w1_hht, w1_llt, w1_hi_txt, w1_lo_txt] = request.security(_sym, "1W", ha_detect(i_doji))

// MN1 OHLC
[mn_hi_raw, mn_lo_raw] = request.security(_sym, "1M", [high, low])

// Period tracking on chart TF (no request.security needed)
[d1_tp_hi, d1_tp_hi_t, d1_tp_lo, d1_tp_lo_t, d1_hi_brk, d1_lo_brk] = track_period("1D")
[w1_tp_hi, w1_tp_hi_t, w1_tp_lo, w1_tp_lo_t, w1_hi_brk, w1_lo_brk] = track_period("1W")
[mn_tp_hi, mn_tp_hi_t, mn_tp_lo, mn_tp_lo_t, mn_hi_brk, mn_lo_brk] = track_period("1M")

// =============================================================================
// S6 — EDGE DETECTION & TREND STATE
// =============================================================================

// Zone fire edge detection (fire on first chart bar only)
bool d1_fire = d1_fire_raw and not d1_fire_raw[1]
bool w1_fire = w1_fire_raw and not w1_fire_raw[1]

// D1 trend from period break edge detection
var int d1_trend = 0
if not na(d1_hi_brk) and na(d1_hi_brk[1])
    d1_trend := 1
if not na(d1_lo_brk) and na(d1_lo_brk[1])
    d1_trend := -1

// W1 trend
var int w1_trend = 0
if not na(w1_hi_brk) and na(w1_hi_brk[1])
    w1_trend := 1
if not na(w1_lo_brk) and na(w1_lo_brk[1])
    w1_trend := -1

// =============================================================================
// S7 — HELPERS
// =============================================================================

delete_bias_zone(array<BiasZone> zones, int idx) =>
    BiasZone z = zones.get(idx)
    if not na(z.bx)
        box.delete(z.bx)
    zones.remove(idx)

// Count zones of a given side
count_side(array<BiasZone> zones, bool is_supply) =>
    int cnt = 0
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            BiasZone z = zones.get(i)
            if z.is_supply == is_supply
                cnt += 1
    cnt

// Remove oldest zone of a given side to enforce cap
cap_side(array<BiasZone> zones, bool is_supply, int max_count) =>
    int cnt = count_side(zones, is_supply)
    if cnt > max_count and zones.size() > 0
        for i = 0 to zones.size() - 1
            BiasZone z = zones.get(i)
            if z.is_supply == is_supply
                delete_bias_zone(zones, i)
                break

// =============================================================================
// S8 — D1 ZONE MANAGEMENT
// No age expiry. Body-close break. Cap at N per side.
// Push validation: supply+HH tags demand as PUSH, demand+LL tags supply as PUSH.
// =============================================================================

var array<BiasZone> d1_zones = array.new<BiasZone>()
var float d1_push_hi = na
var float d1_push_lo = na

// 1. Break detection — every bar
if d1_zones.size() > 0
    for i = d1_zones.size() - 1 to 0
        BiasZone z = d1_zones.get(i)
        bool broken = z.is_supply ? (close > z.top) : (close < z.bottom)
        if broken
            delete_bias_zone(d1_zones, i)

// 2. New zone creation on D1 fire
if d1_fire and i_show_d1
    bool valid = not na(d1_zt) and not na(d1_zb) and not na(d1_tm) and d1_zt > d1_zb
    if valid
        string cls = d1_sup ? d1_hi_txt : d1_lo_txt
        // Start with push-style colors (all D1 zones are significant)
        color bg_clr = d1_sup ? i_d1_sup_bg : i_d1_dem_bg
        color br_clr = d1_sup ? i_d1_sup_br : i_d1_dem_br
        int tf_ms = 86400 * 1000
        box new_box = box.new(d1_tm, d1_zt, d1_tm + tf_ms * 6, d1_zb, xloc = xloc.bar_time, extend = extend.right, bgcolor = bg_clr, border_color = br_clr, border_width = 1, text = "", text_size = size.small, text_color = d1_sup ? color.new(#FF4444, 0) : color.new(#2196F3, 0), text_halign = text.align_right, text_valign = text.align_top)
        d1_zones.push(BiasZone.new(d1_zt, d1_zb, d1_sup, d1_tm, new_box, false, false, "", cls, false))

        // --- Push validation ---
        // Bullish push: supply fires with HH → tag most recent demand as PUSH
        if d1_sup and d1_hi_txt == "HH"
            bool boundary_ok = na(d1_push_hi) or d1_hh > d1_push_hi
            if boundary_ok and d1_zones.size() > 1
                for j = d1_zones.size() - 2 to 0
                    BiasZone zd = d1_zones.get(j)
                    if not zd.is_supply
                        zd.is_push := true
                        zd.struct_cls := d1_trend == 1 ? "BOS" : (d1_trend == -1 ? "CHoCH" : "")
                        if not na(zd.bx)
                            zd.bx.set_border_width(2)
                        break
                // Tag new supply as REVERSAL
                BiasZone zlast = d1_zones.get(d1_zones.size() - 1)
                zlast.is_reversal := true
                if not na(zlast.bx)
                    zlast.bx.set_bgcolor(i_d1_rev_bg)
                    zlast.bx.set_border_color(i_d1_rev_br)
                d1_push_hi := d1_hh

        // Bearish push: demand fires with LL → tag most recent supply as PUSH
        if not d1_sup and d1_lo_txt == "LL"
            bool boundary_ok = na(d1_push_lo) or d1_ll < d1_push_lo
            if boundary_ok and d1_zones.size() > 1
                for j = d1_zones.size() - 2 to 0
                    BiasZone zs = d1_zones.get(j)
                    if zs.is_supply
                        zs.is_push := true
                        zs.struct_cls := d1_trend == -1 ? "BOS" : (d1_trend == 1 ? "CHoCH" : "")
                        if not na(zs.bx)
                            zs.bx.set_border_width(2)
                        break
                // Tag new demand as REVERSAL
                BiasZone zlast = d1_zones.get(d1_zones.size() - 1)
                zlast.is_reversal := true
                if not na(zlast.bx)
                    zlast.bx.set_bgcolor(i_d1_rev_bg)
                    zlast.bx.set_border_color(i_d1_rev_br)
                d1_push_lo := d1_ll

        // --- Cap per side ---
        cap_side(d1_zones, true, i_d1_keep)
        cap_side(d1_zones, false, i_d1_keep)

// 3. Primary bias zone highlighting — update every bar
//    The primary zone is the most recent PUSH zone matching bias direction.
//    Bull bias → latest demand PUSH = target for H4 counter
//    Bear bias → latest supply PUSH = target for H4 counter
if d1_zones.size() > 0
    // Clear all primary flags
    for i = 0 to d1_zones.size() - 1
        BiasZone z = d1_zones.get(i)
        if z.is_primary
            z.is_primary := false
            // Restore normal border
            color restore_br = z.is_supply ? i_d1_sup_br : i_d1_dem_br
            if z.is_reversal
                restore_br := i_d1_rev_br
            if not na(z.bx)
                z.bx.set_border_color(restore_br)
                z.bx.set_border_width(z.is_push ? 2 : 1)

    // Find and highlight the primary
    for i = d1_zones.size() - 1 to 0
        BiasZone z = d1_zones.get(i)
        bool match = false
        if d1_trend == 1 and z.is_push and not z.is_supply
            match := true
        if d1_trend == -1 and z.is_push and z.is_supply
            match := true
        if match
            z.is_primary := true
            if not na(z.bx)
                z.bx.set_border_color(i_pri_br)
                z.bx.set_border_width(3)
            break

// 4. Label finalization — rebuild labels each bar for all D1 zones
if i_show_labels and d1_zones.size() > 0
    for i = 0 to d1_zones.size() - 1
        BiasZone z = d1_zones.get(i)
        string side_str = z.is_supply ? "S" : "D"
        string role_str = ""
        if z.is_push
            string struct_sfx = z.struct_cls != "" ? (" " + z.struct_cls) : ""
            role_str := " PUSH" + struct_sfx
        else if z.is_reversal
            role_str := " REV"
        string swing_str = z.swing_cls != "" ? (" " + z.swing_cls) : ""
        string pri_str = z.is_primary ? " *" : ""
        string final_txt = "D " + side_str + swing_str + role_str + pri_str
        if not na(z.bx)
            z.bx.set_text(final_txt)

// =============================================================================
// S9 — W1 ZONE MANAGEMENT (horizontal lines, not boxes)
// Same HA detection + push validation. Rendered as line pairs.
// =============================================================================

var array<W1Line> w1_lines = array.new<W1Line>()
var float w1_push_hi = na
var float w1_push_lo = na

// Helper: delete a W1 line entry
delete_w1_line(array<W1Line> lines, int idx) =>
    W1Line wl = lines.get(idx)
    if not na(wl.ln)
        line.delete(wl.ln)
    if not na(wl.lbl)
        label.delete(wl.lbl)
    lines.remove(idx)

// Break detection — body-close
if w1_lines.size() > 0
    for i = w1_lines.size() - 1 to 0
        W1Line wl = w1_lines.get(i)
        // Break the zone if close crosses the relevant boundary
        // For supply: broken if close > price (top of supply zone)
        // For demand: broken if close < price (bottom of demand zone)
        // We track both top and bottom lines per zone — break deletes both
        // But we check: supply top broken = close > top line price
        //               demand bottom broken = close < bottom line price
        bool broken = false
        if wl.is_supply and wl.is_top and close > wl.price
            broken := true
        if not wl.is_supply and not wl.is_top and close < wl.price
            broken := true
        if broken
            // Delete both lines of this zone (find the partner)
            int partner_idx = -1
            if w1_lines.size() > 0
                for j = w1_lines.size() - 1 to 0
                    if j != i
                        W1Line wp = w1_lines.get(j)
                        if wp.origin_time == wl.origin_time and wp.is_supply == wl.is_supply and wp.is_top != wl.is_top
                            partner_idx := j
                            break
            // Delete in reverse index order to avoid shifting
            if partner_idx >= 0
                int first_del = math.max(i, partner_idx)
                int second_del = math.min(i, partner_idx)
                delete_w1_line(w1_lines, first_del)
                delete_w1_line(w1_lines, second_del)
            else
                delete_w1_line(w1_lines, i)
            break  // restart next bar (modified array)

// New W1 zone creation
if w1_fire and i_show_w1
    bool valid = not na(w1_zt) and not na(w1_zb) and not na(w1_tm) and w1_zt > w1_zb
    if valid
        string cls = w1_sup ? w1_hi_txt : w1_lo_txt
        color  ln_clr = w1_sup ? i_w1_sup_clr : i_w1_dem_clr
        int    tf_ms  = 604800 * 1000

        // Top line
        line ln_top = line.new(w1_tm, w1_zt, w1_tm + tf_ms, w1_zt, xloc = xloc.bar_time, extend = extend.right, color = ln_clr, width = 2, style = line.style_dashed)
        label lbl_top = na
        if i_show_labels
            string side_str = w1_sup ? "S" : "D"
            string lbl_txt = "W " + side_str + " " + cls
            lbl_top := label.new(w1_tm, w1_zt, lbl_txt, xloc = xloc.bar_time, style = label.style_none, textcolor = ln_clr, size = size.small)
        w1_lines.push(W1Line.new(w1_zt, w1_sup, true, w1_tm, ln_top, lbl_top, false, cls))

        // Bottom line
        line ln_bot = line.new(w1_tm, w1_zb, w1_tm + tf_ms, w1_zb, xloc = xloc.bar_time, extend = extend.right, color = ln_clr, width = 1, style = line.style_dotted)
        w1_lines.push(W1Line.new(w1_zb, w1_sup, false, w1_tm, ln_bot, na, false, cls))

        // Push validation for W1
        if w1_sup and w1_hi_txt == "HH"
            bool boundary_ok = na(w1_push_hi) or w1_hh > w1_push_hi
            if boundary_ok
                // Tag most recent W1 demand lines as PUSH
                for j = w1_lines.size() - 1 to 0
                    W1Line wl = w1_lines.get(j)
                    if not wl.is_supply and wl.is_top
                        wl.is_push := true
                        if not na(wl.ln)
                            wl.ln.set_width(3)
                        break
                w1_push_hi := w1_hh

        if not w1_sup and w1_lo_txt == "LL"
            bool boundary_ok = na(w1_push_lo) or w1_ll < w1_push_lo
            if boundary_ok
                for j = w1_lines.size() - 1 to 0
                    W1Line wl = w1_lines.get(j)
                    if wl.is_supply and wl.is_top
                        wl.is_push := true
                        if not na(wl.ln)
                            wl.ln.set_width(3)
                        break
                w1_push_lo := w1_ll

        // Cap per side (count top lines only as proxy for zone count)
        int w1_sup_cnt = 0
        int w1_dem_cnt = 0
        if w1_lines.size() > 0
            for j = 0 to w1_lines.size() - 1
                W1Line wl = w1_lines.get(j)
                if wl.is_top
                    if wl.is_supply
                        w1_sup_cnt += 1
                    else
                        w1_dem_cnt += 1
        // Remove oldest supply pair if over cap
        if w1_sup_cnt > i_w1_keep and w1_lines.size() > 0
            for j = 0 to w1_lines.size() - 1
                W1Line wl = w1_lines.get(j)
                if wl.is_supply and wl.is_top
                    // Find and delete partner bottom line
                    for k = 0 to w1_lines.size() - 1
                        if k != j
                            W1Line wp = w1_lines.get(k)
                            if wp.origin_time == wl.origin_time and wp.is_supply and not wp.is_top
                                int first_del = math.max(j, k)
                                int second_del = math.min(j, k)
                                delete_w1_line(w1_lines, first_del)
                                delete_w1_line(w1_lines, second_del)
                                break
                    break
        if w1_dem_cnt > i_w1_keep and w1_lines.size() > 0
            for j = 0 to w1_lines.size() - 1
                W1Line wl = w1_lines.get(j)
                if not wl.is_supply and wl.is_top
                    for k = 0 to w1_lines.size() - 1
                        if k != j
                            W1Line wp = w1_lines.get(k)
                            if wp.origin_time == wl.origin_time and not wp.is_supply and not wp.is_top
                                int first_del = math.max(j, k)
                                int second_del = math.min(j, k)
                                delete_w1_line(w1_lines, first_del)
                                delete_w1_line(w1_lines, second_del)
                                break
                    break

// =============================================================================
// S10 — MN1 LEVEL MARKERS
// Previous month high/low as dotted lines. Updates on new month.
// =============================================================================

var line mn_hi_line = na
var line mn_lo_line = na
var label mn_hi_lbl = na
var label mn_lo_lbl = na

if i_show_mn
    bool new_month = ta.change(time("1M")) != 0
    if new_month and not na(mn_tp_hi) and not na(mn_tp_lo)
        // Delete old lines
        if not na(mn_hi_line)
            line.delete(mn_hi_line)
        if not na(mn_lo_line)
            line.delete(mn_lo_line)
        if not na(mn_hi_lbl)
            label.delete(mn_hi_lbl)
        if not na(mn_lo_lbl)
            label.delete(mn_lo_lbl)

        // Draw new lines at previous month's high/low
        mn_hi_line := line.new(time, mn_tp_hi, time, mn_tp_hi, xloc = xloc.bar_time, extend = extend.right, color = i_mn_clr, width = 1, style = line.style_dotted)
        mn_lo_line := line.new(time, mn_tp_lo, time, mn_tp_lo, xloc = xloc.bar_time, extend = extend.right, color = i_mn_clr, width = 1, style = line.style_dotted)
        mn_hi_lbl  := label.new(time, mn_tp_hi, "MN H", xloc = xloc.bar_time, style = label.style_none, textcolor = i_mn_clr, size = size.tiny)
        mn_lo_lbl  := label.new(time, mn_tp_lo, "MN L", xloc = xloc.bar_time, style = label.style_none, textcolor = i_mn_clr, size = size.tiny)

// =============================================================================
// S11 — BIAS STATE & RIBBON
// Bias derived from D1 HA swing classifications:
//   HH + HL → BULL PUSH    LH + LL → BEAR PUSH
//   LH + HL → COMPRESSION  HH + LL → EXPANSION
// =============================================================================

var string d1_bias_state = "NEUTRAL"
var string d1_prev_bias  = "NEUTRAL"

// Track the last D1 hi/lo classification (persistent across bars)
var string d1_last_hi = ""
var string d1_last_lo = ""

// Update when D1 zone fires (hi_txt/lo_txt change only on fire)
if d1_fire
    if d1_sup
        d1_last_hi := d1_hi_txt
    else
        d1_last_lo := d1_lo_txt

// Compute bias state from combination
string new_bias = "NEUTRAL"
if d1_last_hi == "HH" and d1_last_lo == "HL"
    new_bias := "BULL_PUSH"
else if d1_last_hi == "LH" and d1_last_lo == "LL"
    new_bias := "BEAR_PUSH"
else if d1_last_hi == "LH" and d1_last_lo == "HL"
    new_bias := "COMPRESSION"
else if d1_last_hi == "HH" and d1_last_lo == "LL"
    new_bias := "EXPANSION"

d1_prev_bias := d1_bias_state
d1_bias_state := new_bias

// Bias ribbon: subtle bgcolor on main chart
color ribbon_clr = na
if i_show_ribbon
    ribbon_clr := new_bias == "BULL_PUSH" ? color.new(#26A69A, 92) : new_bias == "BEAR_PUSH" ? color.new(#EF5350, 92) : new_bias == "COMPRESSION" ? color.new(#FFB300, 95) : new_bias == "EXPANSION" ? color.new(#78909C, 95) : na
bgcolor(ribbon_clr, title = "D1 Bias Ribbon")

// =============================================================================
// S12 — D-TO-W RELATIONSHIP
// Compare D1 trend direction to W1 trend direction.
// =============================================================================

var label d2w_label = na

if i_show_d2w and barstate.islast
    string d2w_txt = ""
    color  d2w_clr = color.gray

    // Check if price is inside any W1 zone
    bool inside_w1 = false
    if w1_lines.size() > 0
        float w1_nearest_top = na
        float w1_nearest_bot = na
        for i = 0 to w1_lines.size() - 1
            W1Line wl = w1_lines.get(i)
            if wl.is_top
                // Find matching bottom
                for j = 0 to w1_lines.size() - 1
                    W1Line wb = w1_lines.get(j)
                    if wb.origin_time == wl.origin_time and wb.is_supply == wl.is_supply and not wb.is_top
                        if close <= wl.price and close >= wb.price
                            inside_w1 := true
                        break

    if inside_w1
        d2w_txt := "INSIDE W1"
        d2w_clr := color.new(#FFB300, 0)
    else if d1_trend == w1_trend and d1_trend != 0
        d2w_txt := "CONTINUATION"
        d2w_clr := d1_trend == 1 ? color.new(#26A69A, 0) : color.new(#EF5350, 0)
    else if d1_trend != 0 and w1_trend != 0 and d1_trend != w1_trend
        d2w_txt := "PULLBACK"
        d2w_clr := color.new(#FF9800, 0)
    else
        d2w_txt := "NEUTRAL"
        d2w_clr := color.new(#808080, 0)

    if not na(d2w_label)
        label.delete(d2w_label)
    d2w_label := label.new(bar_index, low - (high - low) * 0.5, "D→W: " + d2w_txt, style = label.style_label_up, color = color.new(#1a1a2e, 20), textcolor = d2w_clr, size = size.normal)

// =============================================================================
// S13 — BIAS TRANSITION MARKERS
// Vertical dashed line when D1 bias state changes.
// =============================================================================

if i_show_transitions and d1_bias_state != d1_prev_bias and d1_prev_bias != "NEUTRAL"
    color trans_clr = d1_bias_state == "BULL_PUSH" ? color.new(#26A69A, 40) : d1_bias_state == "BEAR_PUSH" ? color.new(#EF5350, 40) : d1_bias_state == "COMPRESSION" ? color.new(#FFB300, 50) : color.new(#78909C, 50)
    line.new(bar_index, high + (high - low), bar_index, low - (high - low), color = trans_clr, width = 1, style = line.style_dashed)

// =============================================================================
// S14 — INFO PLOT (for Indicator 2 reference, invisible)
// Export D1 bias as numeric: 1=bull, -1=bear, 0.5=compression, -0.5=expansion
// =============================================================================

float bias_num = d1_bias_state == "BULL_PUSH" ? 1.0 : d1_bias_state == "BEAR_PUSH" ? -1.0 : d1_bias_state == "COMPRESSION" ? 0.5 : d1_bias_state == "EXPANSION" ? -0.5 : 0.0
plot(bias_num, "D1 Bias", display = display.data_window, color = color.new(color.white, 100))
plot(d1_trend == 1 ? 1.0 : d1_trend == -1 ? -1.0 : 0.0, "D1 Trend", display = display.data_window, color = color.new(color.white, 100))
