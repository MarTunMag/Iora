//@version=6
indicator("Iora Hybrid Envelope", overlay=true)

// =============================================================================
// Module 1: Hybrid Envelope Engine
// Three-source dynamic envelope per TF using live building candles.
// Designed for M1 chart. Uses request.security with lookahead to get
// building candle OHLC — no manual M1 reconstruction needed.
// =============================================================================

// =============================================================================
// INPUTS
// =============================================================================

string GRP_ENV = "Envelope Toggles"
bool  i_m5_on   = input.bool(true,  "M5",  group=GRP_ENV, inline="m5")
color i_m5_clr  = input.color(#78909C, "",  group=GRP_ENV, inline="m5")
bool  i_m15_on  = input.bool(true,  "M15", group=GRP_ENV, inline="m15")
color i_m15_clr = input.color(#26A69A, "",  group=GRP_ENV, inline="m15")
bool  i_h1_on   = input.bool(true,  "H1",  group=GRP_ENV, inline="h1")
color i_h1_clr  = input.color(#42A5F5, "",  group=GRP_ENV, inline="h1")
bool  i_h4_on   = input.bool(true,  "H4",  group=GRP_ENV, inline="h4")
color i_h4_clr  = input.color(#AB47BC, "",  group=GRP_ENV, inline="h4")
bool  i_d_on    = input.bool(true,  "D",   group=GRP_ENV, inline="d")
color i_d_clr   = input.color(#FF7043, "",  group=GRP_ENV, inline="d")
bool  i_w_on    = input.bool(false, "W",   group=GRP_ENV, inline="w")
color i_w_clr   = input.color(#FFCA28, "",  group=GRP_ENV, inline="w")
bool  i_mn_on   = input.bool(false, "MN",  group=GRP_ENV, inline="mn")
color i_mn_clr  = input.color(#EF5350, "",  group=GRP_ENV, inline="mn")

string GRP_DASH = "Dashboard"
bool   i_dash_on  = input.bool(true, "Show Dashboard", group=GRP_DASH)
string i_dash_pos = input.string("Top Right", "Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=GRP_DASH)

// =============================================================================
// REQUEST.SECURITY — Live building candle OHLC per child TF
// lookahead=barmerge.lookahead_on returns the BUILDING candle:
//   h = max so far, l = min so far, c = latest close
// =============================================================================

[m5o,  m5h,  m5l,  m5c,  m5t,  m5tc]  = request.security(syminfo.tickerid, "5",   [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[m15o, m15h, m15l, m15c, m15t, m15tc] = request.security(syminfo.tickerid, "15",  [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[h1o,  h1h,  h1l,  h1c,  h1t,  h1tc]  = request.security(syminfo.tickerid, "60",  [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[h4o,  h4h,  h4l,  h4c,  h4t,  h4tc]  = request.security(syminfo.tickerid, "240", [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[d_o,  d_h,  d_l,  d_c,  d_t,  d_tc]  = request.security(syminfo.tickerid, "1D",  [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[w_o,  w_h,  w_l,  w_c,  w_t,  w_tc]  = request.security(syminfo.tickerid, "1W",  [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)

// Period-change detection: true when a new candle opens at the child TF
bool m5_new  = ta.change(m5t)  != 0
bool m15_new = ta.change(m15t) != 0
bool h1_new  = ta.change(h1t)  != 0
bool h4_new  = ta.change(h4t)  != 0
bool d_new   = ta.change(d_t)  != 0
bool w_new   = ta.change(w_t)  != 0

// =============================================================================
// M5 ENVELOPE — child = M1 (chart bars on M1 chart), N=5
// =============================================================================

float m5_env_ceil  = ta.sma(high, 5)
float m5_env_floor = ta.sma(low, 5)
float m5_env_mid   = ta.sma(close, 5)

// =============================================================================
// CLOSED CANDLE HISTORY + ENVELOPE COMPUTATION
// Pattern per parent TF:
//   Store last N-1 closed child candle highs/lows/closes in arrays.
//   On child period change, shift new closed values in, pop oldest.
//   Envelope = (sum of closed history + building candle) / N
// =============================================================================

// --- M15 envelope: child = M5, N=3 (2 closed + 1 building) ----------------
var array<float> m5_ch_hi = array.new_float(0)
var array<float> m5_ch_lo = array.new_float(0)
var array<float> m5_ch_cl = array.new_float(0)
var int m5_ch_cnt = 0

if m5_new and not na(m5h[1])
    m5_ch_hi.unshift(m5h[1])
    m5_ch_lo.unshift(m5l[1])
    m5_ch_cl.unshift(m5c[1])
    m5_ch_cnt += 1
    if m5_ch_hi.size() > 2
        m5_ch_hi.pop()
        m5_ch_lo.pop()
        m5_ch_cl.pop()

float m15_env_ceil  = m5_ch_cnt >= 2 ? (m5_ch_hi.sum() + m5h) / 3 : na
float m15_env_floor = m5_ch_cnt >= 2 ? (m5_ch_lo.sum() + m5l) / 3 : na
float m15_env_mid   = m5_ch_cnt >= 2 ? (m5_ch_cl.sum() + m5c) / 3 : na

// --- H1 envelope: child = M15, N=4 (3 closed + 1 building) ----------------
var array<float> m15_ch_hi = array.new_float(0)
var array<float> m15_ch_lo = array.new_float(0)
var array<float> m15_ch_cl = array.new_float(0)
var int m15_ch_cnt = 0

if m15_new and not na(m15h[1])
    m15_ch_hi.unshift(m15h[1])
    m15_ch_lo.unshift(m15l[1])
    m15_ch_cl.unshift(m15c[1])
    m15_ch_cnt += 1
    if m15_ch_hi.size() > 3
        m15_ch_hi.pop()
        m15_ch_lo.pop()
        m15_ch_cl.pop()

float h1_env_ceil  = m15_ch_cnt >= 3 ? (m15_ch_hi.sum() + m15h) / 4 : na
float h1_env_floor = m15_ch_cnt >= 3 ? (m15_ch_lo.sum() + m15l) / 4 : na
float h1_env_mid   = m15_ch_cnt >= 3 ? (m15_ch_cl.sum() + m15c) / 4 : na

// --- H4 envelope: child = H1, N=4 (3 closed + 1 building) -----------------
var array<float> h1_ch_hi = array.new_float(0)
var array<float> h1_ch_lo = array.new_float(0)
var array<float> h1_ch_cl = array.new_float(0)
var int h1_ch_cnt = 0

if h1_new and not na(h1h[1])
    h1_ch_hi.unshift(h1h[1])
    h1_ch_lo.unshift(h1l[1])
    h1_ch_cl.unshift(h1c[1])
    h1_ch_cnt += 1
    if h1_ch_hi.size() > 3
        h1_ch_hi.pop()
        h1_ch_lo.pop()
        h1_ch_cl.pop()

float h4_env_ceil  = h1_ch_cnt >= 3 ? (h1_ch_hi.sum() + h1h) / 4 : na
float h4_env_floor = h1_ch_cnt >= 3 ? (h1_ch_lo.sum() + h1l) / 4 : na
float h4_env_mid   = h1_ch_cnt >= 3 ? (h1_ch_cl.sum() + h1c) / 4 : na

// --- D envelope: child = H4, N=6 (5 closed + 1 building) ------------------
var array<float> h4_ch_hi = array.new_float(0)
var array<float> h4_ch_lo = array.new_float(0)
var array<float> h4_ch_cl = array.new_float(0)
var int h4_ch_cnt = 0

if h4_new and not na(h4h[1])
    h4_ch_hi.unshift(h4h[1])
    h4_ch_lo.unshift(h4l[1])
    h4_ch_cl.unshift(h4c[1])
    h4_ch_cnt += 1
    if h4_ch_hi.size() > 5
        h4_ch_hi.pop()
        h4_ch_lo.pop()
        h4_ch_cl.pop()

float d_env_ceil  = h4_ch_cnt >= 5 ? (h4_ch_hi.sum() + h4h) / 6 : na
float d_env_floor = h4_ch_cnt >= 5 ? (h4_ch_lo.sum() + h4l) / 6 : na
float d_env_mid   = h4_ch_cnt >= 5 ? (h4_ch_cl.sum() + h4c) / 6 : na

// --- W envelope: child = D, N=5 (4 closed + 1 building) -------------------
var array<float> d_ch_hi = array.new_float(0)
var array<float> d_ch_lo = array.new_float(0)
var array<float> d_ch_cl = array.new_float(0)
var int d_ch_cnt = 0

if d_new and not na(d_h[1])
    d_ch_hi.unshift(d_h[1])
    d_ch_lo.unshift(d_l[1])
    d_ch_cl.unshift(d_c[1])
    d_ch_cnt += 1
    if d_ch_hi.size() > 4
        d_ch_hi.pop()
        d_ch_lo.pop()
        d_ch_cl.pop()

float w_env_ceil  = d_ch_cnt >= 4 ? (d_ch_hi.sum() + d_h) / 5 : na
float w_env_floor = d_ch_cnt >= 4 ? (d_ch_lo.sum() + d_l) / 5 : na
float w_env_mid   = d_ch_cnt >= 4 ? (d_ch_cl.sum() + d_c) / 5 : na

// --- MN envelope: child = W, N=4 (3 closed + 1 building) ------------------
var array<float> w_ch_hi = array.new_float(0)
var array<float> w_ch_lo = array.new_float(0)
var array<float> w_ch_cl = array.new_float(0)
var int w_ch_cnt = 0

if w_new and not na(w_h[1])
    w_ch_hi.unshift(w_h[1])
    w_ch_lo.unshift(w_l[1])
    w_ch_cl.unshift(w_c[1])
    w_ch_cnt += 1
    if w_ch_hi.size() > 3
        w_ch_hi.pop()
        w_ch_lo.pop()
        w_ch_cl.pop()

float mn_env_ceil  = w_ch_cnt >= 3 ? (w_ch_hi.sum() + w_h) / 4 : na
float mn_env_floor = w_ch_cnt >= 3 ? (w_ch_lo.sum() + w_l) / 4 : na
float mn_env_mid   = w_ch_cnt >= 3 ? (w_ch_cl.sum() + w_c) / 4 : na

// =============================================================================
// GRADIENTS — bar-to-bar delta per envelope source
// Direction: +1 rising, -1 falling, 0 flat
// Gradient score per TF: sum of 3 source directions (-3 to +3)
// =============================================================================

float m5_ceil_d   = ta.change(m5_env_ceil)
float m5_floor_d  = ta.change(m5_env_floor)
float m5_mid_d    = ta.change(m5_env_mid)
int   m5_grad     = int(math.sign(nz(m5_floor_d))) + int(math.sign(nz(m5_mid_d))) + int(math.sign(nz(m5_ceil_d)))

float m15_ceil_d  = ta.change(m15_env_ceil)
float m15_floor_d = ta.change(m15_env_floor)
float m15_mid_d   = ta.change(m15_env_mid)
int   m15_grad    = int(math.sign(nz(m15_floor_d))) + int(math.sign(nz(m15_mid_d))) + int(math.sign(nz(m15_ceil_d)))

float h1_ceil_d   = ta.change(h1_env_ceil)
float h1_floor_d  = ta.change(h1_env_floor)
float h1_mid_d    = ta.change(h1_env_mid)
int   h1_grad     = int(math.sign(nz(h1_floor_d))) + int(math.sign(nz(h1_mid_d))) + int(math.sign(nz(h1_ceil_d)))

float h4_ceil_d   = ta.change(h4_env_ceil)
float h4_floor_d  = ta.change(h4_env_floor)
float h4_mid_d    = ta.change(h4_env_mid)
int   h4_grad     = int(math.sign(nz(h4_floor_d))) + int(math.sign(nz(h4_mid_d))) + int(math.sign(nz(h4_ceil_d)))

float d_ceil_d    = ta.change(d_env_ceil)
float d_floor_d   = ta.change(d_env_floor)
float d_mid_d     = ta.change(d_env_mid)
int   d_grad      = int(math.sign(nz(d_floor_d))) + int(math.sign(nz(d_mid_d))) + int(math.sign(nz(d_ceil_d)))

float w_ceil_d    = ta.change(w_env_ceil)
float w_floor_d   = ta.change(w_env_floor)
float w_mid_d     = ta.change(w_env_mid)
int   w_grad      = int(math.sign(nz(w_floor_d))) + int(math.sign(nz(w_mid_d))) + int(math.sign(nz(w_ceil_d)))

float mn_ceil_d   = ta.change(mn_env_ceil)
float mn_floor_d  = ta.change(mn_env_floor)
float mn_mid_d    = ta.change(mn_env_mid)
int   mn_grad     = int(math.sign(nz(mn_floor_d))) + int(math.sign(nz(mn_mid_d))) + int(math.sign(nz(mn_ceil_d)))

// =============================================================================
// PLOTTING — hidden ceil/floor anchors, faint fill band, thin mid line only
// Ceil/floor at 100% transparency (invisible) — they exist only for fill().
// Mid line is the only visible line per TF. Fill band gives subtle context.
// =============================================================================

// M5
p_m5_c = plot(i_m5_on ? m5_env_ceil  : na, "M5 Ceil",  color=color.new(i_m5_clr, 100), style=plot.style_stepline, display=display.none)
p_m5_f = plot(i_m5_on ? m5_env_floor : na, "M5 Floor", color=color.new(i_m5_clr, 100), style=plot.style_stepline, display=display.none)
plot(i_m5_on ? m5_env_mid : na, "M5 Mid", color=color.new(i_m5_clr, 40), style=plot.style_stepline, linewidth=1)
fill(p_m5_c, p_m5_f, color=color.new(i_m5_clr, 95), title="M5 Fill")

// M15
p_m15_c = plot(i_m15_on ? m15_env_ceil  : na, "M15 Ceil",  color=color.new(i_m15_clr, 100), style=plot.style_stepline, display=display.none)
p_m15_f = plot(i_m15_on ? m15_env_floor : na, "M15 Floor", color=color.new(i_m15_clr, 100), style=plot.style_stepline, display=display.none)
plot(i_m15_on ? m15_env_mid : na, "M15 Mid", color=color.new(i_m15_clr, 30), style=plot.style_stepline, linewidth=1)
fill(p_m15_c, p_m15_f, color=color.new(i_m15_clr, 94), title="M15 Fill")

// H1
p_h1_c = plot(i_h1_on ? h1_env_ceil  : na, "H1 Ceil",  color=color.new(i_h1_clr, 100), style=plot.style_stepline, display=display.none)
p_h1_f = plot(i_h1_on ? h1_env_floor : na, "H1 Floor", color=color.new(i_h1_clr, 100), style=plot.style_stepline, display=display.none)
plot(i_h1_on ? h1_env_mid : na, "H1 Mid", color=color.new(i_h1_clr, 20), style=plot.style_stepline, linewidth=1)
fill(p_h1_c, p_h1_f, color=color.new(i_h1_clr, 93), title="H1 Fill")

// H4
p_h4_c = plot(i_h4_on ? h4_env_ceil  : na, "H4 Ceil",  color=color.new(i_h4_clr, 100), style=plot.style_stepline, display=display.none)
p_h4_f = plot(i_h4_on ? h4_env_floor : na, "H4 Floor", color=color.new(i_h4_clr, 100), style=plot.style_stepline, display=display.none)
plot(i_h4_on ? h4_env_mid : na, "H4 Mid", color=color.new(i_h4_clr, 10), style=plot.style_stepline, linewidth=1)
fill(p_h4_c, p_h4_f, color=color.new(i_h4_clr, 93), title="H4 Fill")

// D
p_d_c = plot(i_d_on ? d_env_ceil  : na, "D Ceil",  color=color.new(i_d_clr, 100), style=plot.style_stepline, display=display.none)
p_d_f = plot(i_d_on ? d_env_floor : na, "D Floor", color=color.new(i_d_clr, 100), style=plot.style_stepline, display=display.none)
plot(i_d_on ? d_env_mid : na, "D Mid", color=color.new(i_d_clr, 0), style=plot.style_stepline, linewidth=1)
fill(p_d_c, p_d_f, color=color.new(i_d_clr, 92), title="D Fill")

// W
p_w_c = plot(i_w_on ? w_env_ceil  : na, "W Ceil",  color=color.new(i_w_clr, 100), style=plot.style_stepline, display=display.none)
p_w_f = plot(i_w_on ? w_env_floor : na, "W Floor", color=color.new(i_w_clr, 100), style=plot.style_stepline, display=display.none)
plot(i_w_on ? w_env_mid : na, "W Mid", color=color.new(i_w_clr, 0), style=plot.style_stepline, linewidth=1)
fill(p_w_c, p_w_f, color=color.new(i_w_clr, 92), title="W Fill")

// MN
p_mn_c = plot(i_mn_on ? mn_env_ceil  : na, "MN Ceil",  color=color.new(i_mn_clr, 100), style=plot.style_stepline, display=display.none)
p_mn_f = plot(i_mn_on ? mn_env_floor : na, "MN Floor", color=color.new(i_mn_clr, 100), style=plot.style_stepline, display=display.none)
plot(i_mn_on ? mn_env_mid : na, "MN Mid", color=color.new(i_mn_clr, 0), style=plot.style_stepline, linewidth=1)
fill(p_mn_c, p_mn_f, color=color.new(i_mn_clr, 92), title="MN Fill")

// =============================================================================
// DASHBOARD TABLE
// =============================================================================

string tbl_pos = switch i_dash_pos
    "Top Left"     => position.top_left
    "Top Right"    => position.top_right
    "Bottom Left"  => position.bottom_left
    "Bottom Right" => position.bottom_right
    => position.top_right

var table dash = table.new(tbl_pos, 5, 8, border_width=1, border_color=#363636, bgcolor=#1A1A2E)

// Helper: format price for dashboard
price_fmt(float val) =>
    na(val) ? "—" : str.tostring(val, format.mintick)

// Helper: gradient arrows (floor/mid/ceil direction)
grad_arrows(float fd, float md, float cd) =>
    string fa = fd > 0 ? "▲" : fd < 0 ? "▼" : "—"
    string ma = md > 0 ? "▲" : md < 0 ? "▼" : "—"
    string ca = cd > 0 ? "▲" : cd < 0 ? "▼" : "—"
    fa + ma + ca

// Helper: gradient score color
grad_clr(int score) =>
    score > 0 ? #26A69A : score < 0 ? #EF5350 : #808080

// Helper: write one dashboard row
dash_row(int row, string tf_name, color tf_clr, float env_floor, float env_mid, float env_ceil, float fd, float md, float cd, int score) =>
    table.cell(dash, 0, row, tf_name,              text_color=tf_clr,  text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 1, row, price_fmt(env_floor),  text_color=#E0E0E0, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 2, row, price_fmt(env_mid),    text_color=#FFFFFF, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 3, row, price_fmt(env_ceil),   text_color=#E0E0E0, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 4, row, grad_arrows(fd, md, cd), text_color=grad_clr(score), text_size=size.small, text_halign=text.align_center)

if i_dash_on and barstate.islast
    // Header
    table.cell(dash, 0, 0, "TF",    text_color=#AAAAAA, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 1, 0, "Floor", text_color=#AAAAAA, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 2, 0, "Mid",   text_color=#AAAAAA, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 3, 0, "Ceil",  text_color=#AAAAAA, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)
    table.cell(dash, 4, 0, "F M C", text_color=#AAAAAA, text_size=size.small, bgcolor=#252540, text_halign=text.align_center)

    // Data rows (1=M5 through 7=MN)
    dash_row(1, "M5",  i_m5_clr,  m5_env_floor,  m5_env_mid,  m5_env_ceil,  nz(m5_floor_d),  nz(m5_mid_d),  nz(m5_ceil_d),  m5_grad)
    dash_row(2, "M15", i_m15_clr, m15_env_floor, m15_env_mid, m15_env_ceil, nz(m15_floor_d), nz(m15_mid_d), nz(m15_ceil_d), m15_grad)
    dash_row(3, "H1",  i_h1_clr,  h1_env_floor,  h1_env_mid,  h1_env_ceil,  nz(h1_floor_d),  nz(h1_mid_d),  nz(h1_ceil_d),  h1_grad)
    dash_row(4, "H4",  i_h4_clr,  h4_env_floor,  h4_env_mid,  h4_env_ceil,  nz(h4_floor_d),  nz(h4_mid_d),  nz(h4_ceil_d),  h4_grad)
    dash_row(5, "D",   i_d_clr,   d_env_floor,   d_env_mid,   d_env_ceil,   nz(d_floor_d),   nz(d_mid_d),   nz(d_ceil_d),   d_grad)
    dash_row(6, "W",   i_w_clr,   w_env_floor,   w_env_mid,   w_env_ceil,   nz(w_floor_d),   nz(w_mid_d),   nz(w_ceil_d),   w_grad)
    dash_row(7, "MN",  i_mn_clr,  mn_env_floor,  mn_env_mid,  mn_env_ceil,  nz(mn_floor_d),  nz(mn_mid_d),  nz(mn_ceil_d),  mn_grad)
