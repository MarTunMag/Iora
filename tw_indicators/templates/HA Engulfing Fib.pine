//@version=6
indicator("HA Engulfing Fib (H1 Anchor)", overlay = true, max_lines_count = 200, max_labels_count = 200)

// ─── Inputs ────────────────────────────────────────────────────────────────────
string GRP_TF = "Anchor Timeframe"
string anchorTfInput = input.timeframe("60", "Anchor TF (for HA engulf)", group = GRP_TF)

string GRP_DSP = "Display"
int    lineWidthInput    = input.int(1, "Line Width", minval = 1, maxval = 4, group = GRP_DSP)
int    lineTranspInput   = input.int(60, "Line Transparency %", minval = 0, maxval = 95, group = GRP_DSP)
string lineStyleInput    = input.string("Dotted", "Line Style", options = ["Solid", "Dashed", "Dotted"], group = GRP_DSP)
bool   showLabelsInput   = input.bool(true, "Show Labels", group = GRP_DSP)
bool   showPricesInput   = input.bool(true, "Show Prices on Labels", group = GRP_DSP)
bool   labelsAtOrigin    = input.string("Origin (left)", "Label Position", options = ["Origin (left)", "Right end"], group = GRP_DSP) == "Origin (left)"
bool   showGoldenInput   = input.bool(true, "Show Golden Zone (0.5-0.618)", group = GRP_DSP)
color  goldenColorInput  = input.color(color.new(#FFD54F, 90), "Golden Zone Color", group = GRP_DSP)
int    extendCandlesInput = input.int(3, "Extend Across N Anchor TF Candles", minval = 1, maxval = 6, group = GRP_DSP)

string GRP_CLR = "Fib Level Colors"
color clrNeg618Input = input.color(#2196F3, "-0.618", group = GRP_CLR)
color clrNeg025Input = input.color(#2196F3, "-0.25",  group = GRP_CLR)
color clr0Input      = input.color(#787B86, "0",      group = GRP_CLR)
color clr236Input    = input.color(#4CAF50, "0.25",   group = GRP_CLR)
color clr382Input    = input.color(#089981, "0.382",  group = GRP_CLR)
color clr500Input    = input.color(#4CAF50, "0.5",    group = GRP_CLR)
color clr618Input    = input.color(#FFD54F, "0.618",  group = GRP_CLR)
color clr786Input    = input.color(#FF9800, "0.786",  group = GRP_CLR)
color clr100Input    = input.color(#787B86, "1",      group = GRP_CLR)
color clr128Input    = input.color(#F44336, "1.25",   group = GRP_CLR)
color clr1618Input   = input.color(#009688, "1.618",  group = GRP_CLR)

// ─── HA Ticker ────────────────────────────────────────────────────────────────
string haTicker = ticker.heikinashi(syminfo.tickerid)

// ─── Request HA OHLC + open time for anchor TF (last CLOSED candle) ──────────
// We pull high[1]/low[1]/open[1]/close[1]/time[1] on the anchor TF with lookahead_on,
// so tfH/tfL/tfO/tfC/tfT are always the last fully closed HA candle on that TF,
// stable across all lower chart timeframes.
[tfH, tfL, tfO, tfC, tfT] = request.security(
     haTicker,
     anchorTfInput,
     [high[1], low[1], open[1], close[1], time[1]],
     barmerge.gaps_off,
     barmerge.lookahead_on)

// Current (possibly forming) HA bar open time on the anchor TF
int curTfT = request.security(
     haTicker,
     anchorTfInput,
     time,
     barmerge.gaps_off,
     barmerge.lookahead_off)

// ─── Fib Level Data ───────────────────────────────────────────────────────────
// 11 levels: 2 extensions, 7 retracement, 2 extensions (symmetric magnitudes)
// 0.5 = index 5, 0.618 = index 6 (used for golden zone)
var array<float>  FIB_LEVELS = array.from(-0.618, -0.25, 0.0, 0.25, 0.382, 0.5, 0.618, 0.786, 1.0, 1.25, 1.618)
var array<string> FIB_NAMES  = array.from("-0.618", "-0.25", "0", "0.25", "0.382", "0.5", "0.618", "0.786", "1", "1.25", "1.618")
var array<color>  FIB_COLORS = array.from(clrNeg618Input, clrNeg025Input, clr0Input, clr236Input, clr382Input, clr500Input, clr618Input, clr786Input, clr100Input, clr128Input, clr1618Input)

// Line style mapping
string fibLineStyle =
     lineStyleInput == "Dashed" ? line.style_dashed :
     lineStyleInput == "Dotted" ? line.style_dotted :
     line.style_solid

// ─── Drawing Storage ─────────────────────────────────────────────────────────
var array<line>     gLines  = array.new<line>()
var array<label>    gLabels = array.new<label>()
var array<linefill> gFills  = array.new<linefill>()

// ─── Anchor State (last engulfing HA candle on anchor TF) ────────────────────
var float anchorHigh   = na
var float anchorLow    = na
var float anchorOpen   = na
var float anchorClose  = na
var int   anchorTime   = na
var bool  anchorIsBull = false

// Detect bullish / bearish HA candles and engulfing conditions on closed bars
bool tfBullNow = tfC > tfO
bool tfBearNow = tfC < tfO

// Bullish engulf: current HA candle closes above previous HA high
bool bullEngulf = tfBullNow and tfC > tfH[1]
// Bearish engulf: current HA candle closes below previous HA low
bool bearEngulf = tfBearNow and tfC < tfL[1]

if bullEngulf or bearEngulf
    anchorHigh   := tfH
    anchorLow    := tfL
    anchorOpen   := tfO
    anchorClose  := tfC
    anchorTime   := tfT
    anchorIsBull := bullEngulf

// ─── Time calculations ───────────────────────────────────────────────────────
// Right edge always advances with the current anchor-TF bar:
// we extend from the engulfing candle's open time out to
// (current anchor-TF bar + N more anchor-TF bars), where N = extendCandlesInput.
int anchorTfSec = timeframe.in_seconds(anchorTfInput)
int rightTime   = na(curTfT) ? na : curTfT + anchorTfSec * 1000 * extendCandlesInput

// ─── Fib Price Calculation (symmetric extensions) ────────────────────────────
// 0 = low, 1 = high on the anchor candle.
// Negative levels (e.g. -0.25, -0.618) are always BELOW the low.
// Levels > 1 (e.g. 1.25, 1.618) are always ABOVE the high.
fibPrice(float haH, float haL, float level) =>
    float rng   = haH - haL
    float price = haL + level * rng
    price

// ─── Draw Fib Set from Anchor Candle ─────────────────────────────────────────
drawAnchorFibs() =>
    int drawn = 0
    if not na(anchorHigh) and not na(anchorLow) and anchorHigh > anchorLow and not na(anchorTime) and not na(rightTime)
        int x1     = anchorTime
        int x2     = rightTime
        int labelX = labelsAtOrigin ? x1 : x2
        string labelAlign = labelsAtOrigin ? text.align_right : text.align_left
        int startLineIdx = array.size(gLines)
        for i = 0 to 10
            float level = array.get(FIB_LEVELS, i)
            float price = fibPrice(anchorHigh, anchorLow, level)
            color clr   = color.new(array.get(FIB_COLORS, i), lineTranspInput)
            line ln = line.new(x1, price, x2, price, xloc = xloc.bar_time, color = clr, style = fibLineStyle, width = lineWidthInput)
            array.push(gLines, ln)
            if showLabelsInput
                string lblTxt = "HA " + anchorTfInput + " " + array.get(FIB_NAMES, i)
                if showPricesInput
                    lblTxt := lblTxt + "  " + str.tostring(price, format.mintick)
                label lbl = label.new(labelX, price, lblTxt, xloc = xloc.bar_time, style = label.style_none, textcolor = clr, size = size.small, textalign = labelAlign)
                array.push(gLabels, lbl)
            drawn += 1
        // Golden zone fill between 0.5 (index 5) and 0.618 (index 6)
        if showGoldenInput
            line ln50  = array.get(gLines, startLineIdx + 5)
            line ln618 = array.get(gLines, startLineIdx + 6)
            linefill gzFill = linefill.new(ln50, ln618, goldenColorInput)
            array.push(gFills, gzFill)
    drawn

// ─── Main Drawing Logic (last bar only) ──────────────────────────────────────
if barstate.islast
    int lnSz = array.size(gLines)
    if lnSz > 0
        for i = 0 to lnSz - 1
            line.delete(array.get(gLines, i))
        array.clear(gLines)
    int lbSz = array.size(gLabels)
    if lbSz > 0
        for i = 0 to lbSz - 1
            label.delete(array.get(gLabels, i))
        array.clear(gLabels)
    int flSz = array.size(gFills)
    if flSz > 0
        for i = 0 to flSz - 1
            linefill.delete(array.get(gFills, i))
        array.clear(gFills)

    drawAnchorFibs()

