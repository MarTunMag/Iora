grpM30 = "M30 Style"
m30FillRise  = input.color(color.new(#009688, 88), "Fill ↑",   group=grpM30)
m30FillFall  = input.color(color.new(#CDDC39, 88), "Fill ↓",   group=grpM30)
m30Border    = input.color(color.new(color.gray, 70), "Border", group=grpM30)
m30ShowWicks = input.bool(true, "Show Wicks", group=grpM30)
m30WickCol   = input.color(color.new(color.gray, 65), "Wick Color", group=grpM30)
m30WickW     = input.int(1, "Wick Width", minval=1, maxval=10, group=grpM30)
