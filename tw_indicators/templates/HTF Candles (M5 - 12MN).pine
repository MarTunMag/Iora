indicator("[BASE] HTF Candles (M5 -> 12MN)", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=100)

// ═════════════════════════════════════════════════════════════════════════════
// 1. CONFIGURATION
// ═════════════════════════════════════════════════════════════════════════════
groupG = "General"
show12M = input.bool(true,  "Show 12 Months (Yearly)", group=groupG)
show6M  = input.bool(true,  "Show 6 Months", group=groupG)
show3M  = input.bool(true,  "Show 3 Months (Quarterly)", group=groupG)
showM   = input.bool(true,  "Show Monthly", group=groupG)
showW   = input.bool(true,  "Show Weekly",  group=groupG)
showD   = input.bool(true,  "Show Daily",   group=groupG)
showH4  = input.bool(true,  "Show 4H",      group=groupG)
showH1  = input.bool(false, "Show 1H",      group=groupG)
showM30 = input.bool(false, "Show 30m",     group=groupG)
showM15 = input.bool(false, "Show 15m",     group=groupG)
showM5  = input.bool(false, "Show 5m",      group=groupG)

// History Settings
yearsBack   = input.int(10, "Super Macro History (Years)", minval=1, maxval=50, tooltip="History for 12M, 6M, 3M", group=groupG)
monthsBack  = input.int(12, "Standard History (Months)", minval=1, maxval=60, tooltip="History for M, W, D, etc.", group=groupG)
autoKeep    = input.bool(true, "Auto-calculate History Limits", group=groupG)
offsetBars  = input.int(0, "Shift all candles (bars)", minval=-500, maxval=500, group=groupG)

// Badge behavior
pushBadgesRight       = input.bool(true, "Push badges right of candle", group=groupG)
badgeRightExtraBars   = input.int(20, "Badge extra bars to right", minval=0, maxval=300, group=groupG)
labelMinGapBars       = input.int(3, "Min label gap (bars)", minval=0, maxval=50, group=groupG)
badgeBgAlpha          = input.int(92, "Badge BG Opacity (0–100)", minval=0, maxval=100, group=groupG)
badgeTxtAlpha         = input.int(55, "Badge Text Opacity (0–100)", minval=0, maxval=100, group=groupG)
badgeXPadBars         = input.int(1, "Badge X offset (bars)", minval=0, maxval=5, group=groupG)
badgePadTicks         = input.int(1, "Badge Y offset (ticks)", minval=0, maxval=10, group=groupG)

// Manual limits (used if Auto is off)
yKeepManual   = input.int(10,    "12M history", minval=0, maxval=50, group=groupG)
s6KeepManual  = input.int(20,    "6M history",  minval=0, maxval=50, group=groupG)
q3KeepManual  = input.int(40,    "3M history",  minval=0, maxval=80, group=groupG)
mKeepManual   = input.int(12,    "Monthly history", minval=0, maxval=60, group=groupG)
wKeepManual   = input.int(24,    "Weekly history", minval=0, maxval=120,  group=groupG)
dKeepManual   = input.int(120,   "Daily history",  minval=0, maxval=400,  group=groupG)
h4KeepManual  = input.int(744,   "H4 history",     minval=0, maxval=5000, group=groupG)
h1KeepManual  = input.int(1488,  "H1 history",     minval=0, maxval=5000, group=groupG)
m30KeepManual = input.int(2000,  "M30 history",    minval=0, maxval=5000, group=groupG)
m15KeepManual = input.int(3000,  "M15 history",    minval=0, maxval=5000, group=groupG)
m5KeepManual  = input.int(5000,  "M5 history",     minval=0, maxval=5000, group=groupG)

h4Cap  = input.int(180,   "H4 history cap",  minval=10, maxval=1000, group=groupG)
h1Cap  = input.int(360,   "H1 history cap",  minval=10, maxval=1000, group=groupG)
m30Cap = input.int(720,   "M30 history cap", minval=10, maxval=1000, group=groupG)
m15Cap = input.int(1000,  "M15 history cap", minval=10, maxval=2000, group=groupG)
m5Cap  = input.int(1500,  "M5 history cap",  minval=10, maxval=3000, group=groupG)

// Derived sizes (Logic Split: Years for Macro, Months for Standard)
yKeep = autoKeep ? yearsBack : yKeepManual
s6Keep = autoKeep ? yearsBack * 2 : s6KeepManual
q3Keep = autoKeep ? yearsBack * 4 : q3KeepManual

mKeep = autoKeep ? monthsBack : mKeepManual
wKeep = autoKeep ? monthsBack * 5 : wKeepManual // approx 4.3 weeks/month
dKeep = autoKeep ? monthsBack * 23 : dKeepManual // trading days
h4KeepRaw = autoKeep ? monthsBack * 23 * 6 : h4KeepManual
h1KeepRaw = autoKeep ? monthsBack * 23 * 24 : h1KeepManual
m30KeepRaw = autoKeep ? monthsBack * 23 * 48 : m30KeepManual
m15KeepRaw = autoKeep ? monthsBack * 23 * 96 : m15KeepManual
m5KeepRaw = autoKeep ? monthsBack * 23 * 288 : m5KeepManual

h4Keep = math.min(h4KeepRaw, h4Cap)
h1Keep = math.min(h1KeepRaw, h1Cap)
m30Keep = math.min(m30KeepRaw, m30Cap)
m15Keep = math.min(m15KeepRaw, m15Cap)
m5Keep = math.min(m5KeepRaw, m5Cap)

