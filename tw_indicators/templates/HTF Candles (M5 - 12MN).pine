m5ShowBadge = input.bool(true, "Show Badge", group=grpM5)


// === Helpers
barMs    = time_close - time
// Removed the projection cap for the ACTIVE candle to ensure it extends to true time_close
// Use a safe cap only for Labels to avoid rendering errors if far future
safeLabelCap  = 500 
offsetMs = offsetBars * barMs
padMs    = badgeXPadBars * barMs

f_right_cap_label(rightTime) =>
    cap = time + safeLabelCap * barMs
    rightTime > cap ? cap : rightTime

f_dir_fill(falling, cDown, cUp) =>
    falling ? cDown : cUp

f_badge_xy(o, h, l, c, rightT, dir) =>
    d = dir != 0 ? dir : (c >= o ? 1 : -1)
    yy = d == 1 ? (h + badgePadTicks * syminfo.mintick) : (l - badgePadTicks * syminfo.mintick)
    rightBase = rightT + (pushBadgesRight ? badgeRightExtraBars * barMs : 0)
    xx = f_right_cap_label(rightBase + padMs)
    sty = d == 1 ? label.style_label_down : label.style_label_up
    [xx, yy, sty]

// Extended Separator for up to 11 layers
f_sep(float x, float a, float b, float c, float d, float e, float f, float g, float h, float i, float j) =>
    gapMs = labelMinGapBars * barMs
    res = x
    if not na(a) and res < a + gapMs
        res := a + gapMs
    if not na(b) and res < b + gapMs
        res := b + gapMs
    if not na(c) and res < c + gapMs
        res := c + gapMs
    if not na(d) and res < d + gapMs
        res := d + gapMs
    if not na(e) and res < e + gapMs
        res := e + gapMs
    if not na(f) and res < f + gapMs
        res := f + gapMs
    if not na(g) and res < g + gapMs
        res := g + gapMs
    if not na(h) and res < h + gapMs
        res := h + gapMs
    if not na(i) and res < i + gapMs
        res := i + gapMs
    if not na(j) and res < j + gapMs
        res := j + gapMs
    f_right_cap_label(res)

f_hist_push_with_wicks(arrB, arrWT, arrWB, keep, leftT, rightT, o, h, l, c, fillUp, fillDn, borderCol, wickCol, wickW, drawWicks) =>
    if keep > 0
        bxx = box.new(left=leftT, right=rightT, top=math.max(o, c), bottom=math.min(o, c),
                      xloc=xloc.bar_time, bgcolor=f_dir_fill(o > c, fillDn, fillUp),
                      border_color=borderCol, border_width=1)
        array.push(arrB, bxx)
        if drawWicks
            midT = leftT + math.round_to_mintick((rightT - leftT) / 2)
            topBody = math.max(o, c)
            botBody = math.min(o, c)
            wTop = line.new(int(midT), h, int(midT), topBody, xloc=xloc.bar_time, width=wickW, color=wickCol)
            wBot = line.new(int(midT), botBody, int(midT), l, xloc=xloc.bar_time, width=wickW, color=wickCol)
            array.push(arrWT, wTop)
            array.push(arrWB, wBot)
    while array.size(arrB) > keep
        box.delete(array.shift(arrB))
    while array.size(arrWT) > keep
        line.delete(array.shift(arrWT))
    while array.size(arrWB) > keep
        line.delete(array.shift(arrWB))

f_hist_clear_all(arrB, arrWT, arrWB) =>
    while array.size(arrB) > 0
        box.delete(array.shift(arrB))
    while array.size(arrWT) > 0
        line.delete(array.shift(arrWT))
    while array.size(arrWB) > 0
        line.delete(array.shift(arrWB))

f_hist_trim_all(arrB, arrWT, arrWB, keep) =>
    while array.size(arrB) > keep
        box.delete(array.shift(arrB))
    while array.size(arrWT) > keep
        line.delete(array.shift(arrWT))
    while array.size(arrWB) > keep
        line.delete(array.shift(arrWB))

////////////////////////////////////////////////////////////////////////////////
// === 12M (Yearly)
var box yBody = na, var line yUp = na, var line yLo = na, var label yBad = na
var int yDir = 0, var float yPrevH = na, var float yPrevL = na
var yHistB = array.new<box>(), var yHistWT = array.new<line>(), var yHistWB = array.new<line>(), var float yLblX = na

if show12M
    [yo, yh, yl, yc, yt, ytc] = request.security(syminfo.tickerid, "12M", [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)

    if ta.change(yt) != 0
        // History: Use ytc[1] (Closing time of previous bar)
        f_hist_push_with_wicks(yHistB, yHistWT, yHistWB, yKeep, yt[1] + offsetMs, ytc[1] + offsetMs, yo[1], yh[1], yl[1], yc[1], yFillRise, yFillFall, yBorder, yWickCol, yWickW, yShowWicks)

    yDir := na(yPrevH) or yh != yPrevH ? 1 : (na(yPrevL) or yl != yPrevL ? (yDir != 0 ? yDir : -1) : yDir)
    yPrevH := yh
    yPrevL := yl

    // Current Bar: Extend to true closing time (ytc)
    leftT = yt + offsetMs, rgtT = ytc + offsetMs, midT = int(leftT + (rgtT - leftT) / 2)

    if na(yBody)
        yBody := box.new(leftT, math.max(yo, yc), rgtT, math.min(yo, yc), xloc=xloc.bar_time, bgcolor=f_dir_fill(yo > yc, yFillFall, yFillRise), border_color=yBorder)
    box.set_lefttop(yBody, leftT, math.max(yo, yc))
    box.set_rightbottom(yBody, rgtT, math.min(yo, yc))
    box.set_bgcolor(yBody, f_dir_fill(yo > yc, yFillFall, yFillRise))

    if yShowWicks
        if na(yUp)
            yUp := line.new(midT, yh, midT, math.max(yo, yc), xloc=xloc.bar_time, width=yWickW, color=yWickCol)
            yLo := line.new(midT, math.min(yo, yc), midT, yl, xloc=xloc.bar_time, width=yWickW, color=yWickCol)
        else
            line.set_xy1(yUp, midT, yh)
            line.set_xy2(yUp, midT, math.max(yo, yc))
            line.set_xy1(yLo, midT, math.min(yo, yc))
            line.set_xy2(yLo, midT, yl)
    else if not na(yUp)
        line.delete(yUp)
        line.delete(yLo)
        yUp := na
        yLo := na
        
    if yShowBadge
        [bxY0, byY, stY] = f_badge_xy(yo, yh, yl, yc, rgtT, yDir)
        yLblX := f_sep(bxY0, na, na, na, na, na, na, na, na, na, na)
        if na(yBad)
            yBad := label.new(int(yLblX), byY, "12M", xloc=xloc.bar_time, yloc=yloc.price, style=stY, textcolor=color.new(color.white, badgeTxtAlpha), color=color.new(color.black, badgeBgAlpha), size=size.tiny)
        else
            label.set_xy(yBad, int(yLblX), byY)
            label.set_style(yBad, stY)
    else if not na(yBad)
        label.delete(yBad)
        yBad := na
        yLblX := na

    f_hist_trim_all(yHistB, yHistWT, yHistWB, yKeep)
else
    if not na(yBody)
        box.delete(yBody)
        line.delete(yUp)
        line.delete(yLo)
        label.delete(yBad)
        yBody := na, yUp := na, yLo := na, yBad := na, yLblX := na
    f_hist_clear_all(yHistB, yHistWT, yHistWB)

////////////////////////////////////////////////////////////////////////////////
// === 6M (6-Month)
var box s6Body = na, var line s6Up = na, var line s6Lo = na, var label s6Bad = na
var int s6Dir = 0, var float s6PrevH = na, var float s6PrevL = na
var s6HistB = array.new<box>(), var s6HistWT = array.new<line>(), var s6HistWB = array.new<line>(), var float s6LblX = na

if show6M
    [s6o, s6h, s6l, s6c, s6t, s6tc] = request.security(syminfo.tickerid, "6M", [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)

    if ta.change(s6t) != 0
        f_hist_push_with_wicks(s6HistB, s6HistWT, s6HistWB, s6Keep, s6t[1] + offsetMs, s6tc[1] + offsetMs, s6o[1], s6h[1], s6l[1], s6c[1], s6FillRise, s6FillFall, s6Border, s6WickCol, s6WickW, s6ShowWicks)

    s6Dir := na(s6PrevH) or s6h != s6PrevH ? 1 : (na(s6PrevL) or s6l != s6PrevL ? (s6Dir != 0 ? s6Dir : -1) : s6Dir)
    s6PrevH := s6h
    s6PrevL := s6l

    leftT = s6t + offsetMs, rgtT = s6tc + offsetMs, midT = int(leftT + (rgtT - leftT) / 2)

    if na(s6Body)
        s6Body := box.new(leftT, math.max(s6o, s6c), rgtT, math.min(s6o, s6c), xloc=xloc.bar_time, bgcolor=f_dir_fill(s6o > s6c, s6FillFall, s6FillRise), border_color=s6Border)
    box.set_lefttop(s6Body, leftT, math.max(s6o, s6c))
    box.set_rightbottom(s6Body, rgtT, math.min(s6o, s6c))
    box.set_bgcolor(s6Body, f_dir_fill(s6o > s6c, s6FillFall, s6FillRise))

    if s6ShowWicks
        if na(s6Up)
            s6Up := line.new(midT, s6h, midT, math.max(s6o, s6c), xloc=xloc.bar_time, width=s6WickW, color=s6WickCol)
            s6Lo := line.new(midT, math.min(s6o, s6c), midT, s6l, xloc=xloc.bar_time, width=s6WickW, color=s6WickCol)
        else
            line.set_xy1(s6Up, midT, s6h)
            line.set_xy2(s6Up, midT, math.max(s6o, s6c))
            line.set_xy1(s6Lo, midT, math.min(s6o, s6c))
            line.set_xy2(s6Lo, midT, s6l)
    else if not na(s6Up)
        line.delete(s6Up)
        line.delete(s6Lo)
        s6Up := na
        s6Lo := na
        
    if s6ShowBadge
        [bxS60, byS6, stS6] = f_badge_xy(s6o, s6h, s6l, s6c, rgtT, s6Dir)
        s6LblX := f_sep(bxS60, yLblX, na, na, na, na, na, na, na, na, na)
        if na(s6Bad)
            s6Bad := label.new(int(s6LblX), byS6, "6M", xloc=xloc.bar_time, yloc=yloc.price, style=stS6, textcolor=color.new(color.white, badgeTxtAlpha), color=color.new(color.black, badgeBgAlpha), size=size.tiny)
        else
            label.set_xy(s6Bad, int(s6LblX), byS6)
            label.set_style(s6Bad, stS6)
    else if not na(s6Bad)
        label.delete(s6Bad)
        s6Bad := na
        s6LblX := na

