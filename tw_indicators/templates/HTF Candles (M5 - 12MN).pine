grpM15 = "M15 Style"
m15FillRise  = input.color(color.new(#FFC107, 88), "Fill ↑",   group=grpM15)
m15FillFall  = input.color(color.new(#FF9800, 88), "Fill ↓",   group=grpM15)
m15Border    = input.color(color.new(color.gray, 70), "Border", group=grpM15)
m15ShowWicks = input.bool(true, "Show Wicks", group=grpM15)
