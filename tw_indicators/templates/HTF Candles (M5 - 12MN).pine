grpM5 = "M5 Style"
m5FillRise  = input.color(color.new(#795548, 88), "Fill ↑",   group=grpM5)
m5FillFall  = input.color(color.new(#9E9E9E, 88), "Fill ↓",   group=grpM5)
m5Border    = input.color(color.new(color.gray, 70), "Border", group=grpM5)
m5ShowWicks = input.bool(true, "Show Wicks", group=grpM5)
m5WickCol   = input.color(color.new(color.gray, 65), "Wick Color", group=grpM5)
