// --- D EW state ---
var int   d_ew_phase    = 0
var int   d_ew_imp_cnt  = 0
var int   d_ew_cor_cnt  = 0
var float d_ew_b_w1_top = na
var float d_ew_b_w1_bot = na
var float d_ew_b_w2_bot = na
var float d_ew_b_w3_top = na
var float d_ew_b_w4_bot = na
var float d_ew_b_w5_top = na
var float d_ew_s_w1_bot = na
var float d_ew_s_w1_top = na
var float d_ew_s_w2_top = na
var float d_ew_s_w3_bot = na
var float d_ew_s_w4_top = na
var float d_ew_s_w5_bot = na
var float d_ew_cor_start = na
var float d_ew_cor_a     = na
var float d_ew_cor_b     = na
var float d_ew_cor_c     = na
var bool  d_ew_cor_bull  = false
var int   d_ew_pattern   = 0

if d_fired
    if d_ew_phase == 0
        if d_swc == 1
            d_ew_phase   := 1
            d_ew_imp_cnt := 1
            d_ew_b_w1_bot := d_plo
            d_ew_b_w1_top := d_phi
        else if d_swc == 3
            d_ew_phase   := 3
            d_ew_imp_cnt := 1
            d_ew_s_w1_top := d_phi
            d_ew_s_w1_bot := d_plo
    else if d_ew_phase == 1
        if d_swc == 1
            d_ew_imp_cnt := d_ew_imp_cnt + 1
            if d_ew_imp_cnt == 3
                d_ew_b_w3_top := d_phi
            else if d_ew_imp_cnt == 5
                d_ew_b_w5_top := d_phi
        else if d_swc == 4
            if d_ew_imp_cnt == 1
                d_ew_b_w2_bot := d_plo
            else if d_ew_imp_cnt == 3
                d_ew_b_w4_bot := d_plo
        else if d_swc == 2
            d_ew_phase   := 2
            d_ew_cor_cnt := 1
            d_ew_cor_start := d_phi
            d_ew_cor_bull  := false
        else if d_swc == 3
            d_ew_phase   := 3
            d_ew_imp_cnt := 1
            d_ew_s_w1_top := d_phi
            d_ew_s_w1_bot := d_plo
    else if d_ew_phase == 2
        if d_swc == 1
            d_ew_phase   := 1
            d_ew_imp_cnt := 1
            d_ew_b_w1_bot := d_plo
            d_ew_b_w1_top := d_phi
        else if d_swc == 2 or d_swc == 4
            d_ew_cor_cnt := d_ew_cor_cnt + 1
            if d_ew_cor_cnt == 1
                d_ew_cor_a := d_swc == 2 ? d_phi : d_plo
            else if d_ew_cor_cnt == 2
                d_ew_cor_b := d_swc == 4 ? d_plo : d_phi
            else if d_ew_cor_cnt == 3
                d_ew_cor_c := d_swc == 2 ? d_phi : d_plo
        else if d_swc == 3
            d_ew_phase   := 3
            d_ew_imp_cnt := 1
            d_ew_s_w1_top := d_phi
            d_ew_s_w1_bot := d_plo
    else if d_ew_phase == 3
        if d_swc == 3
            d_ew_imp_cnt := d_ew_imp_cnt + 1
            if d_ew_imp_cnt == 3
                d_ew_s_w3_bot := d_plo
            else if d_ew_imp_cnt == 5
                d_ew_s_w5_bot := d_plo
        else if d_swc == 2
            if d_ew_imp_cnt == 1
                d_ew_s_w2_top := d_phi
            else if d_ew_imp_cnt == 3
                d_ew_s_w4_top := d_phi
        else if d_swc == 4
            d_ew_phase   := 4
            d_ew_cor_cnt := 1
            d_ew_cor_start := d_plo
            d_ew_cor_bull  := true
        else if d_swc == 1
            d_ew_phase   := 1
            d_ew_imp_cnt := 1
            d_ew_b_w1_bot := d_plo
            d_ew_b_w1_top := d_phi
    else if d_ew_phase == 4
        if d_swc == 3
            d_ew_phase   := 3
            d_ew_imp_cnt := 1
            d_ew_s_w1_top := d_phi
            d_ew_s_w1_bot := d_plo
        else if d_swc == 4 or d_swc == 2
            d_ew_cor_cnt := d_ew_cor_cnt + 1
            if d_ew_cor_cnt == 1
                d_ew_cor_a := d_swc == 4 ? d_plo : d_phi
            else if d_ew_cor_cnt == 2
                d_ew_cor_b := d_swc == 2 ? d_phi : d_plo
            else if d_ew_cor_cnt == 3
                d_ew_cor_c := d_swc == 4 ? d_plo : d_phi
        else if d_swc == 1
            d_ew_phase   := 1
            d_ew_imp_cnt := 1
            d_ew_b_w1_bot := d_plo
            d_ew_b_w1_top := d_phi

// =============================================================================
// === SECTION 9: PATTERN CLASSIFICATION + EXHAUSTION THRESHOLD
// =============================================================================

// Pattern codes: 0=NONE, 1=IMP, 2=DIAG, 3=EXT, 4=REG_FLAT, 5=EXP_FLAT, 6=RUN_FLAT, 7=ZZG, 8=DBL_ZZG, 9=TRI

// --- M15 pattern ---
if m15_ew_phase == 1 or m15_ew_phase == 3
    bool m15_w4_ov_w1 = (not na(m15_ew_b_w4_bot) and not na(m15_ew_b_w1_top) and m15_ew_b_w4_bot < m15_ew_b_w1_top)
    bool m15_w3_ext   = (not na(m15_ew_b_w3_top) and not na(m15_ew_b_w1_top) and not na(m15_ew_b_w1_bot) and (m15_ew_b_w3_top - nz(m15_ew_b_w2_bot, m15_ew_b_w1_bot)) > 1.618 * (m15_ew_b_w1_top - m15_ew_b_w1_bot))
    m15_ew_pattern := m15_w4_ov_w1 ? 2 : (m15_w3_ext ? 3 : 1)
else if m15_ew_phase == 2 or m15_ew_phase == 4
    if not na(m15_ew_cor_a) and not na(m15_ew_cor_b) and not na(m15_ew_cor_c)
        float m15_ab = math.abs(nz(m15_ew_cor_b) - nz(m15_ew_cor_a))
        float m15_bc = math.abs(nz(m15_ew_cor_c) - nz(m15_ew_cor_b))
        float m15_ac = math.abs(nz(m15_ew_cor_c) - nz(m15_ew_cor_a))
        bool m15_c_eq_a  = m15_ac < m15_ab * 0.1
        bool m15_c_gt_a  = m15_ac > m15_ab * 1.1
        bool m15_b_gt_a  = m15_ab > 0.0 and m15_bc > m15_ab
        m15_ew_pattern := m15_c_eq_a ? 4 : (m15_c_gt_a and m15_b_gt_a ? 5 : (m15_b_gt_a ? 6 : 7))
    else
        m15_ew_pattern := 0

// --- H1 pattern ---
if h1_ew_phase == 1 or h1_ew_phase == 3
    bool h1_w4_ov_w1 = (not na(h1_ew_b_w4_bot) and not na(h1_ew_b_w1_top) and h1_ew_b_w4_bot < h1_ew_b_w1_top)
    bool h1_w3_ext   = (not na(h1_ew_b_w3_top) and not na(h1_ew_b_w1_top) and not na(h1_ew_b_w1_bot) and (h1_ew_b_w3_top - nz(h1_ew_b_w2_bot, h1_ew_b_w1_bot)) > 1.618 * (h1_ew_b_w1_top - h1_ew_b_w1_bot))
    h1_ew_pattern := h1_w4_ov_w1 ? 2 : (h1_w3_ext ? 3 : 1)
else if h1_ew_phase == 2 or h1_ew_phase == 4
    if not na(h1_ew_cor_a) and not na(h1_ew_cor_b) and not na(h1_ew_cor_c)
        float h1_ab = math.abs(nz(h1_ew_cor_b) - nz(h1_ew_cor_a))
        float h1_bc = math.abs(nz(h1_ew_cor_c) - nz(h1_ew_cor_b))
        float h1_ac = math.abs(nz(h1_ew_cor_c) - nz(h1_ew_cor_a))
        bool h1_c_eq_a  = h1_ac < h1_ab * 0.1
        bool h1_c_gt_a  = h1_ac > h1_ab * 1.1
        bool h1_b_gt_a  = h1_ab > 0.0 and h1_bc > h1_ab
        h1_ew_pattern := h1_c_eq_a ? 4 : (h1_c_gt_a and h1_b_gt_a ? 5 : (h1_b_gt_a ? 6 : 7))
    else
        h1_ew_pattern := 0

// --- H4 pattern ---
if h4_ew_phase == 1 or h4_ew_phase == 3
    bool h4_w4_ov_w1 = (not na(h4_ew_b_w4_bot) and not na(h4_ew_b_w1_top) and h4_ew_b_w4_bot < h4_ew_b_w1_top)
    bool h4_w3_ext   = (not na(h4_ew_b_w3_top) and not na(h4_ew_b_w1_top) and not na(h4_ew_b_w1_bot) and (h4_ew_b_w3_top - nz(h4_ew_b_w2_bot, h4_ew_b_w1_bot)) > 1.618 * (h4_ew_b_w1_top - h4_ew_b_w1_bot))
    h4_ew_pattern := h4_w4_ov_w1 ? 2 : (h4_w3_ext ? 3 : 1)
else if h4_ew_phase == 2 or h4_ew_phase == 4
    if not na(h4_ew_cor_a) and not na(h4_ew_cor_b) and not na(h4_ew_cor_c)
        float h4_ab = math.abs(nz(h4_ew_cor_b) - nz(h4_ew_cor_a))
        float h4_bc = math.abs(nz(h4_ew_cor_c) - nz(h4_ew_cor_b))
        float h4_ac = math.abs(nz(h4_ew_cor_c) - nz(h4_ew_cor_a))
        bool h4_c_eq_a  = h4_ac < h4_ab * 0.1
        bool h4_c_gt_a  = h4_ac > h4_ab * 1.1
        bool h4_b_gt_a  = h4_ab > 0.0 and h4_bc > h4_ab
        h4_ew_pattern := h4_c_eq_a ? 4 : (h4_c_gt_a and h4_b_gt_a ? 5 : (h4_b_gt_a ? 6 : 7))
    else
        h4_ew_pattern := 0

// --- D pattern ---
if d_ew_phase == 1 or d_ew_phase == 3
    bool d_w4_ov_w1 = (not na(d_ew_b_w4_bot) and not na(d_ew_b_w1_top) and d_ew_b_w4_bot < d_ew_b_w1_top)
    bool d_w3_ext   = (not na(d_ew_b_w3_top) and not na(d_ew_b_w1_top) and not na(d_ew_b_w1_bot) and (d_ew_b_w3_top - nz(d_ew_b_w2_bot, d_ew_b_w1_bot)) > 1.618 * (d_ew_b_w1_top - d_ew_b_w1_bot))
    d_ew_pattern := d_w4_ov_w1 ? 2 : (d_w3_ext ? 3 : 1)
else if d_ew_phase == 2 or d_ew_phase == 4
    if not na(d_ew_cor_a) and not na(d_ew_cor_b) and not na(d_ew_cor_c)
        float d_ab = math.abs(nz(d_ew_cor_b) - nz(d_ew_cor_a))
        float d_bc = math.abs(nz(d_ew_cor_c) - nz(d_ew_cor_b))
        float d_ac = math.abs(nz(d_ew_cor_c) - nz(d_ew_cor_a))
        bool d_c_eq_a  = d_ac < d_ab * 0.1
        bool d_c_gt_a  = d_ac > d_ab * 1.1
        bool d_b_gt_a  = d_ab > 0.0 and d_bc > d_ab
        d_ew_pattern := d_c_eq_a ? 4 : (d_c_gt_a and d_b_gt_a ? 5 : (d_b_gt_a ? 6 : 7))
    else
        d_ew_pattern := 0

// --- Dynamic exhaustion thresholds ---
int m15_ew_thr = m15_ew_pattern == 2 ? 4 : (m15_ew_pattern == 3 ? 8 : 5)
int h1_ew_thr  = h1_ew_pattern  == 2 ? 4 : (h1_ew_pattern  == 3 ? 8 : 5)
int h4_ew_thr  = h4_ew_pattern  == 2 ? 4 : (h4_ew_pattern  == 3 ? 8 : 5)
int d_ew_thr   = d_ew_pattern   == 2 ? 4 : (d_ew_pattern   == 3 ? 8 : 5)

// =============================================================================
// === SECTION 10: EW WAVE LABELS (optional, muxed to i_swing_tf)
// =============================================================================

// Resolve which EW state to use for labels based on i_swing_tf
// swc label text helper
ew_wave_lbl(int phase, int imp_cnt, int cor_cnt) =>
    string lbl = ""
    if phase == 1
        lbl := imp_cnt == 1 ? "W1" : (imp_cnt == 2 ? "W2" : (imp_cnt == 3 ? "W3" : (imp_cnt == 4 ? "W4" : "W5")))
    else if phase == 3
        lbl := imp_cnt == 1 ? "W1" : (imp_cnt == 2 ? "W2" : (imp_cnt == 3 ? "W3" : (imp_cnt == 4 ? "W4" : "W5")))
    else if phase == 2 or phase == 4
        lbl := cor_cnt == 1 ? "A" : (cor_cnt == 2 ? "B" : "C")
    lbl

if i_ew_labels
    int   ew_lbl_phase   = 0
    int   ew_lbl_imp_cnt = 0
    int   ew_lbl_cor_cnt = 0
    bool  ew_lbl_fired   = false
    int   ew_lbl_swc     = 0
    float ew_lbl_price   = na
    if i_swing_tf == "M15"
        ew_lbl_phase   := m15_ew_phase
        ew_lbl_imp_cnt := m15_ew_imp_cnt
        ew_lbl_cor_cnt := m15_ew_cor_cnt
        ew_lbl_fired   := m15_fired
        ew_lbl_swc     := m15_swc
        ew_lbl_price   := m15_swc == 1 or m15_swc == 2 ? m15_phi : m15_plo
    else if i_swing_tf == "H1"
        ew_lbl_phase   := h1_ew_phase
        ew_lbl_imp_cnt := h1_ew_imp_cnt
        ew_lbl_cor_cnt := h1_ew_cor_cnt
        ew_lbl_fired   := h1_fired
        ew_lbl_swc     := h1_swc
        ew_lbl_price   := h1_swc == 1 or h1_swc == 2 ? h1_phi : h1_plo
    else if i_swing_tf == "H4"
        ew_lbl_phase   := h4_ew_phase
        ew_lbl_imp_cnt := h4_ew_imp_cnt
        ew_lbl_cor_cnt := h4_ew_cor_cnt
        ew_lbl_fired   := h4_fired
        ew_lbl_swc     := h4_swc
        ew_lbl_price   := h4_swc == 1 or h4_swc == 2 ? h4_phi : h4_plo
    else if i_swing_tf == "D"
        ew_lbl_phase   := d_ew_phase
        ew_lbl_imp_cnt := d_ew_imp_cnt
        ew_lbl_cor_cnt := d_ew_cor_cnt
        ew_lbl_fired   := d_fired
        ew_lbl_swc     := d_swc
        ew_lbl_price   := d_swc == 1 or d_swc == 2 ? d_phi : d_plo
    if ew_lbl_fired and ew_lbl_phase > 0 and not na(ew_lbl_price)
        string ew_txt  = ew_wave_lbl(ew_lbl_phase, ew_lbl_imp_cnt, ew_lbl_cor_cnt)
        bool   is_high = ew_lbl_swc == 1 or ew_lbl_swc == 2
        if str.length(ew_txt) > 0
            label.new(bar_index, ew_lbl_price, ew_txt, style=(is_high ? label.style_label_down : label.style_label_up), color=color.new(#7B1FA2, 80), textcolor=color.white, size=size.tiny)

// =============================================================================
// === SECTION 11: FIBONACCI PROJECTION LINES (optional)
// =============================================================================

if i_ew_fib and barstate.islast
    float fib_w1_bot = na
    float fib_w1_top = na
    float fib_w2_bot = na
    float fib_w4_bot = na
    int   fib_phase  = 0
    if i_swing_tf == "M15"
        fib_w1_bot := m15_ew_b_w1_bot
        fib_w1_top := m15_ew_b_w1_top
        fib_w2_bot := m15_ew_b_w2_bot
        fib_w4_bot := m15_ew_b_w4_bot
        fib_phase  := m15_ew_phase
    else if i_swing_tf == "H1"
        fib_w1_bot := h1_ew_b_w1_bot
        fib_w1_top := h1_ew_b_w1_top
        fib_w2_bot := h1_ew_b_w2_bot
        fib_w4_bot := h1_ew_b_w4_bot
        fib_phase  := h1_ew_phase
    else if i_swing_tf == "H4"
        fib_w1_bot := h4_ew_b_w1_bot
        fib_w1_top := h4_ew_b_w1_top
        fib_w2_bot := h4_ew_b_w2_bot
        fib_w4_bot := h4_ew_b_w4_bot
        fib_phase  := h4_ew_phase
    else if i_swing_tf == "D"
        fib_w1_bot := d_ew_b_w1_bot
        fib_w1_top := d_ew_b_w1_top
        fib_w2_bot := d_ew_b_w2_bot
        fib_w4_bot := d_ew_b_w4_bot
        fib_phase  := d_ew_phase
    if fib_phase == 1 and not na(fib_w1_top) and not na(fib_w1_bot)
        float fib_w1_range  = fib_w1_top - fib_w1_bot
        float fib_w3_tgt    = (not na(fib_w2_bot) ? fib_w2_bot : fib_w1_bot) + fib_w1_range * 1.618
        float fib_w5_tgt    = (not na(fib_w4_bot) ? fib_w4_bot : fib_w1_bot) + fib_w1_range
        line.new(bar_index - 5, fib_w3_tgt, bar_index + 5, fib_w3_tgt, color=color.new(#FF9800, 40), width=1, style=line.style_dashed)
        label.new(bar_index + 5, fib_w3_tgt, "W3 1.618", color=color.new(color.black, 100), textcolor=#FF9800, size=size.tiny, style=label.style_label_left)
        if not na(fib_w4_bot)
            line.new(bar_index - 5, fib_w5_tgt, bar_index + 5, fib_w5_tgt, color=color.new(#42A5F5, 40), width=1, style=line.style_dashed)
            label.new(bar_index + 5, fib_w5_tgt, "W5 1.0", color=color.new(color.black, 100), textcolor=#42A5F5, size=size.tiny, style=label.style_label_left)

// =============================================================================
// === SECTION 12: ENVELOPE LINES (optional debug)
// =============================================================================

float env_plot_ceil  = na
float env_plot_mid   = na
float env_plot_floor = na
if i_env_show
    if i_env_tf == "M5"
        env_plot_ceil  := m5_env_ceil
        env_plot_mid   := m5_env_mid
        env_plot_floor := m5_env_floor
    else if i_env_tf == "M15"
        env_plot_ceil  := m15_env_ceil
        env_plot_mid   := m15_env_mid
        env_plot_floor := m15_env_floor
    else if i_env_tf == "H1"
        env_plot_ceil  := h1_env_ceil
        env_plot_mid   := h1_env_mid
        env_plot_floor := h1_env_floor
    else if i_env_tf == "H4"
        env_plot_ceil  := h4_env_ceil
        env_plot_mid   := h4_env_mid
        env_plot_floor := h4_env_floor
    else if i_env_tf == "D"
        env_plot_ceil  := d_env_ceil
        env_plot_mid   := d_env_mid
        env_plot_floor := d_env_floor
    else if i_env_tf == "W"
        env_plot_ceil  := w_env_ceil
        env_plot_mid   := w_env_mid
        env_plot_floor := w_env_floor
    else if i_env_tf == "MN"
        env_plot_ceil  := mn_env_ceil
        env_plot_mid   := mn_env_mid
        env_plot_floor := mn_env_floor

plot(env_plot_ceil,  "Env Ceil",  color.new(#FF9800, 50), 1, plot.style_stepline)
plot(env_plot_mid,   "Env Mid",   color.new(#FFFFFF, 50), 1, plot.style_stepline)
plot(env_plot_floor, "Env Floor", color.new(#42A5F5, 50), 1, plot.style_stepline)

// =============================================================================
// === SECTION 13: DASHBOARD
// =============================================================================

// Helper: conviction string
conv_str(int cv) =>
    cv == 3 ? "STRG" : (cv == 2 ? "WEAK" : (cv == 1 ? "PRE" : "—"))

// Helper: health string
hlth_str(int h) =>
    h == 0 ? "OK" : (h == 1 ? "1st" : (h == 2 ? "DEG" : (h == 3 ? "BRK" : "—")))

// Helper: swing class string
swc_str(int sc) =>
    sc == 1 ? "HH" : (sc == 2 ? "LH" : (sc == 3 ? "LL" : (sc == 4 ? "HL" : "—")))

// Helper: direction arrow
dir_str(int d) =>
    d > 0 ? "▲" : (d < 0 ? "▼" : "—")

// Helper: EW wave label for phase/count
ew_cell(int phase, int imp_cnt, int cor_cnt) =>
    string s = ""
    if phase == 1
        s := imp_cnt == 1 ? "W1" : (imp_cnt == 2 ? "W2" : (imp_cnt == 3 ? "W3" : (imp_cnt == 4 ? "W4" : "W5")))
    else if phase == 3
        s := imp_cnt == 1 ? "W1" : (imp_cnt == 2 ? "W2" : (imp_cnt == 3 ? "W3" : (imp_cnt == 4 ? "W4" : "W5")))
    else if phase == 2 or phase == 4
        s := cor_cnt == 1 ? "A" : (cor_cnt == 2 ? "B" : "C")
    else
        s := "—"
    s

// Helper: pattern name
pat_str(int pat) =>
    pat == 1 ? "IMP" : (pat == 2 ? "DIAG" : (pat == 3 ? "EXT" : (pat == 4 ? "FLAT" : (pat == 5 ? "EXPF" : (pat == 6 ? "RUNF" : (pat == 7 ? "ZZG" : (pat == 8 ? "DZZG" : (pat == 9 ? "TRI" : "—"))))))))

// Helper: conviction color
conv_color(int cv, int sd) =>
    cv == 3 ? (sd > 0 ? color.new(#26A69A, 0) : color.new(#EF5350, 0)) : (cv == 2 ? color.new(#FFCA28, 30) : (cv == 1 ? color.new(#78909C, 40) : color.new(#37474F, 60)))

// Helper: health color
hlth_color(int h) =>
    h == 0 ? color.new(#26A69A, 20) : (h == 1 ? color.new(#FFCA28, 20) : (h == 2 ? color.new(#FF7043, 20) : color.new(#EF5350, 0)))

// Helper: exhaustion count/threshold with gradient color
exh_color(int cnt, int thr) =>
    float ratio = thr > 0 ? math.min(cnt / thr, 1.0) : 0.0
    int r = math.round(38 + ratio * (239 - 38))
    int g = math.round(166 - ratio * (166 - 83))
    int b = math.round(154 - ratio * (154 - 80))
    color.rgb(r, g, b)

// Dashboard table — build on last bar only
var table dash_tbl = na
if i_dash_on and barstate.islast
    string tbl_pos = switch i_dash_pos
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        => position.bottom_right

    dash_tbl := table.new(tbl_pos, 8, 8, bgcolor=color.new(#1A1A2E, 10), border_width=1, border_color=color.new(#3A3A5A, 50), frame_width=1, frame_color=color.new(#3A3A5A, 30))

    // Header row
    color hdr_bg  = color.new(#252540, 0)
    color hdr_txt = color.new(#B0BEC5, 0)
    string hdr_sz = size.small
    table.cell(dash_tbl, 0, 0, "TF",   text_color=hdr_txt, bgcolor=hdr_bg, text_size=hdr_sz)
    table.cell(dash_tbl, 1, 0, "Dir",  text_color=hdr_txt, bgcolor=hdr_bg, text_size=hdr_sz)
    table.cell(dash_tbl, 2, 0, "Swing",text_color=hdr_txt, bgcolor=hdr_bg, text_size=hdr_sz)
    table.cell(dash_tbl, 3, 0, "Conv", text_color=hdr_txt, bgcolor=hdr_bg, text_size=hdr_sz)
    table.cell(dash_tbl, 4, 0, "Hlth", text_color=hdr_txt, bgcolor=hdr_bg, text_size=hdr_sz)
    table.cell(dash_tbl, 5, 0, "EW",   text_color=hdr_txt, bgcolor=hdr_bg, text_size=hdr_sz)
    table.cell(dash_tbl, 6, 0, "Pat",  text_color=hdr_txt, bgcolor=hdr_bg, text_size=hdr_sz)
    table.cell(dash_tbl, 7, 0, "Exh",  text_color=hdr_txt, bgcolor=hdr_bg, text_size=hdr_sz)

    color cell_bg  = color.new(#1A1A2E, 20)
    string cell_sz = size.small

    // --- Row 1: M5 ---
    color m5_dir_clr = m5_dir > 0 ? color.new(#26A69A, 0) : (m5_dir < 0 ? color.new(#EF5350, 0) : color.new(#78909C, 0))
    table.cell(dash_tbl, 0, 1, "M5",            text_color=color.new(#78909C, 0), bgcolor=cell_bg,      text_size=cell_sz)
    table.cell(dash_tbl, 1, 1, dir_str(m5_dir), text_color=m5_dir_clr,            bgcolor=cell_bg,      text_size=cell_sz)
    table.cell(dash_tbl, 2, 1, swc_str(m5_lcls),text_color=color.new(#B0BEC5, 0), bgcolor=cell_bg,      text_size=cell_sz)
    table.cell(dash_tbl, 3, 1, conv_str(m5_cv) + (m5_sd > 0 ? "↑" : (m5_sd < 0 ? "↓" : "")), text_color=color.white, bgcolor=conv_color(m5_cv, m5_sd), text_size=cell_sz)
    table.cell(dash_tbl, 4, 1, hlth_str(m5_health), text_color=color.white, bgcolor=hlth_color(m5_health), text_size=cell_sz)
    table.cell(dash_tbl, 5, 1, "—",        text_color=color.new(#546E7A, 0), bgcolor=cell_bg,      text_size=cell_sz)
    table.cell(dash_tbl, 6, 1, "—",        text_color=color.new(#546E7A, 0), bgcolor=cell_bg,      text_size=cell_sz)
    table.cell(dash_tbl, 7, 1, "—",        text_color=color.new(#546E7A, 0), bgcolor=cell_bg,      text_size=cell_sz)

    // --- Row 2: M15 ---
    color m15_dir_clr = m15_dir > 0 ? color.new(#26A69A, 0) : (m15_dir < 0 ? color.new(#EF5350, 0) : color.new(#78909C, 0))
    string m15_exh_str = str.tostring(m15_ew_imp_cnt) + "/" + str.tostring(m15_ew_thr)
    color  m15_exh_clr = exh_color(m15_ew_imp_cnt, m15_ew_thr)
    table.cell(dash_tbl, 0, 2, "M15",            text_color=color.new(#26A69A, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 1, 2, dir_str(m15_dir), text_color=m15_dir_clr,           bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 2, 2, swc_str(m15_lcls),text_color=color.new(#B0BEC5, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 3, 2, conv_str(m15_cv) + (m15_sd > 0 ? "↑" : (m15_sd < 0 ? "↓" : "")), text_color=color.white, bgcolor=conv_color(m15_cv, m15_sd), text_size=cell_sz)
    table.cell(dash_tbl, 4, 2, hlth_str(m15_health), text_color=color.white, bgcolor=hlth_color(m15_health), text_size=cell_sz)
    table.cell(dash_tbl, 5, 2, ew_cell(m15_ew_phase, m15_ew_imp_cnt, m15_ew_cor_cnt), text_color=color.new(#CE93D8, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(dash_tbl, 6, 2, pat_str(m15_ew_pattern), text_color=color.new(#90CAF9, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(dash_tbl, 7, 2, m15_exh_str,      text_color=color.white,            bgcolor=m15_exh_clr,  text_size=cell_sz)

    // --- Row 3: H1 ---
    color h1_dir_clr = h1_dir > 0 ? color.new(#26A69A, 0) : (h1_dir < 0 ? color.new(#EF5350, 0) : color.new(#78909C, 0))
    string h1_exh_str = str.tostring(h1_ew_imp_cnt) + "/" + str.tostring(h1_ew_thr)
    color  h1_exh_clr = exh_color(h1_ew_imp_cnt, h1_ew_thr)
    table.cell(dash_tbl, 0, 3, "H1",            text_color=color.new(#42A5F5, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 1, 3, dir_str(h1_dir), text_color=h1_dir_clr,           bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 2, 3, swc_str(h1_lcls),text_color=color.new(#B0BEC5, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 3, 3, conv_str(h1_cv) + (h1_sd > 0 ? "↑" : (h1_sd < 0 ? "↓" : "")), text_color=color.white, bgcolor=conv_color(h1_cv, h1_sd), text_size=cell_sz)
    table.cell(dash_tbl, 4, 3, hlth_str(h1_health), text_color=color.white, bgcolor=hlth_color(h1_health), text_size=cell_sz)
    table.cell(dash_tbl, 5, 3, ew_cell(h1_ew_phase, h1_ew_imp_cnt, h1_ew_cor_cnt), text_color=color.new(#CE93D8, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(dash_tbl, 6, 3, pat_str(h1_ew_pattern), text_color=color.new(#90CAF9, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(dash_tbl, 7, 3, h1_exh_str,      text_color=color.white,           bgcolor=h1_exh_clr,   text_size=cell_sz)

    // --- Row 4: H4 ---
    color h4_dir_clr = h4_dir > 0 ? color.new(#26A69A, 0) : (h4_dir < 0 ? color.new(#EF5350, 0) : color.new(#78909C, 0))
    string h4_exh_str = str.tostring(h4_ew_imp_cnt) + "/" + str.tostring(h4_ew_thr)
    color  h4_exh_clr = exh_color(h4_ew_imp_cnt, h4_ew_thr)
    table.cell(dash_tbl, 0, 4, "H4",            text_color=color.new(#AB47BC, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 1, 4, dir_str(h4_dir), text_color=h4_dir_clr,           bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 2, 4, swc_str(h4_lcls),text_color=color.new(#B0BEC5, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 3, 4, conv_str(h4_cv) + (h4_sd > 0 ? "↑" : (h4_sd < 0 ? "↓" : "")), text_color=color.white, bgcolor=conv_color(h4_cv, h4_sd), text_size=cell_sz)
    table.cell(dash_tbl, 4, 4, hlth_str(h4_health), text_color=color.white, bgcolor=hlth_color(h4_health), text_size=cell_sz)
    table.cell(dash_tbl, 5, 4, ew_cell(h4_ew_phase, h4_ew_imp_cnt, h4_ew_cor_cnt), text_color=color.new(#CE93D8, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(dash_tbl, 6, 4, pat_str(h4_ew_pattern), text_color=color.new(#90CAF9, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(dash_tbl, 7, 4, h4_exh_str,      text_color=color.white,           bgcolor=h4_exh_clr,   text_size=cell_sz)

    // --- Row 5: D ---
    color d_dir_clr = d_dir > 0 ? color.new(#26A69A, 0) : (d_dir < 0 ? color.new(#EF5350, 0) : color.new(#78909C, 0))
    string d_exh_str = str.tostring(d_ew_imp_cnt) + "/" + str.tostring(d_ew_thr)
    color  d_exh_clr = exh_color(d_ew_imp_cnt, d_ew_thr)
    table.cell(dash_tbl, 0, 5, "D",             text_color=color.new(#FF7043, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 1, 5, dir_str(d_dir),  text_color=d_dir_clr,            bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 2, 5, swc_str(d_lcls), text_color=color.new(#B0BEC5, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 3, 5, conv_str(d_cv) + (d_sd > 0 ? "↑" : (d_sd < 0 ? "↓" : "")), text_color=color.white, bgcolor=conv_color(d_cv, d_sd), text_size=cell_sz)
    table.cell(dash_tbl, 4, 5, hlth_str(d_health), text_color=color.white, bgcolor=hlth_color(d_health), text_size=cell_sz)
    table.cell(dash_tbl, 5, 5, ew_cell(d_ew_phase, d_ew_imp_cnt, d_ew_cor_cnt), text_color=color.new(#CE93D8, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(dash_tbl, 6, 5, pat_str(d_ew_pattern), text_color=color.new(#90CAF9, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(dash_tbl, 7, 5, d_exh_str,       text_color=color.white,           bgcolor=d_exh_clr,    text_size=cell_sz)

    // --- Row 6: W ---
    color w_dir_clr = w_dir > 0 ? color.new(#26A69A, 0) : (w_dir < 0 ? color.new(#EF5350, 0) : color.new(#78909C, 0))
    table.cell(dash_tbl, 0, 6, "W",             text_color=color.new(#FFCA28, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 1, 6, dir_str(w_dir),  text_color=w_dir_clr,            bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 2, 6, swc_str(w_lcls), text_color=color.new(#B0BEC5, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 3, 6, conv_str(w_cv) + (w_sd > 0 ? "↑" : (w_sd < 0 ? "↓" : "")), text_color=color.white, bgcolor=conv_color(w_cv, w_sd), text_size=cell_sz)
    table.cell(dash_tbl, 4, 6, hlth_str(w_health), text_color=color.white, bgcolor=hlth_color(w_health), text_size=cell_sz)
    table.cell(dash_tbl, 5, 6, "—",        text_color=color.new(#546E7A, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 6, 6, "—",        text_color=color.new(#546E7A, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 7, 6, "—",        text_color=color.new(#546E7A, 0), bgcolor=cell_bg,       text_size=cell_sz)

    // --- Row 7: MN ---
    color mn_dir_clr = mn_dir > 0 ? color.new(#26A69A, 0) : (mn_dir < 0 ? color.new(#EF5350, 0) : color.new(#78909C, 0))
    table.cell(dash_tbl, 0, 7, "MN",            text_color=color.new(#EF5350, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 1, 7, dir_str(mn_dir), text_color=mn_dir_clr,           bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 2, 7, swc_str(mn_lcls),text_color=color.new(#B0BEC5, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 3, 7, conv_str(mn_cv) + (mn_sd > 0 ? "↑" : (mn_sd < 0 ? "↓" : "")), text_color=color.white, bgcolor=conv_color(mn_cv, mn_sd), text_size=cell_sz)
    table.cell(dash_tbl, 4, 7, hlth_str(mn_health), text_color=color.white, bgcolor=hlth_color(mn_health), text_size=cell_sz)
    table.cell(dash_tbl, 5, 7, "—",        text_color=color.new(#546E7A, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 6, 7, "—",        text_color=color.new(#546E7A, 0), bgcolor=cell_bg,       text_size=cell_sz)
    table.cell(dash_tbl, 7, 7, "—",        text_color=color.new(#546E7A, 0), bgcolor=cell_bg,       text_size=cell_sz)

// === END OF DETECTION ENGINE ===
