if h1_fired
    if h1_ew_phase == 0
        if h1_swc == 1
            h1_ew_phase   := 1
            h1_ew_imp_cnt := 1
            h1_ew_b_w1_bot := h1_plo
            h1_ew_b_w1_top := h1_phi
        else if h1_swc == 3
            h1_ew_phase   := 3
            h1_ew_imp_cnt := 1
            h1_ew_s_w1_top := h1_phi
            h1_ew_s_w1_bot := h1_plo
    else if h1_ew_phase == 1
        if h1_swc == 1
            h1_ew_imp_cnt := h1_ew_imp_cnt + 1
            if h1_ew_imp_cnt == 3
                h1_ew_b_w3_top := h1_phi
            else if h1_ew_imp_cnt == 5
                h1_ew_b_w5_top := h1_phi
        else if h1_swc == 4
            if h1_ew_imp_cnt == 1
                h1_ew_b_w2_bot := h1_plo
            else if h1_ew_imp_cnt == 3
                h1_ew_b_w4_bot := h1_plo
        else if h1_swc == 2
            h1_ew_phase   := 2
            h1_ew_cor_cnt := 1
            h1_ew_cor_start := h1_phi
            h1_ew_cor_bull  := false
        else if h1_swc == 3
            h1_ew_phase   := 3
            h1_ew_imp_cnt := 1
            h1_ew_s_w1_top := h1_phi
            h1_ew_s_w1_bot := h1_plo
    else if h1_ew_phase == 2
        if h1_swc == 1
            h1_ew_phase   := 1
            h1_ew_imp_cnt := 1
            h1_ew_b_w1_bot := h1_plo
            h1_ew_b_w1_top := h1_phi
        else if h1_swc == 2 or h1_swc == 4
            h1_ew_cor_cnt := h1_ew_cor_cnt + 1
            if h1_ew_cor_cnt == 1
                h1_ew_cor_a := h1_swc == 2 ? h1_phi : h1_plo
            else if h1_ew_cor_cnt == 2
                h1_ew_cor_b := h1_swc == 4 ? h1_plo : h1_phi
            else if h1_ew_cor_cnt == 3
                h1_ew_cor_c := h1_swc == 2 ? h1_phi : h1_plo
        else if h1_swc == 3
            h1_ew_phase   := 3
            h1_ew_imp_cnt := 1
            h1_ew_s_w1_top := h1_phi
            h1_ew_s_w1_bot := h1_plo
    else if h1_ew_phase == 3
        if h1_swc == 3
            h1_ew_imp_cnt := h1_ew_imp_cnt + 1
            if h1_ew_imp_cnt == 3
                h1_ew_s_w3_bot := h1_plo
            else if h1_ew_imp_cnt == 5
                h1_ew_s_w5_bot := h1_plo
        else if h1_swc == 2
            if h1_ew_imp_cnt == 1
                h1_ew_s_w2_top := h1_phi
            else if h1_ew_imp_cnt == 3
                h1_ew_s_w4_top := h1_phi
        else if h1_swc == 4
            h1_ew_phase   := 4
            h1_ew_cor_cnt := 1
            h1_ew_cor_start := h1_plo
            h1_ew_cor_bull  := true
        else if h1_swc == 1
            h1_ew_phase   := 1
            h1_ew_imp_cnt := 1
            h1_ew_b_w1_bot := h1_plo
            h1_ew_b_w1_top := h1_phi
    else if h1_ew_phase == 4
        if h1_swc == 3
            h1_ew_phase   := 3
            h1_ew_imp_cnt := 1
            h1_ew_s_w1_top := h1_phi
            h1_ew_s_w1_bot := h1_plo
        else if h1_swc == 4 or h1_swc == 2
            h1_ew_cor_cnt := h1_ew_cor_cnt + 1
            if h1_ew_cor_cnt == 1
                h1_ew_cor_a := h1_swc == 4 ? h1_plo : h1_phi
            else if h1_ew_cor_cnt == 2
                h1_ew_cor_b := h1_swc == 2 ? h1_phi : h1_plo
            else if h1_ew_cor_cnt == 3
                h1_ew_cor_c := h1_swc == 4 ? h1_plo : h1_phi
        else if h1_swc == 1
            h1_ew_phase   := 1
            h1_ew_imp_cnt := 1
            h1_ew_b_w1_bot := h1_plo
            h1_ew_b_w1_top := h1_phi

// --- H4 EW state ---
