var float h1_ew_b_w2_bot = na
var float h1_ew_b_w3_top = na
var float h1_ew_b_w4_bot = na
var float h1_ew_b_w5_top = na
var float h1_ew_s_w1_bot = na
var float h1_ew_s_w1_top = na
var float h1_ew_s_w2_top = na
var float h1_ew_s_w3_bot = na
var float h1_ew_s_w4_top = na
var float h1_ew_s_w5_bot = na
var float h1_ew_cor_start = na
var float h1_ew_cor_a     = na
var float h1_ew_cor_b     = na
