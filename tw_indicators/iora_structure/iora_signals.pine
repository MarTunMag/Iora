//@version=6
indicator("Iora Signal Engine", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// =============================================================================
// === SECTION 1: INPUTS
// =============================================================================

// --- Group: Zones ---
bool   i_show_zones  = input.bool(true,           "Show zone boxes",           group="Zones")
bool   i_zone_m1     = input.bool(false,           "Show M1 zones",             group="Zones")
bool   i_zone_m5     = input.bool(false,           "Show M5 zones",             group="Zones")
bool   i_zone_m15    = input.bool(false,           "Show M15 zones",            group="Zones")
bool   i_zone_h1     = input.bool(true,            "Show H1 zones",             group="Zones")
bool   i_zone_h4     = input.bool(true,            "Show H4 zones",             group="Zones")
bool   i_zone_d      = input.bool(true,            "Show D zones",              group="Zones")
int    i_max_zones   = input.int(4,                "Max zones per TF per side", group="Zones", options=[2, 4, 6, 8])

// --- Group: Signals ---
bool   i_show_model_a = input.bool(true,           "Show Model A signals",      group="Signals")
bool   i_show_model_b = input.bool(true,           "Show Model B signals",      group="Signals")
bool   i_show_model_c = input.bool(true,           "Show Model C signals",      group="Signals")
bool   i_show_model_d = input.bool(true,           "Show Model D signals",      group="Signals")
bool   i_show_sl_tp   = input.bool(true,           "Show SL/TP lines",          group="Signals")

// --- Group: Dashboard ---
bool   i_dash_on     = input.bool(true,            "Show Dashboard",            group="Dashboard")
string i_dash_pos    = input.string("Bottom Left", "Position",                  group="Dashboard", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"])

// =============================================================================
// === SECTION 2: REQUEST.SECURITY — 7 TIMEFRAMES (M5 through MN)
// =============================================================================

[m5o,  m5h,  m5l,  m5c,  m5t,  m5tc]  = request.security(syminfo.tickerid, "5",   [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[m15o, m15h, m15l, m15c, m15t, m15tc] = request.security(syminfo.tickerid, "15",  [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[h1o,  h1h,  h1l,  h1c,  h1t,  h1tc]  = request.security(syminfo.tickerid, "60",  [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[h4o,  h4h,  h4l,  h4c,  h4t,  h4tc]  = request.security(syminfo.tickerid, "240", [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[d_o,  d_h,  d_l,  d_c,  d_t,  d_tc]  = request.security(syminfo.tickerid, "1D",  [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[w_o,  w_h,  w_l,  w_c,  w_t,  w_tc]  = request.security(syminfo.tickerid, "1W",  [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)
[mn_o, mn_h, mn_l, mn_c, mn_t, mn_tc] = request.security(syminfo.tickerid, "1M",  [open, high, low, close, time, time_close], lookahead=barmerge.lookahead_on)

// =============================================================================
// === SECTION 3: NEW-PERIOD DETECTION BOOLEANS
// =============================================================================

bool m5_new  = ta.change(m5t)  != 0
bool m15_new = ta.change(m15t) != 0
bool h1_new  = ta.change(h1t)  != 0
bool h4_new  = ta.change(h4t)  != 0
bool d_new   = ta.change(d_t)  != 0
bool w_new   = ta.change(w_t)  != 0
bool mn_new  = ta.change(mn_t) != 0

// =============================================================================
// === SECTION 4: ENVELOPE COMPUTATION — ALL 8 TIMEFRAMES
// =============================================================================

// --- M1 envelope: trivial — raw bar data ---
float m1_env_ceil  = high
float m1_env_mid   = close
float m1_env_floor = low

// --- M5 envelope: child = M1, N=5 (SMA of raw bars) ---
float m5_env_ceil  = ta.sma(high, 5)
float m5_env_floor = ta.sma(low, 5)
float m5_env_mid   = ta.sma(close, 5)

// --- M15 envelope: child = M5, N=3 (2 closed + 1 building) ---
var array<float> m5_ch_hi  = array.new_float(0)
var array<float> m5_ch_lo  = array.new_float(0)
var array<float> m5_ch_cl  = array.new_float(0)
var int m5_ch_cnt = 0
if m5_new and not na(m5h[1])
    m5_ch_hi.unshift(m5h[1])
    m5_ch_lo.unshift(m5l[1])
    m5_ch_cl.unshift(m5c[1])
    m5_ch_cnt += 1
    if m5_ch_hi.size() > 2
        m5_ch_hi.pop()
        m5_ch_lo.pop()
        m5_ch_cl.pop()
float m15_env_ceil  = m5_ch_cnt >= 2 ? (m5_ch_hi.sum() + m5h) / 3 : na
float m15_env_floor = m5_ch_cnt >= 2 ? (m5_ch_lo.sum() + m5l) / 3 : na
float m15_env_mid   = m5_ch_cnt >= 2 ? (m5_ch_cl.sum() + m5c) / 3 : na

// --- H1 envelope: child = M15, N=4 ---
var array<float> m15_ch_hi  = array.new_float(0)
var array<float> m15_ch_lo  = array.new_float(0)
var array<float> m15_ch_cl  = array.new_float(0)
var int m15_ch_cnt = 0
if m15_new and not na(m15h[1])
    m15_ch_hi.unshift(m15h[1])
    m15_ch_lo.unshift(m15l[1])
    m15_ch_cl.unshift(m15c[1])
    m15_ch_cnt += 1
    if m15_ch_hi.size() > 3
        m15_ch_hi.pop()
        m15_ch_lo.pop()
        m15_ch_cl.pop()
float h1_env_ceil  = m15_ch_cnt >= 3 ? (m15_ch_hi.sum() + m15h) / 4 : na
float h1_env_floor = m15_ch_cnt >= 3 ? (m15_ch_lo.sum() + m15l) / 4 : na
float h1_env_mid   = m15_ch_cnt >= 3 ? (m15_ch_cl.sum() + m15c) / 4 : na

// --- H4 envelope: child = H1, N=4 ---
var array<float> h1_ch_hi  = array.new_float(0)
var array<float> h1_ch_lo  = array.new_float(0)
var array<float> h1_ch_cl  = array.new_float(0)
var int h1_ch_cnt = 0
if h1_new and not na(h1h[1])
    h1_ch_hi.unshift(h1h[1])
    h1_ch_lo.unshift(h1l[1])
    h1_ch_cl.unshift(h1c[1])
    h1_ch_cnt += 1
    if h1_ch_hi.size() > 3
        h1_ch_hi.pop()
        h1_ch_lo.pop()
        h1_ch_cl.pop()
float h4_env_ceil  = h1_ch_cnt >= 3 ? (h1_ch_hi.sum() + h1h) / 4 : na
float h4_env_floor = h1_ch_cnt >= 3 ? (h1_ch_lo.sum() + h1l) / 4 : na
float h4_env_mid   = h1_ch_cnt >= 3 ? (h1_ch_cl.sum() + h1c) / 4 : na

// --- D envelope: child = H4, N=6 ---
var array<float> h4_ch_hi  = array.new_float(0)
var array<float> h4_ch_lo  = array.new_float(0)
var array<float> h4_ch_cl  = array.new_float(0)
var int h4_ch_cnt = 0
if h4_new and not na(h4h[1])
    h4_ch_hi.unshift(h4h[1])
    h4_ch_lo.unshift(h4l[1])
    h4_ch_cl.unshift(h4c[1])
    h4_ch_cnt += 1
    if h4_ch_hi.size() > 5
        h4_ch_hi.pop()
        h4_ch_lo.pop()
        h4_ch_cl.pop()
float d_env_ceil  = h4_ch_cnt >= 5 ? (h4_ch_hi.sum() + h4h) / 6 : na
float d_env_floor = h4_ch_cnt >= 5 ? (h4_ch_lo.sum() + h4l) / 6 : na
float d_env_mid   = h4_ch_cnt >= 5 ? (h4_ch_cl.sum() + h4c) / 6 : na

// --- W envelope: child = D, N=5 ---
var array<float> d_ch_hi  = array.new_float(0)
var array<float> d_ch_lo  = array.new_float(0)
var array<float> d_ch_cl  = array.new_float(0)
var int d_ch_cnt = 0
if d_new and not na(d_h[1])
    d_ch_hi.unshift(d_h[1])
    d_ch_lo.unshift(d_l[1])
    d_ch_cl.unshift(d_c[1])
    d_ch_cnt += 1
    if d_ch_hi.size() > 4
        d_ch_hi.pop()
        d_ch_lo.pop()
        d_ch_cl.pop()
float w_env_ceil  = d_ch_cnt >= 4 ? (d_ch_hi.sum() + d_h) / 5 : na
float w_env_floor = d_ch_cnt >= 4 ? (d_ch_lo.sum() + d_l) / 5 : na
float w_env_mid   = d_ch_cnt >= 4 ? (d_ch_cl.sum() + d_c) / 5 : na

// --- MN envelope: child = W, N=4 ---
var array<float> w_ch_hi  = array.new_float(0)
var array<float> w_ch_lo  = array.new_float(0)
var array<float> w_ch_cl  = array.new_float(0)
var int w_ch_cnt = 0
if w_new and not na(w_h[1])
    w_ch_hi.unshift(w_h[1])
    w_ch_lo.unshift(w_l[1])
    w_ch_cl.unshift(w_c[1])
    w_ch_cnt += 1
    if w_ch_hi.size() > 3
        w_ch_hi.pop()
        w_ch_lo.pop()
        w_ch_cl.pop()
float mn_env_ceil  = w_ch_cnt >= 3 ? (w_ch_hi.sum() + w_h) / 4 : na
float mn_env_floor = w_ch_cnt >= 3 ? (w_ch_lo.sum() + w_l) / 4 : na
float mn_env_mid   = w_ch_cnt >= 3 ? (w_ch_cl.sum() + w_c) / 4 : na

// =============================================================================
// === SECTION 5: GRADIENT COMPUTATION — ALL 8 TIMEFRAMES
// =============================================================================

// --- M1 gradients (from raw bar data) ---
float m1_ceil_d  = ta.change(high)
float m1_floor_d = ta.change(low)
float m1_mid_d   = ta.change(close)

// --- M5 gradients ---
float m5_ceil_d  = ta.change(m5_env_ceil)
float m5_floor_d = ta.change(m5_env_floor)
float m5_mid_d   = ta.change(m5_env_mid)

// --- M15 gradients ---
float m15_ceil_d  = ta.change(m15_env_ceil)
float m15_floor_d = ta.change(m15_env_floor)
float m15_mid_d   = ta.change(m15_env_mid)

// --- H1 gradients ---
float h1_ceil_d  = ta.change(h1_env_ceil)
float h1_floor_d = ta.change(h1_env_floor)
float h1_mid_d   = ta.change(h1_env_mid)

// --- H4 gradients ---
float h4_ceil_d  = ta.change(h4_env_ceil)
float h4_floor_d = ta.change(h4_env_floor)
float h4_mid_d   = ta.change(h4_env_mid)

// --- D gradients ---
float d_ceil_d  = ta.change(d_env_ceil)
float d_floor_d = ta.change(d_env_floor)
float d_mid_d   = ta.change(d_env_mid)

// --- W gradients ---
float w_ceil_d  = ta.change(w_env_ceil)
float w_floor_d = ta.change(w_env_floor)
float w_mid_d   = ta.change(w_env_mid)

// --- MN gradients ---
float mn_ceil_d  = ta.change(mn_env_ceil)
float mn_floor_d = ta.change(mn_env_floor)
float mn_mid_d   = ta.change(mn_env_mid)

// =============================================================================
// === SECTION 6: CONVICTION + LEG TRACKING — HELPERS + ALL 8 TIMEFRAMES
// =============================================================================

// Gradient score: +2 accelerating, +1 steady, -1 falling, -2 reversing
src_grad(float delta, float prev_delta) =>
    float d = nz(delta)
    float pd = nz(prev_delta)
    if d == 0.0
        0
    else if d > 0.0
        pd > 0.0 and d > pd ? 2 : 1
    else
        pd < 0.0 and d < pd ? -2 : -1

// Conviction: level 0=NONE, 1=PRE, 2=WEAK, 3=STRONG; side +1=BULL, -1=BEAR
assess_conv(bool floor_brk, bool ceil_brk, bool mid_against, bool mid_stall, float floor_d, float ceil_d, int leg) =>
    int cv = 0
    int sd = 0
    if leg > 0
        if floor_brk and mid_against and ceil_d <= 0.0
            cv := 3
            sd := -1
        else if floor_brk
            cv := 2
            sd := -1
        else if mid_stall and ceil_d <= 0.0
            cv := 1
            sd := -1
    else if leg < 0
        if ceil_brk and mid_against and floor_d >= 0.0
            cv := 3
            sd := 1
        else if ceil_brk
            cv := 2
            sd := 1
        else if mid_stall and floor_d >= 0.0
            cv := 1
            sd := 1
    [cv, sd]

// Leg transition: returns [dir, legnum, building, leg_hi, leg_lo, prev_hi, prev_lo, swing_class, fired]
// swing_class: 0=none, 1=HH, 2=LH, 3=LL, 4=HL
leg_transition(int cv, int sd, int dir, int legnum, int building, float leg_hi, float leg_lo, float prev_hi, float prev_lo, float child_hi, float child_lo) =>
    int   n_dir      = dir
    int   n_legnum   = legnum
    int   n_building = building
    float n_leg_hi   = na(leg_hi) ? child_hi : math.max(leg_hi, child_hi)
    float n_leg_lo   = na(leg_lo) ? child_lo : math.min(leg_lo, child_lo)
    float n_prev_hi  = prev_hi
    float n_prev_lo  = prev_lo
    int   n_swing    = 0
    bool  fired      = false
    if dir == 0 and cv == 3
        n_dir      := sd
        n_legnum   := 1
        n_building := sd > 0 ? 1 : -1
        n_leg_hi   := child_hi
        n_leg_lo   := child_lo
        fired      := true
    else if cv == 3 and sd != dir
        if dir > 0
            n_swing := not na(prev_hi) ? (leg_hi > prev_hi ? 1 : 2) : 0
            n_prev_hi := leg_hi
        else
            n_swing := not na(prev_lo) ? (leg_lo < prev_lo ? 3 : 4) : 0
            n_prev_lo := leg_lo
        n_dir      := sd
        n_legnum   := legnum + 1
        n_building := sd > 0 ? 1 : -1
        n_leg_hi   := child_hi
        n_leg_lo   := child_lo
        fired      := true
    else if cv == 3 and sd == dir
        n_leg_hi := math.max(nz(leg_hi, child_hi), child_hi)
        n_leg_lo := math.min(nz(leg_lo, child_lo), child_lo)
    [n_dir, n_legnum, n_building, n_leg_hi, n_leg_lo, n_prev_hi, n_prev_lo, n_swing, fired]

// --- M1 conviction + health + leg ---
var int   m1_leg      = 0
var int   m1_health   = 0
var float m1_last_int = na
if m1_leg == 0 and nz(m1_mid_d) != 0.0
    m1_leg := nz(m1_mid_d) > 0.0 ? 1 : -1
bool m1_fbrk = low < nz(m1_env_floor[1])
bool m1_cbrk = high > nz(m1_env_ceil[1])
bool m1_mag  = (m1_leg > 0 and nz(m1_mid_d) < 0.0) or (m1_leg < 0 and nz(m1_mid_d) > 0.0)
bool m1_mst  = math.abs(nz(m1_mid_d)) < math.abs(nz(m1_mid_d[1])) * 0.3
[m1_cv, m1_sd] = assess_conv(m1_fbrk, m1_cbrk, m1_mag, m1_mst, nz(m1_floor_d), nz(m1_ceil_d), m1_leg)
int m1_gs = src_grad(m1_floor_d, m1_floor_d[1]) + src_grad(m1_mid_d, m1_mid_d[1]) + src_grad(m1_ceil_d, m1_ceil_d[1])
if m1_cv == 2
    float m1_ext = m1_sd == -1 ? low : high
    if not na(m1_last_int)
        bool m1_ctr = (m1_leg > 0 and m1_ext < m1_last_int) or (m1_leg < 0 and m1_ext > m1_last_int)
        m1_health := m1_ctr ? math.min(m1_health + 1, 3) : math.max(m1_health - 1, 0)
    m1_last_int := m1_ext
if m1_cv == 3
    m1_leg    := m1_sd
    m1_health := 0
    m1_last_int := na

var int   m1_dir   = 0
var int   m1_lnum  = 0
var int   m1_bld   = 0
var float m1_lhi   = na
var float m1_llo   = na
var float m1_phi   = na
var float m1_plo   = na
int  m1_swc  = 0
bool m1_fired = false
[m1_dir2, m1_lnum2, m1_bld2, m1_lhi2, m1_llo2, m1_phi2, m1_plo2, m1_swc2, m1_f2] = leg_transition(m1_cv, m1_sd, m1_dir, m1_lnum, m1_bld, m1_lhi, m1_llo, m1_phi, m1_plo, high, low)
m1_dir  := m1_dir2
m1_lnum := m1_lnum2
m1_bld  := m1_bld2
m1_lhi  := m1_lhi2
m1_llo  := m1_llo2
m1_phi  := m1_phi2
m1_plo  := m1_plo2
m1_swc  := m1_swc2
m1_fired := m1_f2
if m1_cv == 3
    m1_leg := m1_sd

// --- M5 conviction + health + leg ---
var int   m5_leg      = 0
var int   m5_health   = 0
var float m5_last_int = na
if m5_leg == 0 and nz(m5_mid_d) != 0.0
    m5_leg := nz(m5_mid_d) > 0.0 ? 1 : -1
bool m5_fbrk = low < m5_env_floor
bool m5_cbrk = high > m5_env_ceil
bool m5_mag  = (m5_leg > 0 and nz(m5_mid_d) < 0.0) or (m5_leg < 0 and nz(m5_mid_d) > 0.0)
bool m5_mst  = math.abs(nz(m5_mid_d)) < math.abs(nz(m5_mid_d[1])) * 0.3
[m5_cv, m5_sd] = assess_conv(m5_fbrk, m5_cbrk, m5_mag, m5_mst, nz(m5_floor_d), nz(m5_ceil_d), m5_leg)
int m5_gs = src_grad(m5_floor_d, m5_floor_d[1]) + src_grad(m5_mid_d, m5_mid_d[1]) + src_grad(m5_ceil_d, m5_ceil_d[1])
if m5_cv == 2
    float m5_ext = m5_sd == -1 ? low : high
    if not na(m5_last_int)
        bool m5_ctr = (m5_leg > 0 and m5_ext < m5_last_int) or (m5_leg < 0 and m5_ext > m5_last_int)
        m5_health := m5_ctr ? math.min(m5_health + 1, 3) : math.max(m5_health - 1, 0)
    m5_last_int := m5_ext
if m5_cv == 3
    m5_leg    := m5_sd
    m5_health := 0
    m5_last_int := na

var int   m5_dir   = 0
var int   m5_lnum  = 0
var int   m5_bld   = 0
var float m5_lhi   = na
var float m5_llo   = na
var float m5_phi   = na
var float m5_plo   = na
int  m5_swc  = 0
bool m5_fired = false
[m5_dir2, m5_lnum2, m5_bld2, m5_lhi2, m5_llo2, m5_phi2, m5_plo2, m5_swc2, m5_f2] = leg_transition(m5_cv, m5_sd, m5_dir, m5_lnum, m5_bld, m5_lhi, m5_llo, m5_phi, m5_plo, high, low)
m5_dir  := m5_dir2
m5_lnum := m5_lnum2
m5_bld  := m5_bld2
m5_lhi  := m5_lhi2
m5_llo  := m5_llo2
m5_phi  := m5_phi2
m5_plo  := m5_plo2
m5_swc  := m5_swc2
m5_fired := m5_f2
if m5_cv == 3
    m5_leg := m5_sd

// --- M15 conviction + health + leg ---
var int   m15_leg      = 0
var int   m15_health   = 0
var float m15_last_int = na
if m15_leg == 0 and nz(m15_mid_d) != 0.0
    m15_leg := nz(m15_mid_d) > 0.0 ? 1 : -1
bool m15_fbrk = m5l < m15_env_floor
bool m15_cbrk = m5h > m15_env_ceil
bool m15_mag  = (m15_leg > 0 and nz(m15_mid_d) < 0.0) or (m15_leg < 0 and nz(m15_mid_d) > 0.0)
bool m15_mst  = math.abs(nz(m15_mid_d)) < math.abs(nz(m15_mid_d[1])) * 0.3
[m15_cv, m15_sd] = assess_conv(m15_fbrk, m15_cbrk, m15_mag, m15_mst, nz(m15_floor_d), nz(m15_ceil_d), m15_leg)
int m15_gs = src_grad(m15_floor_d, m15_floor_d[1]) + src_grad(m15_mid_d, m15_mid_d[1]) + src_grad(m15_ceil_d, m15_ceil_d[1])
if m15_cv == 2
    float m15_ext = m15_sd == -1 ? m5l : m5h
    if not na(m15_last_int)
        bool m15_ctr = (m15_leg > 0 and m15_ext < m15_last_int) or (m15_leg < 0 and m15_ext > m15_last_int)
        m15_health := m15_ctr ? math.min(m15_health + 1, 3) : math.max(m15_health - 1, 0)
    m15_last_int := m15_ext
if m15_cv == 3
    m15_leg    := m15_sd
    m15_health := 0
    m15_last_int := na

var int   m15_dir   = 0
var int   m15_lnum  = 0
var int   m15_bld   = 0
var float m15_lhi   = na
var float m15_llo   = na
var float m15_phi   = na
var float m15_plo   = na
int  m15_swc  = 0
bool m15_fired = false
[m15_dir2, m15_lnum2, m15_bld2, m15_lhi2, m15_llo2, m15_phi2, m15_plo2, m15_swc2, m15_f2] = leg_transition(m15_cv, m15_sd, m15_dir, m15_lnum, m15_bld, m15_lhi, m15_llo, m15_phi, m15_plo, m5h, m5l)
m15_dir  := m15_dir2
m15_lnum := m15_lnum2
m15_bld  := m15_bld2
m15_lhi  := m15_lhi2
m15_llo  := m15_llo2
m15_phi  := m15_phi2
m15_plo  := m15_plo2
m15_swc  := m15_swc2
m15_fired := m15_f2
if m15_cv == 3
    m15_leg := m15_sd

// --- H1 conviction + health + leg ---
var int   h1_leg      = 0
var int   h1_health   = 0
var float h1_last_int = na
if h1_leg == 0 and nz(h1_mid_d) != 0.0
    h1_leg := nz(h1_mid_d) > 0.0 ? 1 : -1
bool h1_fbrk = m15l < h1_env_floor
bool h1_cbrk = m15h > h1_env_ceil
bool h1_mag  = (h1_leg > 0 and nz(h1_mid_d) < 0.0) or (h1_leg < 0 and nz(h1_mid_d) > 0.0)
bool h1_mst  = math.abs(nz(h1_mid_d)) < math.abs(nz(h1_mid_d[1])) * 0.3
[h1_cv, h1_sd] = assess_conv(h1_fbrk, h1_cbrk, h1_mag, h1_mst, nz(h1_floor_d), nz(h1_ceil_d), h1_leg)
int h1_gs = src_grad(h1_floor_d, h1_floor_d[1]) + src_grad(h1_mid_d, h1_mid_d[1]) + src_grad(h1_ceil_d, h1_ceil_d[1])
if h1_cv == 2
    float h1_ext = h1_sd == -1 ? m15l : m15h
    if not na(h1_last_int)
        bool h1_ctr = (h1_leg > 0 and h1_ext < h1_last_int) or (h1_leg < 0 and h1_ext > h1_last_int)
        h1_health := h1_ctr ? math.min(h1_health + 1, 3) : math.max(h1_health - 1, 0)
    h1_last_int := h1_ext
if h1_cv == 3
    h1_leg    := h1_sd
    h1_health := 0
    h1_last_int := na

var int   h1_dir   = 0
var int   h1_lnum  = 0
var int   h1_bld   = 0
var float h1_lhi   = na
var float h1_llo   = na
var float h1_phi   = na
var float h1_plo   = na
int  h1_swc  = 0
bool h1_fired = false
[h1_dir2, h1_lnum2, h1_bld2, h1_lhi2, h1_llo2, h1_phi2, h1_plo2, h1_swc2, h1_f2] = leg_transition(h1_cv, h1_sd, h1_dir, h1_lnum, h1_bld, h1_lhi, h1_llo, h1_phi, h1_plo, m15h, m15l)
h1_dir  := h1_dir2
h1_lnum := h1_lnum2
h1_bld  := h1_bld2
h1_lhi  := h1_lhi2
h1_llo  := h1_llo2
h1_phi  := h1_phi2
h1_plo  := h1_plo2
h1_swc  := h1_swc2
h1_fired := h1_f2
if h1_cv == 3
    h1_leg := h1_sd

// --- H4 conviction + health + leg ---
var int   h4_leg      = 0
var int   h4_health   = 0
var float h4_last_int = na
if h4_leg == 0 and nz(h4_mid_d) != 0.0
    h4_leg := nz(h4_mid_d) > 0.0 ? 1 : -1
bool h4_fbrk = h1l < h4_env_floor
bool h4_cbrk = h1h > h4_env_ceil
bool h4_mag  = (h4_leg > 0 and nz(h4_mid_d) < 0.0) or (h4_leg < 0 and nz(h4_mid_d) > 0.0)
bool h4_mst  = math.abs(nz(h4_mid_d)) < math.abs(nz(h4_mid_d[1])) * 0.3
[h4_cv, h4_sd] = assess_conv(h4_fbrk, h4_cbrk, h4_mag, h4_mst, nz(h4_floor_d), nz(h4_ceil_d), h4_leg)
int h4_gs = src_grad(h4_floor_d, h4_floor_d[1]) + src_grad(h4_mid_d, h4_mid_d[1]) + src_grad(h4_ceil_d, h4_ceil_d[1])
if h4_cv == 2
    float h4_ext = h4_sd == -1 ? h1l : h1h
    if not na(h4_last_int)
        bool h4_ctr = (h4_leg > 0 and h4_ext < h4_last_int) or (h4_leg < 0 and h4_ext > h4_last_int)
        h4_health := h4_ctr ? math.min(h4_health + 1, 3) : math.max(h4_health - 1, 0)
    h4_last_int := h4_ext
if h4_cv == 3
    h4_leg    := h4_sd
    h4_health := 0
    h4_last_int := na

var int   h4_dir   = 0
var int   h4_lnum  = 0
var int   h4_bld   = 0
var float h4_lhi   = na
var float h4_llo   = na
var float h4_phi   = na
var float h4_plo   = na
int  h4_swc  = 0
bool h4_fired = false
[h4_dir2, h4_lnum2, h4_bld2, h4_lhi2, h4_llo2, h4_phi2, h4_plo2, h4_swc2, h4_f2] = leg_transition(h4_cv, h4_sd, h4_dir, h4_lnum, h4_bld, h4_lhi, h4_llo, h4_phi, h4_plo, h1h, h1l)
h4_dir  := h4_dir2
h4_lnum := h4_lnum2
h4_bld  := h4_bld2
h4_lhi  := h4_lhi2
h4_llo  := h4_llo2
h4_phi  := h4_phi2
h4_plo  := h4_plo2
h4_swc  := h4_swc2
h4_fired := h4_f2
if h4_cv == 3
    h4_leg := h4_sd

// --- D conviction + health + leg ---
var int   d_leg      = 0
var int   d_health   = 0
var float d_last_int = na
if d_leg == 0 and nz(d_mid_d) != 0.0
    d_leg := nz(d_mid_d) > 0.0 ? 1 : -1
bool d_fbrk = h4l < d_env_floor
bool d_cbrk = h4h > d_env_ceil
bool d_mag  = (d_leg > 0 and nz(d_mid_d) < 0.0) or (d_leg < 0 and nz(d_mid_d) > 0.0)
bool d_mst  = math.abs(nz(d_mid_d)) < math.abs(nz(d_mid_d[1])) * 0.3
[d_cv, d_sd] = assess_conv(d_fbrk, d_cbrk, d_mag, d_mst, nz(d_floor_d), nz(d_ceil_d), d_leg)
int d_gs = src_grad(d_floor_d, d_floor_d[1]) + src_grad(d_mid_d, d_mid_d[1]) + src_grad(d_ceil_d, d_ceil_d[1])
if d_cv == 2
    float d_ext = d_sd == -1 ? h4l : h4h
    if not na(d_last_int)
        bool d_ctr = (d_leg > 0 and d_ext < d_last_int) or (d_leg < 0 and d_ext > d_last_int)
        d_health := d_ctr ? math.min(d_health + 1, 3) : math.max(d_health - 1, 0)
    d_last_int := d_ext
if d_cv == 3
    d_leg    := d_sd
    d_health := 0
    d_last_int := na

var int   d_dir   = 0
var int   d_lnum  = 0
var int   d_bld   = 0
var float d_lhi   = na
var float d_llo   = na
var float d_phi   = na
var float d_plo   = na
int  d_swc  = 0
bool d_fired = false
[d_dir2, d_lnum2, d_bld2, d_lhi2, d_llo2, d_phi2, d_plo2, d_swc2, d_f2] = leg_transition(d_cv, d_sd, d_dir, d_lnum, d_bld, d_lhi, d_llo, d_phi, d_plo, h4h, h4l)
d_dir  := d_dir2
d_lnum := d_lnum2
d_bld  := d_bld2
d_lhi  := d_lhi2
d_llo  := d_llo2
d_phi  := d_phi2
d_plo  := d_plo2
d_swc  := d_swc2
d_fired := d_f2
if d_cv == 3
    d_leg := d_sd

// --- W conviction + health + leg ---
var int   w_leg      = 0
var int   w_health   = 0
var float w_last_int = na
if w_leg == 0 and nz(w_mid_d) != 0.0
    w_leg := nz(w_mid_d) > 0.0 ? 1 : -1
bool w_fbrk = d_l < w_env_floor
bool w_cbrk = d_h > w_env_ceil
bool w_mag  = (w_leg > 0 and nz(w_mid_d) < 0.0) or (w_leg < 0 and nz(w_mid_d) > 0.0)
bool w_mst  = math.abs(nz(w_mid_d)) < math.abs(nz(w_mid_d[1])) * 0.3
[w_cv, w_sd] = assess_conv(w_fbrk, w_cbrk, w_mag, w_mst, nz(w_floor_d), nz(w_ceil_d), w_leg)
int w_gs = src_grad(w_floor_d, w_floor_d[1]) + src_grad(w_mid_d, w_mid_d[1]) + src_grad(w_ceil_d, w_ceil_d[1])
if w_cv == 2
    float w_ext = w_sd == -1 ? d_l : d_h
    if not na(w_last_int)
        bool w_ctr = (w_leg > 0 and w_ext < w_last_int) or (w_leg < 0 and w_ext > w_last_int)
        w_health := w_ctr ? math.min(w_health + 1, 3) : math.max(w_health - 1, 0)
    w_last_int := w_ext
if w_cv == 3
    w_leg    := w_sd
    w_health := 0
    w_last_int := na

var int   w_dir   = 0
var int   w_lnum  = 0
var int   w_bld   = 0
var float w_lhi   = na
var float w_llo   = na
var float w_phi   = na
var float w_plo   = na
int  w_swc  = 0
bool w_fired = false
[w_dir2, w_lnum2, w_bld2, w_lhi2, w_llo2, w_phi2, w_plo2, w_swc2, w_f2] = leg_transition(w_cv, w_sd, w_dir, w_lnum, w_bld, w_lhi, w_llo, w_phi, w_plo, d_h, d_l)
w_dir  := w_dir2
w_lnum := w_lnum2
w_bld  := w_bld2
w_lhi  := w_lhi2
w_llo  := w_llo2
w_phi  := w_phi2
w_plo  := w_plo2
w_swc  := w_swc2
w_fired := w_f2
if w_cv == 3
    w_leg := w_sd

// --- MN conviction + health + leg ---
var int   mn_leg      = 0
var int   mn_health   = 0
var float mn_last_int = na
if mn_leg == 0 and nz(mn_mid_d) != 0.0
    mn_leg := nz(mn_mid_d) > 0.0 ? 1 : -1
bool mn_fbrk = w_l < mn_env_floor
bool mn_cbrk = w_h > mn_env_ceil
bool mn_mag  = (mn_leg > 0 and nz(mn_mid_d) < 0.0) or (mn_leg < 0 and nz(mn_mid_d) > 0.0)
bool mn_mst  = math.abs(nz(mn_mid_d)) < math.abs(nz(mn_mid_d[1])) * 0.3
[mn_cv, mn_sd] = assess_conv(mn_fbrk, mn_cbrk, mn_mag, mn_mst, nz(mn_floor_d), nz(mn_ceil_d), mn_leg)
int mn_gs = src_grad(mn_floor_d, mn_floor_d[1]) + src_grad(mn_mid_d, mn_mid_d[1]) + src_grad(mn_ceil_d, mn_ceil_d[1])
if mn_cv == 2
    float mn_ext = mn_sd == -1 ? w_l : w_h
    if not na(mn_last_int)
        bool mn_ctr = (mn_leg > 0 and mn_ext < mn_last_int) or (mn_leg < 0 and mn_ext > mn_last_int)
        mn_health := mn_ctr ? math.min(mn_health + 1, 3) : math.max(mn_health - 1, 0)
    mn_last_int := mn_ext
if mn_cv == 3
    mn_leg    := mn_sd
    mn_health := 0
    mn_last_int := na

var int   mn_dir   = 0
var int   mn_lnum  = 0
var int   mn_bld   = 0
var float mn_lhi   = na
var float mn_llo   = na
var float mn_phi   = na
var float mn_plo   = na
int  mn_swc  = 0
bool mn_fired = false
[mn_dir2, mn_lnum2, mn_bld2, mn_lhi2, mn_llo2, mn_phi2, mn_plo2, mn_swc2, mn_f2] = leg_transition(mn_cv, mn_sd, mn_dir, mn_lnum, mn_bld, mn_lhi, mn_llo, mn_phi, mn_plo, w_h, w_l)
mn_dir  := mn_dir2
mn_lnum := mn_lnum2
mn_bld  := mn_bld2
mn_lhi  := mn_lhi2
mn_llo  := mn_llo2
mn_phi  := mn_phi2
mn_plo  := mn_plo2
mn_swc  := mn_swc2
mn_fired := mn_f2
if mn_cv == 3
    mn_leg := mn_sd

// =============================================================================
// === SECTION 7: PERIOD-LEVEL BREAKS + SWING STATE MACHINE
// =============================================================================

// --- track_period: tracks prev-period high/low and first break timestamps ---
track_period(string tf) =>
    bool new_period = ta.change(time(tf)) != 0
    var float cur_hi   = na
    var int   cur_hi_t = na
    var float cur_lo   = na
    var int   cur_lo_t = na
    var float prev_hi   = na
    var int   prev_hi_t = na
    var float prev_lo   = na
    var int   prev_lo_t = na
    var int   hi_brk_t  = na
    var int   lo_brk_t  = na
    if new_period
        prev_hi   := cur_hi
        prev_hi_t := cur_hi_t
        prev_lo   := cur_lo
        prev_lo_t := cur_lo_t
        cur_hi    := high
        cur_hi_t  := time
        cur_lo    := low
        cur_lo_t  := time
        hi_brk_t  := na
        lo_brk_t  := na
    else
        if high >= nz(cur_hi)
            cur_hi   := high
            cur_hi_t := time
        if low <= nz(cur_lo, 1e18)
            cur_lo   := low
            cur_lo_t := time
    if na(hi_brk_t) and not na(prev_hi) and high > prev_hi
        hi_brk_t := time
    if na(lo_brk_t) and not na(prev_lo) and low < prev_lo
        lo_brk_t := time
    [prev_hi, prev_hi_t, prev_lo, prev_lo_t, hi_brk_t, lo_brk_t]

// --- swing_state: classifies period breaks as BOS/CHoCH, HH/LH/HL/LL ---
swing_state(float prev_hi, float prev_lo, int hi_brk, int lo_brk, float par_hi, float par_lo) =>
    var int   st_trend = 0
    var float st_shi   = na
    var float st_slo   = na
    var int   st_lcls  = 0
    var int   st_ltyp  = 0
    var bool  st_lprop = false
    bool hi_edge = hi_brk == time and not na(prev_hi)
    bool lo_edge = lo_brk == time and not na(prev_lo)
    int  brk_evt = 0
    int  cls     = 0
    int  btype   = 0
    bool propag  = false
    if hi_edge
        cls   := na(st_shi) or prev_hi > st_shi ? 1 : 2
        btype := st_trend == 0 ? 3 : (st_trend > 0 ? 1 : 2)
        st_shi   := prev_hi
        st_trend := 1
        brk_evt  := 1
        propag   := not na(par_hi) and high > par_hi
        st_lcls  := cls
        st_ltyp  := btype
        st_lprop := propag
    if lo_edge
        cls   := na(st_slo) or prev_lo < st_slo ? 3 : 4
        btype := st_trend == 0 ? 3 : (st_trend < 0 ? 1 : 2)
        st_slo   := prev_lo
        st_trend := -1
        brk_evt  := -1
        propag   := not na(par_lo) and low < par_lo
        st_lcls  := cls
        st_ltyp  := btype
        st_lprop := propag
    [st_trend, brk_evt, cls, btype, propag, st_lcls, st_ltyp, st_lprop]

// --- Call track_period for all 7 TFs ---
[m5_tp_hi,  m5_tp_hi_t,  m5_tp_lo,  m5_tp_lo_t,  m5_tp_hbrk,  m5_tp_lbrk]  = track_period("5")
[m15_tp_hi, m15_tp_hi_t, m15_tp_lo, m15_tp_lo_t, m15_tp_hbrk, m15_tp_lbrk] = track_period("15")
[h1_tp_hi,  h1_tp_hi_t,  h1_tp_lo,  h1_tp_lo_t,  h1_tp_hbrk,  h1_tp_lbrk]  = track_period("60")
[h4_tp_hi,  h4_tp_hi_t,  h4_tp_lo,  h4_tp_lo_t,  h4_tp_hbrk,  h4_tp_lbrk]  = track_period("240")
[d_tp_hi,   d_tp_hi_t,   d_tp_lo,   d_tp_lo_t,   d_tp_hbrk,   d_tp_lbrk]   = track_period("1D")
[w_tp_hi,   w_tp_hi_t,   w_tp_lo,   w_tp_lo_t,   w_tp_hbrk,   w_tp_lbrk]   = track_period("1W")
[mn_tp_hi,  mn_tp_hi_t,  mn_tp_lo,  mn_tp_lo_t,  mn_tp_hbrk,  mn_tp_lbrk]  = track_period("1M")

// --- Call swing_state for all 7 TFs (parent chain: M5→M15→H1→H4→D→W→MN→none) ---
float no_par = na
[m5_trend,  m5_brk,  m5_cls,  m5_bt,  m5_prop,  m5_lcls,  m5_ltyp,  m5_lprop]  = swing_state(m5_tp_hi,  m5_tp_lo,  m5_tp_hbrk,  m5_tp_lbrk,  m15_tp_hi, m15_tp_lo)
[m15_trend, m15_brk, m15_cls, m15_bt, m15_prop, m15_lcls, m15_ltyp, m15_lprop] = swing_state(m15_tp_hi, m15_tp_lo, m15_tp_hbrk, m15_tp_lbrk, h1_tp_hi,  h1_tp_lo)
[h1_trend,  h1_brk,  h1_cls,  h1_bt,  h1_prop,  h1_lcls,  h1_ltyp,  h1_lprop]  = swing_state(h1_tp_hi,  h1_tp_lo,  h1_tp_hbrk,  h1_tp_lbrk,  h4_tp_hi,  h4_tp_lo)
[h4_trend,  h4_brk,  h4_cls,  h4_bt,  h4_prop,  h4_lcls,  h4_ltyp,  h4_lprop]  = swing_state(h4_tp_hi,  h4_tp_lo,  h4_tp_hbrk,  h4_tp_lbrk,  d_tp_hi,   d_tp_lo)
[d_trend,   d_brk,   d_cls,   d_bt,   d_prop,   d_lcls,   d_ltyp,   d_lprop]   = swing_state(d_tp_hi,   d_tp_lo,   d_tp_hbrk,   d_tp_lbrk,   w_tp_hi,   w_tp_lo)
[w_trend,   w_brk,   w_cls,   w_bt,   w_prop,   w_lcls,   w_ltyp,   w_lprop]   = swing_state(w_tp_hi,   w_tp_lo,   w_tp_hbrk,   w_tp_lbrk,   mn_tp_hi,  mn_tp_lo)
[mn_trend,  mn_brk,  mn_cls,  mn_bt,  mn_prop,  mn_lcls,  mn_ltyp,  mn_lprop]  = swing_state(mn_tp_hi,  mn_tp_lo,  mn_tp_hbrk,  mn_tp_lbrk,  no_par,    no_par)

// =============================================================================
// === SECTION 8: ZONE UDT + ARRAYS
// =============================================================================

type Zone
    float top       = na
    float bottom    = na
    int   side      = 0
    int   swing_cls = 0
    int   tf_idx    = 0
    int   birth_bar = 0
    bool  broken    = false
    box   bx        = na

var array<Zone> m1_sup  = array.new<Zone>(0)
var array<Zone> m1_dem  = array.new<Zone>(0)
var array<Zone> m5_sup  = array.new<Zone>(0)
var array<Zone> m5_dem  = array.new<Zone>(0)
var array<Zone> m15_sup = array.new<Zone>(0)
var array<Zone> m15_dem = array.new<Zone>(0)
var array<Zone> h1_sup  = array.new<Zone>(0)
var array<Zone> h1_dem  = array.new<Zone>(0)
var array<Zone> h4_sup  = array.new<Zone>(0)
var array<Zone> h4_dem  = array.new<Zone>(0)
var array<Zone> d_sup   = array.new<Zone>(0)
var array<Zone> d_dem   = array.new<Zone>(0)

// =============================================================================
// === SECTION 9: ZONE CREATION FUNCTION
// =============================================================================

create_zone(array<Zone> arr, float ztop, float zbot, int side, int swc, int tf_idx, bool show, color clr, int max_z) =>
    Zone z = Zone.new()
    z.top       := ztop
    z.bottom    := zbot
    z.side      := side
    z.swing_cls := swc
    z.tf_idx    := tf_idx
    z.birth_bar := bar_index
    z.broken    := false
    if show
        z.bx := box.new(bar_index, ztop, bar_index + 50, zbot, border_color=color.new(clr, 50), bgcolor=color.new(clr, 85), border_width=1, extend=extend.right)
    arr.unshift(z)
    if arr.size() > max_z
        Zone old = arr.pop()
        if not na(old.bx)
            box.delete(old.bx)

// =============================================================================
// === SECTION 10: ZONE CREATION ON LEG TRANSITIONS
// =============================================================================

// Zone colors per TF
color z_m1_clr  = #78909C
color z_m5_clr  = #26A69A
color z_m15_clr = #42A5F5
color z_h1_clr  = #AB47BC
color z_h4_clr  = #FF7043
color z_d_clr   = #FFCA28

// --- M1 zones ---
if m1_fired
    if m1_swc == 1 or m1_swc == 2
        float s_top = nz(m1_phi)
        float s_bot = math.max(open, close)
        if na(s_bot) or s_bot >= s_top
            s_bot := s_top - (s_top - nz(m1_plo, s_top)) * 0.3
        create_zone(m1_sup, s_top, s_bot, -1, m1_swc, 0, i_show_zones and i_zone_m1, z_m1_clr, i_max_zones)
    else if m1_swc == 3 or m1_swc == 4
        float d_bot = nz(m1_plo)
        float d_top = math.min(open, close)
        if na(d_top) or d_top <= d_bot
            d_top := d_bot + (nz(m1_phi, d_bot) - d_bot) * 0.3
        create_zone(m1_dem, d_bot, d_top, 1, m1_swc, 0, i_show_zones and i_zone_m1, z_m1_clr, i_max_zones)

// --- M5 zones ---
if m5_fired
    if m5_swc == 1 or m5_swc == 2
        float s_top = nz(m5_phi)
        float s_bot = math.max(nz(m5o), nz(m5c))
        if na(s_bot) or s_bot >= s_top
            s_bot := s_top - (s_top - nz(m5_plo, s_top)) * 0.3
        create_zone(m5_sup, s_top, s_bot, -1, m5_swc, 1, i_show_zones and i_zone_m5, z_m5_clr, i_max_zones)
    else if m5_swc == 3 or m5_swc == 4
        float d_bot = nz(m5_plo)
        float d_top = math.min(nz(m5o), nz(m5c))
        if na(d_top) or d_top <= d_bot
            d_top := d_bot + (nz(m5_phi, d_bot) - d_bot) * 0.3
        create_zone(m5_dem, d_bot, d_top, 1, m5_swc, 1, i_show_zones and i_zone_m5, z_m5_clr, i_max_zones)

// --- M15 zones ---
if m15_fired
    if m15_swc == 1 or m15_swc == 2
        float s_top = nz(m15_phi)
        float s_bot = math.max(nz(m15o), nz(m15c))
        if na(s_bot) or s_bot >= s_top
            s_bot := s_top - (s_top - nz(m15_plo, s_top)) * 0.3
        create_zone(m15_sup, s_top, s_bot, -1, m15_swc, 2, i_show_zones and i_zone_m15, z_m15_clr, i_max_zones)
    else if m15_swc == 3 or m15_swc == 4
        float d_bot = nz(m15_plo)
        float d_top = math.min(nz(m15o), nz(m15c))
        if na(d_top) or d_top <= d_bot
            d_top := d_bot + (nz(m15_phi, d_bot) - d_bot) * 0.3
        create_zone(m15_dem, d_bot, d_top, 1, m15_swc, 2, i_show_zones and i_zone_m15, z_m15_clr, i_max_zones)

// --- H1 zones ---
if h1_fired
    if h1_swc == 1 or h1_swc == 2
        float s_top = nz(h1_phi)
        float s_bot = math.max(nz(h1o), nz(h1c))
        if na(s_bot) or s_bot >= s_top
            s_bot := s_top - (s_top - nz(h1_plo, s_top)) * 0.3
        create_zone(h1_sup, s_top, s_bot, -1, h1_swc, 3, i_show_zones and i_zone_h1, z_h1_clr, i_max_zones)
    else if h1_swc == 3 or h1_swc == 4
        float d_bot = nz(h1_plo)
        float d_top = math.min(nz(h1o), nz(h1c))
        if na(d_top) or d_top <= d_bot
            d_top := d_bot + (nz(h1_phi, d_bot) - d_bot) * 0.3
        create_zone(h1_dem, d_bot, d_top, 1, h1_swc, 3, i_show_zones and i_zone_h1, z_h1_clr, i_max_zones)

// --- H4 zones ---
if h4_fired
    if h4_swc == 1 or h4_swc == 2
        float s_top = nz(h4_phi)
        float s_bot = math.max(nz(h4o), nz(h4c))
        if na(s_bot) or s_bot >= s_top
            s_bot := s_top - (s_top - nz(h4_plo, s_top)) * 0.3
        create_zone(h4_sup, s_top, s_bot, -1, h4_swc, 4, i_show_zones and i_zone_h4, z_h4_clr, i_max_zones)
    else if h4_swc == 3 or h4_swc == 4
        float d_bot = nz(h4_plo)
        float d_top = math.min(nz(h4o), nz(h4c))
        if na(d_top) or d_top <= d_bot
            d_top := d_bot + (nz(h4_phi, d_bot) - d_bot) * 0.3
        create_zone(h4_dem, d_bot, d_top, 1, h4_swc, 4, i_show_zones and i_zone_h4, z_h4_clr, i_max_zones)

// --- D zones ---
if d_fired
    if d_swc == 1 or d_swc == 2
        float s_top = nz(d_phi)
        float s_bot = math.max(nz(d_o), nz(d_c))
        if na(s_bot) or s_bot >= s_top
            s_bot := s_top - (s_top - nz(d_plo, s_top)) * 0.3
        create_zone(d_sup, s_top, s_bot, -1, d_swc, 5, i_show_zones and i_zone_d, z_d_clr, i_max_zones)
    else if d_swc == 3 or d_swc == 4
        float d_bot = nz(d_plo)
        float d_top = math.min(nz(d_o), nz(d_c))
        if na(d_top) or d_top <= d_bot
            d_top := d_bot + (nz(d_phi, d_bot) - d_bot) * 0.3
        create_zone(d_dem, d_bot, d_top, 1, d_swc, 5, i_show_zones and i_zone_d, z_d_clr, i_max_zones)

// =============================================================================
// === SECTION 11: ZONE BREAK CHECKING
// =============================================================================

check_zone_breaks(array<Zone> zones, bool is_supply) =>
    int i = zones.size() - 1
    while i >= 0
        Zone z = zones.get(i)
        bool brk = is_supply ? close > z.top : close < z.bottom
        if brk
            if not na(z.bx)
                box.delete(z.bx)
            zones.remove(i)
        i -= 1

check_zone_breaks(m1_sup, true)
check_zone_breaks(m1_dem, false)
check_zone_breaks(m5_sup, true)
check_zone_breaks(m5_dem, false)
check_zone_breaks(m15_sup, true)
check_zone_breaks(m15_dem, false)
check_zone_breaks(h1_sup, true)
check_zone_breaks(h1_dem, false)
check_zone_breaks(h4_sup, true)
check_zone_breaks(h4_dem, false)
check_zone_breaks(d_sup, true)
check_zone_breaks(d_dem, false)

// =============================================================================
// ZONE COUNTING — H1, H4, D
// =============================================================================

var int h1_zone_cnt = 0
var int h1_zone_dir = 0
var int h4_zone_cnt = 0
var int h4_zone_dir = 0
var int d_zone_cnt  = 0
var int d_zone_dir  = 0

// H1 zone counting: on H1 leg transition
if h1_fired
    if h1_swc == 1 or h1_swc == 4  // HH or HL = bullish
        if h1_zone_dir >= 0
            h1_zone_cnt := h1_zone_cnt + 1
            h1_zone_dir := 1
        else
            h1_zone_cnt := 1
            h1_zone_dir := 1
    else if h1_swc == 3 or h1_swc == 2  // LL or LH = bearish
        if h1_zone_dir <= 0
            h1_zone_cnt := h1_zone_cnt + 1
            h1_zone_dir := -1
        else
            h1_zone_cnt := 1
            h1_zone_dir := -1

// H4 zone counting: on H4 leg transition
if h4_fired
    if h4_swc == 1 or h4_swc == 4  // HH or HL = bullish
        if h4_zone_dir >= 0
            h4_zone_cnt := h4_zone_cnt + 1
            h4_zone_dir := 1
        else
            h4_zone_cnt := 1
            h4_zone_dir := 1
    else if h4_swc == 3 or h4_swc == 2  // LL or LH = bearish
        if h4_zone_dir <= 0
            h4_zone_cnt := h4_zone_cnt + 1
            h4_zone_dir := -1
        else
            h4_zone_cnt := 1
            h4_zone_dir := -1

// D zone counting: on D leg transition
if d_fired
    if d_swc == 1 or d_swc == 4  // HH or HL = bullish
        if d_zone_dir >= 0
            d_zone_cnt := d_zone_cnt + 1
            d_zone_dir := 1
        else
            d_zone_cnt := 1
            d_zone_dir := 1
    else if d_swc == 3 or d_swc == 2  // LL or LH = bearish
        if d_zone_dir <= 0
            d_zone_cnt := d_zone_cnt + 1
            d_zone_dir := -1
        else
            d_zone_cnt := 1
            d_zone_dir := -1

// =============================================================================
// H1 EW STATE MACHINE (for exhaustion threshold)
// =============================================================================

var int   h1_ew_phase   = 0
var int   h1_ew_imp_cnt = 0
var int   h1_ew_cor_cnt = 0
var float h1_ew_b_w1_top = na
var float h1_ew_b_w1_bot = na
var float h1_ew_b_w2_bot = na
var float h1_ew_b_w3_top = na
var float h1_ew_b_w4_bot = na
var float h1_ew_b_w5_top = na
var float h1_ew_s_w1_bot = na
var float h1_ew_s_w1_top = na
var float h1_ew_s_w2_top = na
var float h1_ew_s_w3_bot = na
var float h1_ew_s_w4_top = na
var float h1_ew_s_w5_bot = na
var int   h1_ew_pattern  = 0

if h1_fired
    // Phase 0: INIT
    if h1_ew_phase == 0
        if h1_swc == 1  // HH → bull impulse
            h1_ew_phase    := 1
            h1_ew_imp_cnt  := 1
            h1_ew_b_w1_top := h1_phi
            h1_ew_b_w1_bot := nz(h1_plo)
        else if h1_swc == 3  // LL → bear impulse
            h1_ew_phase    := 3
            h1_ew_imp_cnt  := 1
            h1_ew_s_w1_bot := h1_plo
            h1_ew_s_w1_top := nz(h1_phi)

    // Phase 1: BULL IMPULSE
    else if h1_ew_phase == 1
        if h1_swc == 1  // HH continuation
            h1_ew_imp_cnt := h1_ew_imp_cnt + 1
            if h1_ew_imp_cnt == 3
                h1_ew_b_w3_top := h1_phi
            else if h1_ew_imp_cnt == 5
                h1_ew_b_w5_top := h1_phi
        else if h1_swc == 4  // HL = correction within
            if h1_ew_imp_cnt == 1
                h1_ew_b_w2_bot := h1_plo
            else if h1_ew_imp_cnt >= 3 and na(h1_ew_b_w4_bot)
                h1_ew_b_w4_bot := h1_plo
        else if h1_swc == 2  // LH → transition to correction
            if h1_ew_imp_cnt >= 3
                h1_ew_phase   := 2
                h1_ew_cor_cnt := 1
        else if h1_swc == 3  // LL → full reversal to bear
            h1_ew_phase    := 3
            h1_ew_imp_cnt  := 1
            h1_ew_s_w1_bot := h1_plo
            h1_ew_s_w1_top := nz(h1_phi)
            h1_ew_s_w2_top := na
            h1_ew_s_w3_bot := na
            h1_ew_s_w4_top := na
            h1_ew_s_w5_bot := na

    // Phase 2: BULL CORRECTION
    else if h1_ew_phase == 2
        if h1_swc == 1  // HH → new bull impulse
            h1_ew_phase    := 1
            h1_ew_imp_cnt  := 1
            h1_ew_b_w1_top := h1_phi
            h1_ew_b_w1_bot := nz(h1_plo)
            h1_ew_b_w2_bot := na
            h1_ew_b_w3_top := na
            h1_ew_b_w4_bot := na
            h1_ew_b_w5_top := na
        else if h1_swc == 4 or h1_swc == 2
            h1_ew_cor_cnt := h1_ew_cor_cnt + 1
        else if h1_swc == 3  // LL → bear takes over
            h1_ew_phase    := 3
            h1_ew_imp_cnt  := 1
            h1_ew_s_w1_bot := h1_plo
            h1_ew_s_w1_top := nz(h1_phi)
            h1_ew_s_w2_top := na
            h1_ew_s_w3_bot := na
            h1_ew_s_w4_top := na
            h1_ew_s_w5_bot := na

    // Phase 3: BEAR IMPULSE
    else if h1_ew_phase == 3
        if h1_swc == 3  // LL continuation
            h1_ew_imp_cnt := h1_ew_imp_cnt + 1
            if h1_ew_imp_cnt == 3
                h1_ew_s_w3_bot := h1_plo
            else if h1_ew_imp_cnt == 5
                h1_ew_s_w5_bot := h1_plo
        else if h1_swc == 2  // LH = correction within
            if h1_ew_imp_cnt == 1
                h1_ew_s_w2_top := h1_phi
            else if h1_ew_imp_cnt >= 3 and na(h1_ew_s_w4_top)
                h1_ew_s_w4_top := h1_phi
        else if h1_swc == 4  // HL → transition to correction
            if h1_ew_imp_cnt >= 3
                h1_ew_phase   := 4
                h1_ew_cor_cnt := 1
        else if h1_swc == 1  // HH → full reversal to bull
            h1_ew_phase    := 1
            h1_ew_imp_cnt  := 1
            h1_ew_b_w1_top := h1_phi
            h1_ew_b_w1_bot := nz(h1_plo)
            h1_ew_b_w2_bot := na
            h1_ew_b_w3_top := na
            h1_ew_b_w4_bot := na
            h1_ew_b_w5_top := na

    // Phase 4: BEAR CORRECTION
    else if h1_ew_phase == 4
        if h1_swc == 3  // LL → new bear impulse
            h1_ew_phase    := 3
            h1_ew_imp_cnt  := 1
            h1_ew_s_w1_bot := h1_plo
            h1_ew_s_w1_top := nz(h1_phi)
            h1_ew_s_w2_top := na
            h1_ew_s_w3_bot := na
            h1_ew_s_w4_top := na
            h1_ew_s_w5_bot := na
        else if h1_swc == 2 or h1_swc == 4
            h1_ew_cor_cnt := h1_ew_cor_cnt + 1
        else if h1_swc == 1  // HH → bull takes over
            h1_ew_phase    := 1
            h1_ew_imp_cnt  := 1
            h1_ew_b_w1_top := h1_phi
            h1_ew_b_w1_bot := nz(h1_plo)
            h1_ew_b_w2_bot := na
            h1_ew_b_w3_top := na
            h1_ew_b_w4_bot := na
            h1_ew_b_w5_top := na

// Pattern classification
if h1_ew_phase == 1 and h1_ew_imp_cnt >= 2
    if not na(h1_ew_b_w1_top) and not na(h1_ew_b_w4_bot)
        if h1_ew_b_w4_bot < h1_ew_b_w1_top
            h1_ew_pattern := 2  // DIAGONAL
        else
            float h1_w1r = nz(h1_ew_b_w1_top) - nz(h1_ew_b_w1_bot)
            float h1_w3r = not na(h1_ew_b_w3_top) and not na(h1_ew_b_w2_bot) ? (h1_ew_b_w3_top - h1_ew_b_w2_bot) : 0.0
            h1_ew_pattern := h1_w1r > 0 and h1_w3r > h1_w1r * 1.618 ? 3 : 1
    else if not na(h1_ew_b_w1_top)
        h1_ew_pattern := 1  // IMPULSE
else if h1_ew_phase == 3 and h1_ew_imp_cnt >= 2
    if not na(h1_ew_s_w1_bot) and not na(h1_ew_s_w4_top)
        if h1_ew_s_w4_top > h1_ew_s_w1_bot
            h1_ew_pattern := 2  // DIAGONAL
        else
            float h1_w1rs = nz(h1_ew_s_w1_top) - nz(h1_ew_s_w1_bot)
            float h1_w3rs = not na(h1_ew_s_w3_bot) and not na(h1_ew_s_w2_top) ? (h1_ew_s_w2_top - h1_ew_s_w3_bot) : 0.0
            h1_ew_pattern := h1_w1rs > 0 and h1_w3rs > h1_w1rs * 1.618 ? 3 : 1
    else if not na(h1_ew_s_w1_bot)
        h1_ew_pattern := 1

int h1_ew_thr = h1_ew_pattern == 2 ? 4 : h1_ew_pattern == 3 ? 8 : 5

// =============================================================================
// OPPOSING NESTING — H1 zones inside opposing H4 zones
// =============================================================================

bool opp_nesting = false
// H1 demand inside H4 supply
if h1_dem.size() > 0 and h4_sup.size() > 0
    for int i = 0 to math.min(h1_dem.size() - 1, 3)
        Zone hd = h1_dem.get(i)
        for int j = 0 to math.min(h4_sup.size() - 1, 3)
            Zone hs = h4_sup.get(j)
            if hd.top < hs.top and hd.bottom > hs.bottom
                opp_nesting := true
// H1 supply inside H4 demand
if h1_sup.size() > 0 and h4_dem.size() > 0
    for int i = 0 to math.min(h1_sup.size() - 1, 3)
        Zone hs2 = h1_sup.get(i)
        for int j = 0 to math.min(h4_dem.size() - 1, 3)
            Zone hd2 = h4_dem.get(j)
            if hs2.bottom > hd2.bottom and hs2.top < hd2.top
                opp_nesting := true

// =============================================================================
// MOMENTUM CONSUMPTION
// =============================================================================

type ConsumptionCycle
    string parent_tf  = ""
    int    parent_dir = 0
    bool   active     = false
    bool   m1_flip    = false
    bool   m5_flip    = false
    bool   m15_flip   = false
    bool   h1_flip    = false
    int    score      = 0

var ConsumptionCycle consume = ConsumptionCycle.new()

// Trigger on H4 STRONG CHoCH
if h4_cv == 3
    consume.parent_tf  := "H4"
    consume.parent_dir := h4_sd
    consume.active     := true
    consume.m1_flip    := false
    consume.m5_flip    := false
    consume.m15_flip   := false
    consume.h1_flip    := false
    consume.score      := 0

// D STRONG CHoCH supersedes
if d_cv == 3
    consume.parent_tf  := "D"
    consume.parent_dir := d_sd
    consume.active     := true
    consume.m1_flip    := false
    consume.m5_flip    := false
    consume.m15_flip   := false
    consume.h1_flip    := false
    consume.score      := 0

// Track child flips
if consume.active
    if not consume.m1_flip and m1_cv == 3 and m1_sd == consume.parent_dir
        consume.m1_flip := true
        consume.score   := consume.score + 1
    if not consume.m5_flip and m5_cv == 3 and m5_sd == consume.parent_dir
        consume.m5_flip := true
        consume.score   := consume.score + 1
    if not consume.m15_flip and m15_cv == 3 and m15_sd == consume.parent_dir
        consume.m15_flip := true
        consume.score    := consume.score + 1
    if not consume.h1_flip and h1_cv == 3 and h1_sd == consume.parent_dir
        consume.h1_flip := true
        consume.score   := consume.score + 1

// =============================================================================
// 1-2-3 CASCADE DETECTION
// =============================================================================

// Per-TF 3-zone compression detection
detect_123(array<Zone> sup_arr, array<Zone> dem_arr) =>
    bool bear = false
    bool bull = false
    if dem_arr.size() >= 2 and sup_arr.size() >= 1
        Zone d1 = dem_arr.get(1)
        Zone s1 = sup_arr.get(0)
        Zone d2 = dem_arr.get(0)
        if s1.birth_bar > d1.birth_bar and d2.birth_bar > s1.birth_bar
            bear := d2.top < s1.bottom
    if sup_arr.size() >= 2 and dem_arr.size() >= 1
        Zone s1b = sup_arr.get(1)
        Zone d1b = dem_arr.get(0)
        Zone s2b = sup_arr.get(0)
        if d1b.birth_bar > s1b.birth_bar and s2b.birth_bar > d1b.birth_bar
            bull := s2b.bottom > d1b.top
    [bear, bull]

[d_123_bear,  d_123_bull]  = detect_123(d_sup, d_dem)
[h4_123_bear, h4_123_bull] = detect_123(h4_sup, h4_dem)
[h1_123_bear, h1_123_bull] = detect_123(h1_sup, h1_dem)
[m15_123_bear, m15_123_bull] = detect_123(m15_sup, m15_dem)
[m5_123_bear, m5_123_bull] = detect_123(m5_sup, m5_dem)

// Zone containment check
is_inside_zone(array<Zone> zones) =>
    bool inside = false
    if zones.size() > 0
        for int i = 0 to math.min(zones.size() - 1, 7)
            Zone z = zones.get(i)
            if close >= z.bottom and close <= z.top
                inside := true
    inside

// Cascade arming — bearish
bool d_armed_bear   = d_123_bear
bool h4_armed_bear  = d_armed_bear and h4_123_bear and is_inside_zone(d_sup)
bool h1_armed_bear  = h4_armed_bear and h1_123_bear and is_inside_zone(h4_sup)
bool m15_armed_bear = h1_armed_bear and m15_123_bear and is_inside_zone(h1_sup)
bool m5_armed_bear  = m15_armed_bear and m5_123_bear and is_inside_zone(m15_sup)

// Cascade arming — bullish
bool d_armed_bull   = d_123_bull
bool h4_armed_bull  = d_armed_bull and h4_123_bull and is_inside_zone(d_dem)
bool h1_armed_bull  = h4_armed_bull and h1_123_bull and is_inside_zone(h4_dem)
bool m15_armed_bull = h1_armed_bull and m15_123_bull and is_inside_zone(h1_dem)
bool m5_armed_bull  = m15_armed_bull and m5_123_bull and is_inside_zone(m15_dem)

// Output: highest armed level
string cascade_level = m5_armed_bear or m5_armed_bull ? "M5" : m15_armed_bear or m15_armed_bull ? "M15" : h1_armed_bear or h1_armed_bull ? "H1" : h4_armed_bear or h4_armed_bull ? "H4" : d_armed_bear or d_armed_bull ? "D" : "—"
int cascade_dir = m5_armed_bear ? -1 : m5_armed_bull ? 1 : 0

// =============================================================================
// TRENDLINE BREAK DETECTION — M5 and M15
// =============================================================================

// M5 ascending TL (bullish support — breaks bearish)
var float m5_tl_bull_y1 = na
var float m5_tl_bull_y2 = na
var int   m5_tl_bull_x1 = na
var int   m5_tl_bull_x2 = na
if m5_fired and m5_swc == 4  // HL swing
    m5_tl_bull_y1 := nz(m5_tl_bull_y2, m5_plo)
    m5_tl_bull_x1 := nz(m5_tl_bull_x2, bar_index - 10)
    m5_tl_bull_y2 := m5_plo
    m5_tl_bull_x2 := bar_index

float m5_tl_bull_proj = na
if not na(m5_tl_bull_x1) and not na(m5_tl_bull_x2) and m5_tl_bull_x2 > m5_tl_bull_x1
    float m5_slope_b = (m5_tl_bull_y2 - m5_tl_bull_y1) / (m5_tl_bull_x2 - m5_tl_bull_x1)
    m5_tl_bull_proj := m5_tl_bull_y2 + m5_slope_b * (bar_index - m5_tl_bull_x2)
bool m5_tl_bull_break = not na(m5_tl_bull_proj) and close < m5_tl_bull_proj and close[1] >= nz(m5_tl_bull_proj[1])

// M5 descending TL (bearish resistance — breaks bullish)
var float m5_tl_bear_y1 = na
var float m5_tl_bear_y2 = na
var int   m5_tl_bear_x1 = na
var int   m5_tl_bear_x2 = na
if m5_fired and m5_swc == 2  // LH swing
    m5_tl_bear_y1 := nz(m5_tl_bear_y2, m5_phi)
    m5_tl_bear_x1 := nz(m5_tl_bear_x2, bar_index - 10)
    m5_tl_bear_y2 := m5_phi
    m5_tl_bear_x2 := bar_index

float m5_tl_bear_proj = na
if not na(m5_tl_bear_x1) and not na(m5_tl_bear_x2) and m5_tl_bear_x2 > m5_tl_bear_x1
    float m5_slope_s = (m5_tl_bear_y2 - m5_tl_bear_y1) / (m5_tl_bear_x2 - m5_tl_bear_x1)
    m5_tl_bear_proj := m5_tl_bear_y2 + m5_slope_s * (bar_index - m5_tl_bear_x2)
bool m5_tl_bear_break = not na(m5_tl_bear_proj) and close > m5_tl_bear_proj and close[1] <= nz(m5_tl_bear_proj[1])

// M15 ascending TL
var float m15_tl_bull_y1 = na
var float m15_tl_bull_y2 = na
var int   m15_tl_bull_x1 = na
var int   m15_tl_bull_x2 = na
if m15_fired and m15_swc == 4
    m15_tl_bull_y1 := nz(m15_tl_bull_y2, m15_plo)
    m15_tl_bull_x1 := nz(m15_tl_bull_x2, bar_index - 10)
    m15_tl_bull_y2 := m15_plo
    m15_tl_bull_x2 := bar_index

float m15_tl_bull_proj = na
if not na(m15_tl_bull_x1) and not na(m15_tl_bull_x2) and m15_tl_bull_x2 > m15_tl_bull_x1
    float m15_slope_b = (m15_tl_bull_y2 - m15_tl_bull_y1) / (m15_tl_bull_x2 - m15_tl_bull_x1)
    m15_tl_bull_proj := m15_tl_bull_y2 + m15_slope_b * (bar_index - m15_tl_bull_x2)
bool m15_tl_bull_break = not na(m15_tl_bull_proj) and close < m15_tl_bull_proj and close[1] >= nz(m15_tl_bull_proj[1])

// M15 descending TL
var float m15_tl_bear_y1 = na
var float m15_tl_bear_y2 = na
var int   m15_tl_bear_x1 = na
var int   m15_tl_bear_x2 = na
if m15_fired and m15_swc == 2
    m15_tl_bear_y1 := nz(m15_tl_bear_y2, m15_phi)
    m15_tl_bear_x1 := nz(m15_tl_bear_x2, bar_index - 10)
    m15_tl_bear_y2 := m15_phi
    m15_tl_bear_x2 := bar_index

float m15_tl_bear_proj = na
if not na(m15_tl_bear_x1) and not na(m15_tl_bear_x2) and m15_tl_bear_x2 > m15_tl_bear_x1
    float m15_slope_s = (m15_tl_bear_y2 - m15_tl_bear_y1) / (m15_tl_bear_x2 - m15_tl_bear_x1)
    m15_tl_bear_proj := m15_tl_bear_y2 + m15_slope_s * (bar_index - m15_tl_bear_x2)
bool m15_tl_bear_break = not na(m15_tl_bear_proj) and close > m15_tl_bear_proj and close[1] <= nz(m15_tl_bear_proj[1])

// =============================================================================
// TERMINAL EXHAUSTION GATE
// =============================================================================

bool d_level_broken = d_swc != 0

bool h4_counter = false
if d_dir < 0 and h4_dem.size() > 0
    Zone z_h4c = h4_dem.get(0)
    h4_counter := z_h4c.bottom < nz(d_plo)
else if d_dir > 0 and h4_sup.size() > 0
    Zone z_h4c = h4_sup.get(0)
    h4_counter := z_h4c.top > nz(d_phi)

bool h1_count_met = h1_zone_cnt >= h1_ew_thr
bool terminal_active = d_level_broken and h4_counter and h1_count_met and opp_nesting

// =============================================================================
// D-LEVEL CYCLE PHASE
// =============================================================================

var int   d_cycle_phase      = 0
var bool  d_cycle_running    = false
var float d_cycle_boundary_hi = na
var float d_cycle_boundary_lo = na

// Phase A entry: terminal exhaustion first fires
if terminal_active and not d_cycle_running
    d_cycle_phase      := 1
    d_cycle_running    := true
    if d_dir < 0
        d_cycle_boundary_hi := nz(d_phi)
        d_cycle_boundary_lo := h1_sup.size() > 0 ? h1_sup.get(0).bottom : nz(d_phi)
    else
        d_cycle_boundary_lo := nz(d_plo)
        d_cycle_boundary_hi := h1_dem.size() > 0 ? h1_dem.get(0).top : nz(d_plo)

if d_cycle_running
    if d_cycle_phase == 1
        if h4_counter
            d_cycle_phase := 2
    else if d_cycle_phase == 2
        bool in_boundary = close >= d_cycle_boundary_lo and close <= d_cycle_boundary_hi
        if in_boundary
            d_cycle_phase := 3
    else if d_cycle_phase == 3
        if d_fired and d_swc != 0
            d_cycle_phase := 4
    else if d_cycle_phase == 4
        if d_fired and ((d_dir < 0 and d_swc == 3) or (d_dir > 0 and d_swc == 1))
            d_cycle_phase := 5
    else if d_cycle_phase == 5
        d_cycle_running := false
        d_cycle_phase   := 0

// Is there an M15 zone nested inside an H4 zone on the reversal side?
is_m15_nested_h4(int reversal_dir) =>
    bool nested = false
    array<Zone> m15_z = reversal_dir > 0 ? m15_dem : m15_sup
    array<Zone> h4_z  = reversal_dir > 0 ? h4_dem  : h4_sup
    if m15_z.size() > 0 and h4_z.size() > 0
        for int i = 0 to math.min(m15_z.size() - 1, 3)
            Zone mz = m15_z.get(i)
            for int j = 0 to math.min(h4_z.size() - 1, 3)
                Zone hz = h4_z.get(j)
                if mz.top <= hz.top and mz.bottom >= hz.bottom
                    nested := true
    nested

// M5 zone proximity: is price inside the M5 zone we'd use for entry?
bool at_m5_dem = is_inside_zone(m5_dem)
bool at_m5_sup = is_inside_zone(m5_sup)

// Model A: Terminal Reversal
int reversal_dir = d_dir < 0 ? 1 : d_dir > 0 ? -1 : 0
bool m15_tl_brk = reversal_dir > 0 ? m15_tl_bear_break : m15_tl_bull_break
bool at_m5_a = reversal_dir > 0 ? at_m5_dem : at_m5_sup
bool model_a = terminal_active and consume.score >= 2 and is_m15_nested_h4(reversal_dir) and m15_tl_brk and (cascade_dir == reversal_dir and cascade_level == "M5") and m1_cv == 3 and m1_sd == reversal_dir and at_m5_a

var bool model_a_prev = false
bool model_a_fire = model_a and not model_a_prev
model_a_prev := model_a

// Model B: Mode B Continuation — D-cycle Phase D push with full consumption
bool at_m5_b = d_dir > 0 ? at_m5_dem : at_m5_sup
bool model_b = d_cycle_phase == 4 and consume.score == 4 and (m5_fired or m15_fired) and at_m5_b

var bool model_b_prev = false
bool model_b_fire = model_b and not model_b_prev
model_b_prev := model_b

// =============================================================================
// ENTRY MODEL C: 1-2-3 Cascade Add-On
// =============================================================================
int cascade_add_dir = cascade_dir
bool in_zone_c = cascade_add_dir > 0 ? (is_inside_zone(m15_dem) or is_inside_zone(h1_dem)) : (is_inside_zone(m15_sup) or is_inside_zone(h1_sup))
bool at_m5_c = cascade_add_dir > 0 ? at_m5_dem : at_m5_sup
bool model_c = cascade_level == "M5" and m1_cv == 3 and m1_sd == cascade_add_dir and in_zone_c and at_m5_c

var bool model_c_prev = false
bool model_c_fire = model_c and not model_c_prev
model_c_prev := model_c

// =============================================================================
// ENTRY MODEL D: Macro Bias Limit Order
// =============================================================================
bool m5_tl_brk_d = d_dir > 0 ? m5_tl_bull_break : m5_tl_bear_break
bool in_zone_d = d_dir > 0 ? (is_inside_zone(h4_dem) or is_inside_zone(d_dem)) : (is_inside_zone(h4_sup) or is_inside_zone(d_sup))
bool at_m5_d = d_dir > 0 ? at_m5_dem : at_m5_sup
bool model_d = m5_tl_brk_d and in_zone_d and not terminal_active and at_m5_d

var bool model_d_prev = false
bool model_d_fire = model_d and not model_d_prev
model_d_prev := model_d

// =============================================================================
// SL/TP COMPUTATION + ON-CHART SIGNALS
// =============================================================================
var float sig_entry = na
var float sig_sl    = na
var float sig_tp    = na
var int   sig_model = 0
var int   sig_dir   = 0

if model_a_fire
    sig_model := 1
    sig_dir   := reversal_dir
    if reversal_dir > 0 and m5_dem.size() > 0
        Zone ez = m5_dem.get(0)
        sig_entry := ez.bottom
    else if reversal_dir < 0 and m5_sup.size() > 0
        Zone ez = m5_sup.get(0)
        sig_entry := ez.top
    if reversal_dir > 0 and m1_sup.size() > 0
        Zone sz = m1_sup.get(0)
        sig_sl := sz.top + syminfo.mintick * 10
    else if reversal_dir < 0 and m1_dem.size() > 0
        Zone sz = m1_dem.get(0)
        sig_sl := sz.bottom - syminfo.mintick * 10
    if reversal_dir > 0 and h1_sup.size() > 0
        Zone tz = h1_sup.get(0)
        sig_tp := tz.bottom
    else if reversal_dir < 0 and h1_dem.size() > 0
        Zone tz = h1_dem.get(0)
        sig_tp := tz.top

if model_b_fire
    sig_model := 2
    sig_dir   := d_dir
    if d_dir > 0 and m5_dem.size() > 0
        Zone ez = m5_dem.get(0)
        sig_entry := ez.bottom
    else if d_dir < 0 and m5_sup.size() > 0
        Zone ez = m5_sup.get(0)
        sig_entry := ez.top
    if d_dir > 0 and m5_sup.size() > 0
        Zone sz = m5_sup.get(0)
        sig_sl := sz.top + syminfo.mintick * 10
    else if d_dir < 0 and m5_dem.size() > 0
        Zone sz = m5_dem.get(0)
        sig_sl := sz.bottom - syminfo.mintick * 10
    if d_dir > 0 and h4_sup.size() > 0
        Zone tz = h4_sup.get(0)
        sig_tp := tz.bottom
    else if d_dir < 0 and h4_dem.size() > 0
        Zone tz = h4_dem.get(0)
        sig_tp := tz.top

if model_c_fire
    sig_model := 3
    sig_dir   := cascade_add_dir
    if cascade_add_dir > 0 and m5_dem.size() > 0
        Zone ez = m5_dem.get(0)
        sig_entry := ez.bottom
    else if cascade_add_dir < 0 and m5_sup.size() > 0
        Zone ez = m5_sup.get(0)
        sig_entry := ez.top
    if cascade_add_dir > 0 and m5_sup.size() > 0
        Zone sz = m5_sup.get(0)
        sig_sl := sz.top + syminfo.mintick * 10
    else if cascade_add_dir < 0 and m5_dem.size() > 0
        Zone sz = m5_dem.get(0)
        sig_sl := sz.bottom - syminfo.mintick * 10
    if cascade_add_dir > 0 and m15_sup.size() > 0
        Zone tz = m15_sup.get(0)
        sig_tp := tz.bottom
    else if cascade_add_dir < 0 and m15_dem.size() > 0
        Zone tz = m15_dem.get(0)
        sig_tp := tz.top

if model_d_fire
    sig_model := 4
    sig_dir   := d_dir
    if d_dir > 0 and m5_dem.size() > 0
        Zone ez = m5_dem.get(0)
        sig_entry := ez.bottom
    else if d_dir < 0 and m5_sup.size() > 0
        Zone ez = m5_sup.get(0)
        sig_entry := ez.top
    if d_dir > 0 and m5_sup.size() > 0
        Zone sz = m5_sup.get(0)
        sig_sl := sz.top + syminfo.mintick * 10
    else if d_dir < 0 and m5_dem.size() > 0
        Zone sz = m5_dem.get(0)
        sig_sl := sz.bottom - syminfo.mintick * 10
    if d_dir > 0 and h4_sup.size() > 0
        Zone tz = h4_sup.get(0)
        sig_tp := tz.bottom
    else if d_dir < 0 and h4_dem.size() > 0
        Zone tz = h4_dem.get(0)
        sig_tp := tz.top

// =============================================================================
// ON-CHART SIGNAL MARKERS
// =============================================================================
plotshape(model_a_fire and sig_dir > 0,  "Model A Long",  shape.diamond,      location.belowbar, #26A69A, size=size.normal)
plotshape(model_a_fire and sig_dir < 0,  "Model A Short", shape.diamond,      location.abovebar, #EF5350, size=size.normal)
plotshape(model_b_fire and sig_dir > 0,  "Model B Long",  shape.arrowup,      location.belowbar, #42A5F5, size=size.small)
plotshape(model_b_fire and sig_dir < 0,  "Model B Short", shape.arrowdown,    location.abovebar, #42A5F5, size=size.small)
plotshape(model_c_fire and sig_dir > 0,  "Model C Long",  shape.triangleup,   location.belowbar, #FFCA28, size=size.tiny)
plotshape(model_c_fire and sig_dir < 0,  "Model C Short", shape.triangledown, location.abovebar, #FFCA28, size=size.tiny)
plotshape(model_d_fire and sig_dir > 0,  "Model D Long",  shape.circle,       location.belowbar, #AB47BC, size=size.small)
plotshape(model_d_fire and sig_dir < 0,  "Model D Short", shape.circle,       location.abovebar, #AB47BC, size=size.small)

// =============================================================================
// SL/TP LINES
// =============================================================================
var line sl_ln = na
var line tp_ln = na
if model_a_fire or model_b_fire or model_c_fire or model_d_fire
    if not na(sl_ln)
        line.delete(sl_ln)
    if not na(tp_ln)
        line.delete(tp_ln)
    if not na(sig_sl)
        sl_ln := line.new(bar_index, sig_sl, bar_index + 50, sig_sl, color=color.new(#EF5350, 30), style=line.style_dashed, width=1)
    if not na(sig_tp)
        tp_ln := line.new(bar_index, sig_tp, bar_index + 50, sig_tp, color=color.new(#26A69A, 30), style=line.style_dashed, width=1)

// =============================================================================
// SIGNAL DASHBOARD
// =============================================================================
if i_dash_on and barstate.islast
    string tbl_pos = switch i_dash_pos
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Right" => position.bottom_right
        =>                position.bottom_left

    var table sig_tbl = na
    if not na(sig_tbl)
        table.delete(sig_tbl)

    sig_tbl := table.new(tbl_pos, 2, 7, bgcolor=color.new(#1A1A2E, 10), border_width=1, border_color=color.new(#3A3A5A, 50), frame_width=1, frame_color=color.new(#3A3A5A, 30))

    color hdr_bg  = color.new(#0D1117, 0)
    color hdr_txt = color.new(#58A6FF, 0)
    color cell_bg = color.new(#161B22, 0)
    string hdr_sz  = size.tiny
    string cell_sz = size.tiny

    // Header row
    table.cell(sig_tbl, 0, 0, "Signal Engine", text_color=hdr_txt, bgcolor=hdr_bg, text_size=hdr_sz)
    table.cell(sig_tbl, 1, 0, "",               text_color=hdr_txt, bgcolor=hdr_bg, text_size=hdr_sz)

    // Row 1: Phase + Terminal
    string phase_str = d_cycle_phase == 0 ? "—" : str.tostring(d_cycle_phase)
    string term_str  = terminal_active ? "ACTIVE" : "—"
    color  term_clr  = terminal_active ? color.new(#EF5350, 0) : color.new(#546E7A, 0)
    table.cell(sig_tbl, 0, 1, "Phase: " + phase_str, text_color=color.new(#B0BEC5, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(sig_tbl, 1, 1, "Terminal: " + term_str, text_color=term_clr, bgcolor=cell_bg, text_size=cell_sz)

    // Row 2: Consumption + H1 Zones
    string cons_str = str.tostring(consume.score) + "/4"
    string zone_str = str.tostring(h1_zone_cnt) + "/" + str.tostring(h1_ew_thr)
    color zone_clr = h1_zone_cnt >= h1_ew_thr ? color.new(#EF5350, 0) : color.new(#B0BEC5, 0)
    table.cell(sig_tbl, 0, 2, "Consume: " + cons_str, text_color=color.new(#B0BEC5, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(sig_tbl, 1, 2, "H1 Zones: " + zone_str, text_color=zone_clr, bgcolor=cell_bg, text_size=cell_sz)

    // Row 3: Cascade + Bias
    string bias_str = d_dir > 0 ? "BULL" : d_dir < 0 ? "BEAR" : "—"
    color bias_clr = d_dir > 0 ? color.new(#26A69A, 0) : d_dir < 0 ? color.new(#EF5350, 0) : color.new(#546E7A, 0)
    table.cell(sig_tbl, 0, 3, "Cascade: " + cascade_level, text_color=color.new(#B0BEC5, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(sig_tbl, 1, 3, "Bias: " + bias_str, text_color=bias_clr, bgcolor=cell_bg, text_size=cell_sz)

    // Row 4: Signal header (separator)
    color sig_hdr_bg = color.new(#0D1117, 0)
    table.cell(sig_tbl, 0, 4, "Active Signal", text_color=hdr_txt, bgcolor=sig_hdr_bg, text_size=hdr_sz)
    table.cell(sig_tbl, 1, 4, "",               text_color=hdr_txt, bgcolor=sig_hdr_bg, text_size=hdr_sz)

    // Row 5-6: Active signal details
    string mdl_lbl = sig_model == 1 ? "A" : sig_model == 2 ? "B" : sig_model == 3 ? "C" : sig_model == 4 ? "D" : "—"
    string dir_lbl = sig_dir > 0 ? "LONG" : sig_dir < 0 ? "SHORT" : "—"
    float rr_ratio = not na(sig_entry) and not na(sig_sl) and not na(sig_tp) and sig_sl != sig_entry ? math.abs(sig_tp - sig_entry) / math.abs(sig_sl - sig_entry) : na
    string rr_str = not na(rr_ratio) ? "1:" + str.tostring(rr_ratio, "#.#") : "—"
    color dir_clr = sig_dir > 0 ? color.new(#26A69A, 0) : sig_dir < 0 ? color.new(#EF5350, 0) : color.new(#546E7A, 0)

    table.cell(sig_tbl, 0, 5, "Model: " + mdl_lbl + " " + dir_lbl, text_color=dir_clr, bgcolor=cell_bg, text_size=cell_sz)
    table.cell(sig_tbl, 1, 5, "R:R: " + rr_str, text_color=color.new(#B0BEC5, 0), bgcolor=cell_bg, text_size=cell_sz)

    string entry_str = not na(sig_entry) ? str.tostring(sig_entry, format.mintick) : "—"
    string sl_str    = not na(sig_sl)    ? str.tostring(sig_sl,    format.mintick) : "—"
    string tp_str    = not na(sig_tp)    ? str.tostring(sig_tp,    format.mintick) : "—"
    table.cell(sig_tbl, 0, 6, "E:" + entry_str + " SL:" + sl_str, text_color=color.new(#78909C, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(sig_tbl, 1, 6, "TP:" + tp_str, text_color=color.new(#78909C, 0), bgcolor=cell_bg, text_size=cell_sz)
