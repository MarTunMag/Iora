//@version=6
indicator("Iora Pivot Trendlines", shorttitle="Pivot TL", overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════
string i_lv1 = input.string("H1",  "Level 1", options=["Off","M1","M5","M15","M30","H1","H2","H3","H4","D1","W1","MN","3MN","6MN","12MN"], group="Pivot Levels")
string i_lv2 = input.string("H4",  "Level 2", options=["Off","M1","M5","M15","M30","H1","H2","H3","H4","D1","W1","MN","3MN","6MN","12MN"], group="Pivot Levels")
string i_lv3 = input.string("D1",  "Level 3", options=["Off","M1","M5","M15","M30","H1","H2","H3","H4","D1","W1","MN","3MN","6MN","12MN"], group="Pivot Levels")
string i_lv4 = input.string("W1",  "Level 4", options=["Off","M1","M5","M15","M30","H1","H2","H3","H4","D1","W1","MN","3MN","6MN","12MN"], group="Pivot Levels")
string i_lv5 = input.string("Off", "Level 5", options=["Off","M1","M5","M15","M30","H1","H2","H3","H4","D1","W1","MN","3MN","6MN","12MN"], group="Pivot Levels")
string i_lv6 = input.string("Off", "Level 6", options=["Off","M1","M5","M15","M30","H1","H2","H3","H4","D1","W1","MN","3MN","6MN","12MN"], group="Pivot Levels")

int    i_rightLen   = input.int(1, "Right Lookback", minval=0, maxval=5, group="Settings")
int    i_tlHistory  = input.int(5, "Broken TL History", minval=0, maxval=20, tooltip="Broken trendlines to keep visible", group="Settings")
string i_breakType  = input.string("Close", "Break Detection", options=["Close", "Wick"], group="Settings")
bool   i_showAnchors = input.bool(true, "Show Anchor Markers", group="Display")
int    i_tlWidth    = input.int(2, "Trendline Width", minval=1, maxval=4, group="Display")
color  i_hiTlClr   = input.color(#ef5350, "Descending TL (Highs)", group="Colors")
color  i_loTlClr   = input.color(#26a69a, "Ascending TL (Lows)", group="Colors")

// ═══════════════════════════════════════════════════════════════
// TIMEFRAME MATH
// ═══════════════════════════════════════════════════════════════
tfToMin(string tf) =>
    switch tf
        "M1"   => 1
        "M5"   => 5
        "M15"  => 15
        "M30"  => 30
        "H1"   => 60
        "H2"   => 120
        "H3"   => 180
        "H4"   => 240
        "D1"   => 1440
        "W1"   => 10080
        "MN"   => 43200
        "3MN"  => 129600
        "6MN"  => 259200
        "12MN" => 518400
        => 0

int _chartMin = math.max(1, timeframe.in_seconds(timeframe.period) / 60)
int _maxLeft  = 4999 - i_rightLen

int left1 = math.min(_maxLeft, math.max(2, tfToMin(i_lv1) / _chartMin))
int left2 = math.min(_maxLeft, math.max(2, tfToMin(i_lv2) / _chartMin))
int left3 = math.min(_maxLeft, math.max(2, tfToMin(i_lv3) / _chartMin))
int left4 = math.min(_maxLeft, math.max(2, tfToMin(i_lv4) / _chartMin))
int left5 = math.min(_maxLeft, math.max(2, tfToMin(i_lv5) / _chartMin))
int left6 = math.min(_maxLeft, math.max(2, tfToMin(i_lv6) / _chartMin))

// ═══════════════════════════════════════════════════════════════
// PIVOT DETECTION
// ═══════════════════════════════════════════════════════════════
max_bars_back(high, 5000)
max_bars_back(low, 5000)

float ph1 = i_lv1 != "Off" ? ta.pivothigh(high, left1, i_rightLen) : na
float pl1 = i_lv1 != "Off" ? ta.pivotlow(low,   left1, i_rightLen) : na
float ph2 = i_lv2 != "Off" ? ta.pivothigh(high, left2, i_rightLen) : na
float pl2 = i_lv2 != "Off" ? ta.pivotlow(low,   left2, i_rightLen) : na
float ph3 = i_lv3 != "Off" ? ta.pivothigh(high, left3, i_rightLen) : na
float pl3 = i_lv3 != "Off" ? ta.pivotlow(low,   left3, i_rightLen) : na
float ph4 = i_lv4 != "Off" ? ta.pivothigh(high, left4, i_rightLen) : na
float pl4 = i_lv4 != "Off" ? ta.pivotlow(low,   left4, i_rightLen) : na
float ph5 = i_lv5 != "Off" ? ta.pivothigh(high, left5, i_rightLen) : na
float pl5 = i_lv5 != "Off" ? ta.pivotlow(low,   left5, i_rightLen) : na
float ph6 = i_lv6 != "Off" ? ta.pivothigh(high, left6, i_rightLen) : na
float pl6 = i_lv6 != "Off" ? ta.pivotlow(low,   left6, i_rightLen) : na

// ═══════════════════════════════════════════════════════════════
// MERGE PIVOTS — find if any level fired, track highest TF
// All levels with same rightLen detect the same bar: high[rightLen] / low[rightLen]
// ═══════════════════════════════════════════════════════════════
int pivotBar = bar_index - i_rightLen

// Merge highs: did ANY level detect a pivot high?
bool gotHi = not na(ph1) or not na(ph2) or not na(ph3) or not na(ph4) or not na(ph5) or not na(ph6)
float hiPrice = gotHi ? high[i_rightLen] : na

// Find highest TF that detected it (for anchor label)
int _hiTfMin = 0
string hiTf = ""
if not na(ph1) and tfToMin(i_lv1) > _hiTfMin
    _hiTfMin := tfToMin(i_lv1)
    hiTf := i_lv1
if not na(ph2) and tfToMin(i_lv2) > _hiTfMin
    _hiTfMin := tfToMin(i_lv2)
    hiTf := i_lv2
if not na(ph3) and tfToMin(i_lv3) > _hiTfMin
    _hiTfMin := tfToMin(i_lv3)
    hiTf := i_lv3
if not na(ph4) and tfToMin(i_lv4) > _hiTfMin
    _hiTfMin := tfToMin(i_lv4)
    hiTf := i_lv4
if not na(ph5) and tfToMin(i_lv5) > _hiTfMin
    _hiTfMin := tfToMin(i_lv5)
    hiTf := i_lv5
if not na(ph6) and tfToMin(i_lv6) > _hiTfMin
    _hiTfMin := tfToMin(i_lv6)
    hiTf := i_lv6

// Merge lows
bool gotLo = not na(pl1) or not na(pl2) or not na(pl3) or not na(pl4) or not na(pl5) or not na(pl6)
float loPrice = gotLo ? low[i_rightLen] : na

int _loTfMin = 0
string loTf = ""
if not na(pl1) and tfToMin(i_lv1) > _loTfMin
    _loTfMin := tfToMin(i_lv1)
    loTf := i_lv1
if not na(pl2) and tfToMin(i_lv2) > _loTfMin
    _loTfMin := tfToMin(i_lv2)
    loTf := i_lv2
if not na(pl3) and tfToMin(i_lv3) > _loTfMin
    _loTfMin := tfToMin(i_lv3)
    loTf := i_lv3
if not na(pl4) and tfToMin(i_lv4) > _loTfMin
    _loTfMin := tfToMin(i_lv4)
    loTf := i_lv4
if not na(pl5) and tfToMin(i_lv5) > _loTfMin
    _loTfMin := tfToMin(i_lv5)
    loTf := i_lv5
if not na(pl6) and tfToMin(i_lv6) > _loTfMin
    _loTfMin := tfToMin(i_lv6)
    loTf := i_lv6

// ═══════════════════════════════════════════════════════════════
// TRENDLINE STATE
// ═══════════════════════════════════════════════════════════════
color TRANS = color.new(#000000, 100)

// Descending trendline through highs
var float dA1p = na
var int   dA1b = 0
var float dA2p = na
var int   dA2b = 0
var line  dTL  = na
var bool  dBrk = false

// Ascending trendline through lows
var float aA1p = na
var int   aA1b = 0
var float aA2p = na
var int   aA2b = 0
var line  aTL  = na
var bool  aBrk = false

// Anchor labels — only 2 per trendline (current a1 + a2)
var label dLbl1 = na
var label dLbl2 = na
var label aLbl1 = na
var label aLbl2 = na

// Broken trendline history
var array<line> brokenLines = array.new<line>(0)

// ═══════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════
freezeTL(line tl, color clr, int breakBar, float breakPrice) =>
    if not na(tl)
        line.set_style(tl, line.style_dashed)
        line.set_color(tl, color.new(clr, 65))
        line.set_extend(tl, extend.none)
        line.set_x2(tl, breakBar)
        line.set_y2(tl, breakPrice)
    tl

trimHistory(array<line> arr, int maxKeep) =>
    while arr.size() > maxKeep
        line old = arr.shift()
        if not na(old)
            line.delete(old)
    true

// Projected price at a given bar from two anchor points
projPrice(float p1, int b1, float p2, int b2, int atBar) =>
    int dBars = b2 - b1
    float slope = dBars != 0 ? (p2 - p1) / dBars : 0.0
    float result = p2 + slope * (atBar - b2)
    result

// ═══════════════════════════════════════════════════════════════
// BREAK DETECTION — each bar, before processing new pivots
// ═══════════════════════════════════════════════════════════════
float breakHi = i_breakType == "Close" ? close : high
float breakLo = i_breakType == "Close" ? close : low

// Descending TL break (price goes above)
if not na(dA2p) and not dBrk
    float dProj = projPrice(dA1p, dA1b, dA2p, dA2b, bar_index)
    if breakHi > dProj
        dBrk := true
        line frozen = freezeTL(dTL, i_hiTlClr, bar_index, dProj)
        brokenLines.push(frozen)
        trimHistory(brokenLines, i_tlHistory)

// Ascending TL break (price goes below)
if not na(aA2p) and not aBrk
    float aProj = projPrice(aA1p, aA1b, aA2p, aA2b, bar_index)
    if breakLo < aProj
        aBrk := true
        line frozen = freezeTL(aTL, i_loTlClr, bar_index, aProj)
        brokenLines.push(frozen)
        trimHistory(brokenLines, i_tlHistory)

// ═══════════════════════════════════════════════════════════════
// ANCHOR HELPERS — only 2 markers per trendline, deleted on re-anchor
// ═══════════════════════════════════════════════════════════════
mkAnchorHi(int xBar, float price, string tf) =>
    label lbl = na
    if i_showAnchors
        lbl := label.new(xBar, price, tf, style=label.style_label_down, color=TRANS, textcolor=color.new(i_hiTlClr, 30), size=size.tiny)
    lbl

mkAnchorLo(int xBar, float price, string tf) =>
    label lbl = na
    if i_showAnchors
        lbl := label.new(xBar, price, tf, style=label.style_label_up, color=TRANS, textcolor=color.new(i_loTlClr, 30), size=size.tiny)
    lbl

delLabel(label lbl) =>
    if not na(lbl)
        label.delete(lbl)
    label(na)

// ═══════════════════════════════════════════════════════════════
// NEW PIVOT HIGH → UPDATE DESCENDING TRENDLINE
// ═══════════════════════════════════════════════════════════════
if gotHi
    if na(dA1p)
        dA1p := hiPrice
        dA1b := pivotBar
        dLbl1 := mkAnchorHi(pivotBar, hiPrice, hiTf)

    else if na(dA2p)
        dA2p := hiPrice
        dA2b := pivotBar
        dBrk := false
        dTL  := line.new(dA1b, dA1p, dA2b, dA2p, color=i_hiTlClr, width=i_tlWidth, extend=extend.right)
        dLbl2 := mkAnchorHi(pivotBar, hiPrice, hiTf)

    else if dBrk
        dLbl1 := delLabel(dLbl1)
        dLbl2 := delLabel(dLbl2)
        dA1p := hiPrice
        dA1b := pivotBar
        dA2p := na
        dA2b := 0
        dBrk := false
        dLbl1 := mkAnchorHi(pivotBar, hiPrice, hiTf)

    else
        float dProj = projPrice(dA1p, dA1b, dA2p, dA2b, pivotBar)
        if hiPrice <= dProj
            // Valid — re-anchor: shift a2→a1, new→a2
            dLbl1 := delLabel(dLbl1)
            dA1p := dA2p
            dA1b := dA2b
            dA2p := hiPrice
            dA2b := pivotBar
            dLbl1 := dLbl2
            dLbl2 := mkAnchorHi(pivotBar, hiPrice, hiTf)
            if not na(dTL)
                line.delete(dTL)
            dTL := line.new(dA1b, dA1p, dA2b, dA2p, color=i_hiTlClr, width=i_tlWidth, extend=extend.right)
        else
            // Above TL → break
            float dProjNow = projPrice(dA1p, dA1b, dA2p, dA2b, bar_index)
            dBrk := true
            line frozen = freezeTL(dTL, i_hiTlClr, bar_index, dProjNow)
            brokenLines.push(frozen)
            trimHistory(brokenLines, i_tlHistory)
            // Dim old anchors, start fresh
            if not na(dLbl1)
                label.set_textcolor(dLbl1, color.new(i_hiTlClr, 75))
            if not na(dLbl2)
                label.set_textcolor(dLbl2, color.new(i_hiTlClr, 75))
            dA1p := hiPrice
            dA1b := pivotBar
            dA2p := na
            dA2b := 0
            dLbl1 := mkAnchorHi(pivotBar, hiPrice, hiTf)
            dLbl2 := na

// ═══════════════════════════════════════════════════════════════
// NEW PIVOT LOW → UPDATE ASCENDING TRENDLINE
// ═══════════════════════════════════════════════════════════════
if gotLo
    if na(aA1p)
        aA1p := loPrice
        aA1b := pivotBar
        aLbl1 := mkAnchorLo(pivotBar, loPrice, loTf)

    else if na(aA2p)
        aA2p := loPrice
        aA2b := pivotBar
        aBrk := false
        aTL  := line.new(aA1b, aA1p, aA2b, aA2p, color=i_loTlClr, width=i_tlWidth, extend=extend.right)
        aLbl2 := mkAnchorLo(pivotBar, loPrice, loTf)

    else if aBrk
        aLbl1 := delLabel(aLbl1)
        aLbl2 := delLabel(aLbl2)
        aA1p := loPrice
        aA1b := pivotBar
        aA2p := na
        aA2b := 0
        aBrk := false
        aLbl1 := mkAnchorLo(pivotBar, loPrice, loTf)

    else
        float aProj = projPrice(aA1p, aA1b, aA2p, aA2b, pivotBar)
        if loPrice >= aProj
            aLbl1 := delLabel(aLbl1)
            aA1p := aA2p
            aA1b := aA2b
            aA2p := loPrice
            aA2b := pivotBar
            aLbl1 := aLbl2
            aLbl2 := mkAnchorLo(pivotBar, loPrice, loTf)
            if not na(aTL)
                line.delete(aTL)
            aTL := line.new(aA1b, aA1p, aA2b, aA2p, color=i_loTlClr, width=i_tlWidth, extend=extend.right)
        else
            float aProjNow = projPrice(aA1p, aA1b, aA2p, aA2b, bar_index)
            aBrk := true
            line frozen = freezeTL(aTL, i_loTlClr, bar_index, aProjNow)
            brokenLines.push(frozen)
            trimHistory(brokenLines, i_tlHistory)
            if not na(aLbl1)
                label.set_textcolor(aLbl1, color.new(i_loTlClr, 75))
            if not na(aLbl2)
                label.set_textcolor(aLbl2, color.new(i_loTlClr, 75))
            aA1p := loPrice
            aA1b := pivotBar
            aA2p := na
            aA2b := 0
            aLbl1 := mkAnchorLo(pivotBar, loPrice, loTf)
            aLbl2 := na
