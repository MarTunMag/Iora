bool d_fired = false
[d_dir2, d_lnum2, d_bld2, d_lhi2, d_llo2, d_phi2, d_plo2, d_swc2, d_f2] = leg_transition(d_cv, d_sd, d_dir, d_lnum, d_bld, d_lhi, d_llo, d_phi, d_plo, h4h, h4l)
d_dir  := d_dir2
