var float mn_llo   = na
var float mn_phi   = na
var float mn_plo   = na
int  mn_swc  = 0
bool mn_fired = false
[mn_dir2, mn_lnum2, mn_bld2, mn_lhi2, mn_llo2, mn_phi2, mn_plo2, mn_swc2, mn_f2] = leg_transition(mn_cv, mn_sd, mn_dir, mn_lnum, mn_bld, mn_lhi, mn_llo, mn_phi, mn_plo, w_h, w_l)
mn_dir  := mn_dir2
mn_lnum := mn_lnum2
mn_bld  := mn_bld2
mn_lhi  := mn_lhi2
mn_llo  := mn_llo2
mn_phi  := mn_phi2
mn_plo  := mn_plo2
mn_swc  := mn_swc2
mn_fired := mn_f2
if mn_cv == 3
    mn_leg := mn_sd

// =============================================================================
// === SECTION 7: ZONE UDT + ARRAYS
// =============================================================================

type Zone
    float top       = na
    float bottom    = na
    int   side      = 0
    int   swing_cls = 0
    int   tf_idx    = 0
    int   birth_bar = 0
    bool  broken    = false
    box   bx        = na

var array<Zone> m1_sup  = array.new<Zone>(0)
var array<Zone> m1_dem  = array.new<Zone>(0)
var array<Zone> m5_sup  = array.new<Zone>(0)
var array<Zone> m5_dem  = array.new<Zone>(0)
var array<Zone> m15_sup = array.new<Zone>(0)
var array<Zone> m15_dem = array.new<Zone>(0)
var array<Zone> h1_sup  = array.new<Zone>(0)
var array<Zone> h1_dem  = array.new<Zone>(0)
var array<Zone> h4_sup  = array.new<Zone>(0)
var array<Zone> h4_dem  = array.new<Zone>(0)
var array<Zone> d_sup   = array.new<Zone>(0)
var array<Zone> d_dem   = array.new<Zone>(0)

// =============================================================================
// === SECTION 8: ZONE CREATION FUNCTION
// =============================================================================

create_zone(array<Zone> arr, float ztop, float zbot, int side, int swc, int tf_idx, bool show, color clr, int max_z) =>
    Zone z = Zone.new()
    z.top       := ztop
    z.bottom    := zbot
    z.side      := side
    z.swing_cls := swc
    z.tf_idx    := tf_idx
    z.birth_bar := bar_index
    z.broken    := false
    if show
        z.bx := box.new(bar_index, ztop, bar_index + 50, zbot, border_color=color.new(clr, 50), bgcolor=color.new(clr, 85), border_width=1, extend=extend.right)
    arr.unshift(z)
    if arr.size() > max_z
        Zone old = arr.pop()
        if not na(old.bx)
            box.delete(old.bx)

// =============================================================================
// === SECTION 9: ZONE CREATION ON LEG TRANSITIONS
// =============================================================================

// Zone colors per TF
color z_m1_clr  = #78909C
color z_m5_clr  = #26A69A
color z_m15_clr = #42A5F5
color z_h1_clr  = #AB47BC
color z_h4_clr  = #FF7043
color z_d_clr   = #FFCA28

// --- M1 zones ---
if m1_fired
    if m1_swc == 1 or m1_swc == 2
        float s_top = nz(m1_phi)
        float s_bot = math.max(open, close)
        if na(s_bot) or s_bot >= s_top
            s_bot := s_top - (s_top - nz(m1_plo, s_top)) * 0.3
        create_zone(m1_sup, s_top, s_bot, -1, m1_swc, 0, i_zone_m1, z_m1_clr, i_max_zones)
    else if m1_swc == 3 or m1_swc == 4
        float d_bot = nz(m1_plo)
        float d_top = math.min(open, close)
        if na(d_top) or d_top <= d_bot
            d_top := d_bot + (nz(m1_phi, d_bot) - d_bot) * 0.3
        create_zone(m1_dem, d_bot, d_top, 1, m1_swc, 0, i_zone_m1, z_m1_clr, i_max_zones)

// --- M5 zones ---
if m5_fired
    if m5_swc == 1 or m5_swc == 2
        float s_top = nz(m5_phi)
        float s_bot = math.max(nz(m5o), nz(m5c))
        if na(s_bot) or s_bot >= s_top
            s_bot := s_top - (s_top - nz(m5_plo, s_top)) * 0.3
        create_zone(m5_sup, s_top, s_bot, -1, m5_swc, 1, i_zone_m5, z_m5_clr, i_max_zones)
    else if m5_swc == 3 or m5_swc == 4
        float d_bot = nz(m5_plo)
        float d_top = math.min(nz(m5o), nz(m5c))
        if na(d_top) or d_top <= d_bot
            d_top := d_bot + (nz(m5_phi, d_bot) - d_bot) * 0.3
        create_zone(m5_dem, d_bot, d_top, 1, m5_swc, 1, i_zone_m5, z_m5_clr, i_max_zones)

// --- M15 zones ---
if m15_fired
    if m15_swc == 1 or m15_swc == 2
        float s_top = nz(m15_phi)
        float s_bot = math.max(nz(m15o), nz(m15c))
        if na(s_bot) or s_bot >= s_top
            s_bot := s_top - (s_top - nz(m15_plo, s_top)) * 0.3
        create_zone(m15_sup, s_top, s_bot, -1, m15_swc, 2, i_zone_m15, z_m15_clr, i_max_zones)
    else if m15_swc == 3 or m15_swc == 4
        float d_bot = nz(m15_plo)
        float d_top = math.min(nz(m15o), nz(m15c))
        if na(d_top) or d_top <= d_bot
            d_top := d_bot + (nz(m15_phi, d_bot) - d_bot) * 0.3
        create_zone(m15_dem, d_bot, d_top, 1, m15_swc, 2, i_zone_m15, z_m15_clr, i_max_zones)

// --- H1 zones ---
if h1_fired
    if h1_swc == 1 or h1_swc == 2
        float s_top = nz(h1_phi)
        float s_bot = math.max(nz(h1o), nz(h1c))
        if na(s_bot) or s_bot >= s_top
            s_bot := s_top - (s_top - nz(h1_plo, s_top)) * 0.3
        create_zone(h1_sup, s_top, s_bot, -1, h1_swc, 3, i_zone_h1, z_h1_clr, i_max_zones)
    else if h1_swc == 3 or h1_swc == 4
        float d_bot = nz(h1_plo)
        float d_top = math.min(nz(h1o), nz(h1c))
        if na(d_top) or d_top <= d_bot
            d_top := d_bot + (nz(h1_phi, d_bot) - d_bot) * 0.3
        create_zone(h1_dem, d_bot, d_top, 1, h1_swc, 3, i_zone_h1, z_h1_clr, i_max_zones)

// --- H4 zones ---
if h4_fired
    if h4_swc == 1 or h4_swc == 2
        float s_top = nz(h4_phi)
        float s_bot = math.max(nz(h4o), nz(h4c))
        if na(s_bot) or s_bot >= s_top
            s_bot := s_top - (s_top - nz(h4_plo, s_top)) * 0.3
        create_zone(h4_sup, s_top, s_bot, -1, h4_swc, 4, i_zone_h4, z_h4_clr, i_max_zones)
    else if h4_swc == 3 or h4_swc == 4
        float d_bot = nz(h4_plo)
        float d_top = math.min(nz(h4o), nz(h4c))
        if na(d_top) or d_top <= d_bot
            d_top := d_bot + (nz(h4_phi, d_bot) - d_bot) * 0.3
        create_zone(h4_dem, d_bot, d_top, 1, h4_swc, 4, i_zone_h4, z_h4_clr, i_max_zones)

// --- D zones ---
if d_fired
    if d_swc == 1 or d_swc == 2
        float s_top = nz(d_phi)
        float s_bot = math.max(nz(d_o), nz(d_c))
        if na(s_bot) or s_bot >= s_top
            s_bot := s_top - (s_top - nz(d_plo, s_top)) * 0.3
        create_zone(d_sup, s_top, s_bot, -1, d_swc, 5, i_zone_d, z_d_clr, i_max_zones)
    else if d_swc == 3 or d_swc == 4
        float d_bot = nz(d_plo)
        float d_top = math.min(nz(d_o), nz(d_c))
        if na(d_top) or d_top <= d_bot
            d_top := d_bot + (nz(d_phi, d_bot) - d_bot) * 0.3
        create_zone(d_dem, d_bot, d_top, 1, d_swc, 5, i_zone_d, z_d_clr, i_max_zones)

// =============================================================================
// === SECTION 10: ZONE BREAK CHECKING
// =============================================================================

check_zone_breaks(array<Zone> zones, bool is_supply) =>
    int i = zones.size() - 1
    while i >= 0
        Zone z = zones.get(i)
        bool brk = is_supply ? close > z.top : close < z.bottom
        if brk
            if not na(z.bx)
                box.delete(z.bx)
            zones.remove(i)
        i -= 1

check_zone_breaks(m1_sup, true)
check_zone_breaks(m1_dem, false)
check_zone_breaks(m5_sup, true)
check_zone_breaks(m5_dem, false)
check_zone_breaks(m15_sup, true)
check_zone_breaks(m15_dem, false)
check_zone_breaks(h1_sup, true)
check_zone_breaks(h1_dem, false)
check_zone_breaks(h4_sup, true)
check_zone_breaks(h4_dem, false)
check_zone_breaks(d_sup, true)
check_zone_breaks(d_dem, false)

// =============================================================================
// === SECTION 11: ZONE COUNTING
// =============================================================================

var int h1_zone_cnt = 0
var int h1_zone_dir = 0
var int h4_zone_cnt = 0
var int h4_zone_dir = 0
var int d_zone_cnt  = 0
var int d_zone_dir  = 0

if h1_fired
    if h1_swc == 1 or h1_swc == 4
        if h1_zone_dir >= 0
            h1_zone_cnt := h1_zone_cnt + 1
            h1_zone_dir := 1
        else
            h1_zone_cnt := 1
            h1_zone_dir := 1
    else if h1_swc == 3 or h1_swc == 2
        if h1_zone_dir <= 0
            h1_zone_cnt := h1_zone_cnt + 1
            h1_zone_dir := -1
        else
            h1_zone_cnt := 1
            h1_zone_dir := -1

if h4_fired
    if h4_swc == 1 or h4_swc == 4
        if h4_zone_dir >= 0
            h4_zone_cnt := h4_zone_cnt + 1
            h4_zone_dir := 1
        else
            h4_zone_cnt := 1
            h4_zone_dir := 1
    else if h4_swc == 3 or h4_swc == 2
        if h4_zone_dir <= 0
            h4_zone_cnt := h4_zone_cnt + 1
            h4_zone_dir := -1
        else
            h4_zone_cnt := 1
            h4_zone_dir := -1

if d_fired
    if d_swc == 1 or d_swc == 4
        if d_zone_dir >= 0
            d_zone_cnt := d_zone_cnt + 1
            d_zone_dir := 1
        else
            d_zone_cnt := 1
            d_zone_dir := 1
    else if d_swc == 3 or d_swc == 2
        if d_zone_dir <= 0
            d_zone_cnt := d_zone_cnt + 1
            d_zone_dir := -1
        else
            d_zone_cnt := 1
            d_zone_dir := -1

// =============================================================================
// === DASHBOARD
// =============================================================================

if i_dash_on and barstate.islast
    string tbl_pos = switch i_dash_pos
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Right" => position.bottom_right
        =>                position.bottom_left

    var table ztbl = na
    if not na(ztbl)
        table.delete(ztbl)

    ztbl := table.new(tbl_pos, 3, 8, bgcolor=color.new(#1A1A2E, 10), border_width=1, border_color=color.new(#3A3A5A, 50), frame_width=1, frame_color=color.new(#3A3A5A, 30))

    color hdr_bg  = color.new(#0D1117, 0)
    color hdr_txt = color.new(#58A6FF, 0)
    color cell_bg = color.new(#161B22, 0)
    color txt_clr = color.new(#B0BEC5, 0)
    string hdr_sz  = size.tiny
    string cell_sz = size.tiny

    // Header
    table.cell(ztbl, 0, 0, "Mechanical Zones", text_color=hdr_txt, bgcolor=hdr_bg, text_size=hdr_sz)
    table.cell(ztbl, 1, 0, "Supply", text_color=color.new(#EF5350, 0), bgcolor=hdr_bg, text_size=hdr_sz)
    table.cell(ztbl, 2, 0, "Demand", text_color=color.new(#26A69A, 0), bgcolor=hdr_bg, text_size=hdr_sz)

    // Per-TF rows
    table.cell(ztbl, 0, 1, "M1",  text_color=txt_clr, bgcolor=cell_bg, text_size=cell_sz)
    table.cell(ztbl, 1, 1, str.tostring(m1_sup.size()),  text_color=color.new(#EF5350, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(ztbl, 2, 1, str.tostring(m1_dem.size()),  text_color=color.new(#26A69A, 0), bgcolor=cell_bg, text_size=cell_sz)

    table.cell(ztbl, 0, 2, "M5",  text_color=txt_clr, bgcolor=cell_bg, text_size=cell_sz)
    table.cell(ztbl, 1, 2, str.tostring(m5_sup.size()),  text_color=color.new(#EF5350, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(ztbl, 2, 2, str.tostring(m5_dem.size()),  text_color=color.new(#26A69A, 0), bgcolor=cell_bg, text_size=cell_sz)

    table.cell(ztbl, 0, 3, "M15", text_color=txt_clr, bgcolor=cell_bg, text_size=cell_sz)
    table.cell(ztbl, 1, 3, str.tostring(m15_sup.size()), text_color=color.new(#EF5350, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(ztbl, 2, 3, str.tostring(m15_dem.size()), text_color=color.new(#26A69A, 0), bgcolor=cell_bg, text_size=cell_sz)

    table.cell(ztbl, 0, 4, "H1",  text_color=txt_clr, bgcolor=cell_bg, text_size=cell_sz)
    table.cell(ztbl, 1, 4, str.tostring(h1_sup.size()),  text_color=color.new(#EF5350, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(ztbl, 2, 4, str.tostring(h1_dem.size()),  text_color=color.new(#26A69A, 0), bgcolor=cell_bg, text_size=cell_sz)

    table.cell(ztbl, 0, 5, "H4",  text_color=txt_clr, bgcolor=cell_bg, text_size=cell_sz)
    table.cell(ztbl, 1, 5, str.tostring(h4_sup.size()),  text_color=color.new(#EF5350, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(ztbl, 2, 5, str.tostring(h4_dem.size()),  text_color=color.new(#26A69A, 0), bgcolor=cell_bg, text_size=cell_sz)

    table.cell(ztbl, 0, 6, "D",   text_color=txt_clr, bgcolor=cell_bg, text_size=cell_sz)
    table.cell(ztbl, 1, 6, str.tostring(d_sup.size()),   text_color=color.new(#EF5350, 0), bgcolor=cell_bg, text_size=cell_sz)
    table.cell(ztbl, 2, 6, str.tostring(d_dem.size()),   text_color=color.new(#26A69A, 0), bgcolor=cell_bg, text_size=cell_sz)

    // Bias row
    string bias_str = d_dir > 0 ? "BULL" : d_dir < 0 ? "BEAR" : "—"
    color bias_clr = d_dir > 0 ? color.new(#26A69A, 0) : d_dir < 0 ? color.new(#EF5350, 0) : color.new(#546E7A, 0)
    table.cell(ztbl, 0, 7, "Bias", text_color=txt_clr, bgcolor=cell_bg, text_size=cell_sz)
    table.cell(ztbl, 1, 7, bias_str, text_color=bias_clr, bgcolor=cell_bg, text_size=cell_sz)
    string cnt_str = "H1:" + str.tostring(h1_zone_cnt) + " H4:" + str.tostring(h4_zone_cnt) + " D:" + str.tostring(d_zone_cnt)
    table.cell(ztbl, 2, 7, cnt_str, text_color=txt_clr, bgcolor=cell_bg, text_size=cell_sz)
